# ==================================================================== output

# hold: stderr lines are kept back until release(), so that a refusal's
# `actas-stop:` line is always the first line on stderr (SPEC 8.4).
_MODE = {"json": False, "no_color": False, "hold": False, "argv": []}
WARNINGS = []
HELD = []


def say(line):
    if _MODE["hold"]:
        HELD.append(line)
    else:
        print(line, file=sys.stderr)


def release():
    _MODE["hold"] = False
    for line in HELD:
        print(line, file=sys.stderr)
    del HELD[:]
_ANSI = {"bold": "\033[1m", "dim": "\033[2m", "red": "\033[31m", "green": "\033[32m",
         "yellow": "\033[33m", "cyan": "\033[36m"}


def paint(text, style, stream=None):
    """ANSI colour decided per stream; NO_COLOR and --no-color turn it off."""
    stream = sys.stdout if stream is None else stream
    try:
        on = stream.isatty() and not os.environ.get("NO_COLOR") and not _MODE["no_color"]
    except (AttributeError, ValueError):
        on = False
    return f"{_ANSI[style]}{text}\033[0m" if on else str(text)


def die(msg, code=1):
    release()
    print(f"{paint('actas:', 'red', sys.stderr)} {msg}", file=sys.stderr)
    if _MODE["json"]:
        print(json.dumps({"ok": False, "code": "error", "message": msg, "warnings": WARNINGS}))
    sys.exit(code)


def warn(msg):
    if msg in WARNINGS:
        return
    WARNINGS.append(msg)
    say(f"{paint('actas:', 'yellow', sys.stderr)} {msg}")


def info(msg):
    say(f"{paint('actas:', 'dim', sys.stderr)} {msg}")


class ManifestError(Exception):
    def __init__(self, msg, code=1):
        Exception.__init__(self, msg)
        self.code = code


# ================================================================ utilities

def run(cmd, **kw):
    """subprocess.run that never raises for a missing binary or a timeout:
    those come back as exit 127 / 124, so callers degrade instead of crashing."""
    kw.setdefault("capture_output", True)
    kw.setdefault("text", True)
    try:
        return subprocess.run(cmd, **kw)
    except FileNotFoundError:
        return subprocess.CompletedProcess(cmd, 127, "", f"{cmd[0]}: not found")
    except subprocess.TimeoutExpired:
        r = subprocess.CompletedProcess(cmd, 124, "", f"{cmd[0]}: timed out")
        r.timed_out = True
        return r


def find_bin(name):
    """Absolute path of a backend binary, or None (D8)."""
    p = shutil.which(name)
    if not p:
        dirs = (env_get("ACTAS_PATH_EXTRA") or "").split(os.pathsep)
        fallback = env_get("ACTAS_FALLBACK_PATH")
        dirs += (FALLBACK_PATH if fallback is None else fallback).split(os.pathsep)
        path = os.pathsep.join(os.path.expanduser(d) for d in dirs if d)
        p = shutil.which(name, path=path) if path else None
    return os.path.abspath(p) if p else None


def expand(p):
    return os.path.abspath(os.path.expanduser(os.path.expandvars(str(p))))


def tilde(p):
    p, h = str(p), str(HOME)
    return "~" + p[len(h):] if p == h or p.startswith(h.rstrip("/") + "/") else p


def as_list(v):
    return [] if v is None else [v] if isinstance(v, str) else list(v)


def section(prof, key):
    v = prof.get(key)
    return v if isinstance(v, dict) else {}


def ensure_dir(d, tighten=False):
    d = Path(d)
    if not d.is_dir():
        for q in reversed([d] + [x for x in d.parents if not x.exists()]):
            q.mkdir(mode=0o700, exist_ok=True)     # parents too: mkdir -p ignores mode
            os.chmod(q, 0o700)
    elif tighten and d.stat().st_mode & 0o077:
        os.chmod(d, 0o700)
    return d


def write_private(path, text):
    """Atomic, owner-only write: a temp file in the same directory, fsync,
    then rename over the target. Readers never see a partial or 0644 file."""
    import tempfile                 # imported where used: keeps helper commands' startup short
    path = Path(path)
    ensure_dir(path.parent)
    fd, tmp = tempfile.mkstemp(dir=str(path.parent), prefix="." + path.name + ".", suffix=".tmp")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, 0o600)
        os.replace(tmp, str(path))
    except BaseException:
        with suppress(OSError):
            os.unlink(tmp)
        raise


def strip_nl(s):
    """Strip exactly one trailing newline (D31): PEM and padded values survive."""
    return s[:-2] if s.endswith("\r\n") else s[:-1] if s.endswith("\n") else s


def shell_quote(s):
    return shlex.quote(str(s))


def close_match(word, choices):
    import difflib
    close = difflib.get_close_matches(str(word), [str(c) for c in choices], n=1)
    return close[0] if close else None


def did_you_mean(word, choices):
    close = close_match(word, choices)
    return f" (did you mean {close}?)" if close else ""


# ======================================================== loading the manifest

# Manifest scalars are read the same way by PyYAML and by yq (YAML 1.2 core,
# stricter on numbers): only true/false are booleans, and only a number that
# reads back as written (42, -3, 1.5) is a number. Everything YAML 1.1 or yq
# would turn into something else stays the text as written: yes/no/on/off,
# 0755 and 012345678901 (octal, or a dropped leading zero), 0x1F, 1_000, 1:30,
# 2024-01-01, 1.10, 1e3. Version 1 files keep the parse they always had.
NUMBER_TEXT = re.compile(r"^-?(?:0|[1-9][0-9]*)(?:\.[0-9]+)?$")
YQ_SCALAR = "=actas-scalar="        # wraps yq's number and date scalars (their source text)
YQ_TYPED = ('(.. | select(tag == "!!int" or tag == "!!float" or tag == "!!timestamp")) '
            '|= {"%s": (. tag = "!!str")}' % YQ_SCALAR)
_YAML_LOADER = {}


def scalar_value(text):
    """A plain YAML number or date scalar's value: the number when it reads
    back exactly as written, else the text."""
    if NUMBER_TEXT.match(text):
        v = float(text) if "." in text else int(text)
        if repr(v) == text:
            return v
    return text


def yaml_loader(yaml):
    """PyYAML's SafeLoader with the scalar rules above (built once)."""
    if "loader" not in _YAML_LOADER:
        class Loader(getattr(yaml, "CSafeLoader", yaml.SafeLoader)):
            pass
        drop = {"tag:yaml.org,2002:" + t for t in ("bool", "int", "float", "timestamp")}
        Loader.yaml_implicit_resolvers = {k: [(t, r) for t, r in v if t not in drop]
                                          for k, v in yaml.SafeLoader.yaml_implicit_resolvers.items()}
        Loader.add_implicit_resolver("tag:yaml.org,2002:bool",
                                     re.compile(r"^(?:true|True|TRUE|false|False|FALSE)$"), list("tTfF"))
        Loader.add_implicit_resolver("tag:actas:number", NUMBER_TEXT, list("-0123456789"))
        Loader.add_constructor("tag:actas:number", lambda ld, node: scalar_value(ld.construct_scalar(node)))
        _YAML_LOADER["loader"] = Loader
    return _YAML_LOADER["loader"]


def unwrap_yq(v):
    if isinstance(v, dict):
        if len(v) == 1 and isinstance(v.get(YQ_SCALAR), str):
            return scalar_value(v[YQ_SCALAR])
        return {k: unwrap_yq(x) for k, x in v.items()}
    if isinstance(v, list):
        return [unwrap_yq(x) for x in v]
    return v


def yq_json(text, typed=False):
    """The `yq` binary's JSON for text, or None. mikefarah/yq needs `-o json`;
    the Python kislyuk/yq (Debian/Ubuntu's apt package) prints JSON by
    default and rejects `-o` (F42). typed: mikefarah/yq hands over number and
    date scalars as written, for scalar_value(); the kislyuk one rejects that
    expression and reads YAML 1.1, like plain PyYAML."""
    if shutil.which("yq"):
        tries = ([["-o", "json", YQ_TYPED]] if typed else []) + [["-o", "json", "."], ["."]]
        for i, args in enumerate(tries):
            r = run(["yq"] + args, input=text)
            if r.returncode == 0:
                with suppress(ValueError):
                    out = json.loads(r.stdout or "null")
                    return unwrap_yq(out) if typed and i == 0 else out
    return None


def is_v1(doc):
    """A parsed manifest that build_config reads as version 1."""
    return isinstance(doc, dict) and doc.get("version") in (1, None) and doc.get("version") is not True


def parse_text(text, label):
    """Parse with the first parser available: PyYAML, then plain JSON (YAML
    is a superset of JSON), then the `yq` binary, so actas runs on a bare
    Python install. An empty file is {}. Raises ManifestError. Scalars follow
    the rules above; a version 1 file is parsed again the way v1 did
    (YAML 1.1 with PyYAML, plain yq)."""
    try:
        import yaml
    except ImportError:
        yaml = None
    if yaml is not None:
        # libyaml's parser when present (~10x faster; yaml_loader builds on
        # it). Its errors lack the source line and caret, so a failure is
        # parsed again with the pure-Python loader, only for the message.
        base = getattr(yaml, "CSafeLoader", yaml.SafeLoader)
        try:
            doc = yaml.load(text, Loader=yaml_loader(yaml)) or {}
            return (yaml.load(text, Loader=base) or {}) if is_v1(doc) else doc
        except yaml.YAMLError as e:
            err = e
        if base is not yaml.SafeLoader:
            try:
                yaml.safe_load(text)
            except yaml.YAMLError as e:
                err = e
        raise ManifestError(f"{label}: invalid YAML: {err}")
    if not text.strip():
        return {}
    with suppress(ValueError):
        return json.loads(text)
    parsed = yq_json(text, typed=True)
    if is_v1(parsed):
        parsed = yq_json(text)
    if parsed is None:
        raise ManifestError(f"cannot parse {label}: no YAML parser here; {YAML_HINT}, "
                            "or write it as JSON")
    return parsed or {}


YAML_HINT = "install PyYAML (python3 -m pip install --user pyyaml) or mikefarah/yq (brew install yq)"


def yaml_available():
    """PyYAML, or a yq that actually parses YAML (F42)."""
    try:
        import yaml  # noqa: F401
        return True
    except ImportError:
        if "yaml" not in _CACHE:
            _CACHE["yaml"] = yq_json("a: [1]\n") == {"a": [1]}
        return _CACHE["yaml"]


class Problems:
    """Manifest findings: (level, path, message), level error|warning|info."""

    def __init__(self):
        self.items = []

    def error(self, path, msg):
        self.items.append(("error", path, msg))

    def warn(self, path, msg):
        self.items.append(("warning", path, msg))

    def info(self, path, msg):
        self.items.append(("info", path, msg))

    def unknown(self, path, key, known):
        self.warn(path, "unknown key" + did_you_mean(key, known))

    def errors(self):
        return [i for i in self.items if i[0] == "error"]


def fmt_problem(path, msg):
    if msg.startswith("unknown key"):
        return f"unknown key {path}{msg[len('unknown key'):]}"
    return f"{path}: {msg}" if path else msg


class Config:
    """A loaded manifest, always in v2 form (v1 files are translated)."""

    def __init__(self):
        self.version = None
        self.defaults, self.profiles, self.roles = {}, {}, {}
        self.fallback = None
        self.problems = Problems()
        self.owned = None       # scrub scope, computed on first use (owned_scope)
        self.cred_rules = None  # rendered credential-file deny rules (cred_rules)


_LOADED = {}


def load(strict=True, quiet=False):
    """Load, translate (v1) and validate the manifest. Dies on errors unless
    strict is False (doctor), in which case they stay in cfg.problems."""
    path = MANIFEST
    if not path.exists():
        die(f"no manifest at {path}\n       run: actas init")
    st = path.stat()
    key = (str(path), st.st_mtime_ns, st.st_size)
    if key in _LOADED:
        return _LOADED[key]
    try:
        cfg = build_config(parse_text(path.read_text(), str(path)))
    except ManifestError as e:
        if strict:
            die(str(e))
        cfg = Config()                  # doctor reports it and runs its other checks
        cfg.problems.error("", str(e))
    errors = cfg.problems.errors()
    if errors and strict:
        lines = [fmt_problem(p, m) for _, p, m in errors]
        die(f"{path}:\n       " + "\n       ".join(lines))
    if not quiet:
        for lvl, p, m in cfg.problems.items:
            if lvl == "warning":
                warn(fmt_problem(p, m))
    _LOADED[key] = cfg
    return cfg


def build_config(raw):
    cfg = Config()
    probs = cfg.problems
    if not isinstance(raw, dict):
        probs.error("", "top level must be a mapping")
        return cfg
    ver = raw.get("version", 1)
    ver = 1 if ver is None else ver
    if isinstance(ver, bool) or ver not in (1, 2):
        probs.error("version", f"must be 1 or 2, got {ver!r}")
        return cfg
    cfg.version = ver
    doc = translate_v1(raw, probs) if ver == 1 else raw
    if doc is not None:
        validate_v2(doc, cfg, v1=(ver == 1))
    return cfg


def validate_v2(doc, cfg, v1=False):
    probs = cfg.problems
    moved = {"environments": "rename to profiles: (run actas migrate to convert a v1 file)",
             "permission_sets": "a permission set is a role: define a role instead",
             "modules": "user modules are not supported; write a role (see docs/recipes.md)"}
    for k in doc:
        if k in moved:
            probs.error(k, moved[k])
        elif k not in TOP_KEYS:
            probs.unknown(str(k), k, TOP_KEYS)
    sections = {}
    for sec in ("defaults", "profiles", "roles"):
        v = doc.get(sec)
        if v is not None and not isinstance(v, dict):
            probs.error(sec, "must be a mapping")
            v = None
        sections[sec] = v or {}
    seen = {}
    for sec in ("profiles", "roles"):
        for name in sections[sec]:
            if not isinstance(name, str) or not NAME_RE.match(name):
                probs.error(f"{sec}.{name}", "invalid name: use letters, digits, '.', '_' or '-'")
            elif name in seen:
                probs.error(f"{sec}.{name}", f"duplicate name (also in {seen[name]}): "
                                             "profiles and roles share one namespace")
            seen[name] = sec
    cfg.defaults = check_body(sections["defaults"], "defaults", probs, "defaults", v1)
    label = "environments" if v1 else "profiles"     # the path the user wrote
    cfg.profiles = {n: check_body(b, f"{label}.{n}", probs, "profile", v1)
                    for n, b in sections["profiles"].items() if isinstance(n, str)}
    cfg.roles = {n: check_body(b, f"roles.{n}", probs, "role", v1)
                 for n, b in sections["roles"].items() if isinstance(n, str)}
    fb = doc.get("fallback")
    if fb is not None:
        if not isinstance(fb, str) or fb not in cfg.profiles:
            probs.error("fallback", f"must name a profile, got {fb!r}"
                        + did_you_mean(fb, cfg.profiles))
        else:
            cfg.fallback = fb


def check_body(body, path, probs, kind, v1=False):
    if body is None:
        return {}
    if not isinstance(body, dict):
        probs.error(path, f"expected a map, got {type_name(body)}")
        return {}
    out = {}
    for k, v in body.items():
        p = f"{path}.{k}"
        if k in LEGACY_KEYS and not v1:
            probs.error(p, f"{k} is a v1 key ({LEGACY_KEYS[k]}); run actas migrate")
            continue
        if kind == "defaults" and k in DEFAULTS_FORBIDDEN:
            probs.error(p, "not allowed in defaults: put it in a role and `use:` it")
            continue
        if kind == "role" and k in ("match", "agents_may_use"):
            probs.error(p, f"{k} belongs to profiles; roles are never matched or run")
            continue
        spec = BODY_KEYS.get(k)
        if spec is None:
            probs.unknown(p, k, BODY_KEYS)
            continue
        out[k] = check_value(v, spec, p, probs, v1, top=k)
    gh = out.get("github")
    if isinstance(gh, dict) and gh.get("auth") and gh.get("home"):
        probs.error(f"{path}.github", "set either auth or home, not both")
    return out


def type_name(v):
    return {bool: "bool", int: "int", float: "float", str: "string", list: "list",
            dict: "map", type(None): "null"}.get(type(v), type(v).__name__)


def check_value(v, spec, path, probs, v1=False, top=None):
    """Validate and normalize one value; returns the normalized value."""
    if v is None:
        return None

    def bad(want):
        probs.error(path, f"expected {want}, got {type_name(v)}")
        return None

    if isinstance(spec, dict):
        if not isinstance(v, dict):
            return bad("a map")
        out = {}
        for k, x in v.items():
            if (top, k) in LEGACY_SUB and not v1:
                probs.error(f"{path}.{k}", f"a v1 key ({LEGACY_SUB[(top, k)]}); run actas migrate")
            elif k not in spec:
                probs.unknown(f"{path}.{k}", k, spec)
            else:
                out[k] = check_value(x, spec[k], f"{path}.{k}", probs, v1, top)
        return out
    kind = spec[0] if isinstance(spec, tuple) else spec
    if kind == "module":
        return "inherit" if v == "inherit" else check_value(v, spec[1], path, probs, v1, top)
    if kind == "mapof":
        if not isinstance(v, dict):
            return bad("a map")
        return {str(k): check_value(x, spec[1], f"{path}.{k}", probs, v1, top) for k, x in v.items()}
    if kind == "enum":
        if v not in spec[1]:
            probs.error(path, f"expected one of {', '.join(spec[1])}, got {v!r}"
                        + did_you_mean(v, spec[1]))
            return None
        return v
    if kind == "str":
        return v if isinstance(v, str) else bad("a string")
    if kind == "home":
        if isinstance(v, str) and (NAME_RE.match(v) or v.startswith(("/", "~"))):
            return v
        probs.error(path, f"expected a name (a home under the actas state dir) or an absolute "
                          f"path, got {v!r}")
        return None
    if kind == "bool":
        return v if isinstance(v, bool) else bad("true or false")
    if kind == "strlist":
        v = [v] if isinstance(v, str) else v
    if kind in ("list", "strlist", "names", "vars"):
        if not isinstance(v, list):
            return bad("a list")
        if not all(isinstance(x, str) for x in v):
            return bad("a list of strings")
        rx = {"names": NAME_RE, "vars": ENV_RE}.get(kind)
        for x in v:
            if rx and not rx.match(x) and not (top == "agents_may_use" and x == ANY):
                probs.error(path, f"invalid name {x!r}" + (' (use "*" alone for every profile)'
                                                           if top == "agents_may_use" and ANY in x else ""))
        return list(v)
    if kind in ("env", "refs", "strmap", "map"):
        if not isinstance(v, dict):
            return bad("a map")
        if kind == "map":         # claude.settings
            mode = get_path(v, ("permissions", "defaultMode"))
            if mode in ("auto", "bypassPermissions"):
                probs.error(f"{path}.permissions.defaultMode",
                            f"{mode} is not allowed here (Claude ignores it in project settings)")
            return copy.deepcopy(v)
        out = {}
        for k, x in v.items():
            p = f"{path}.{k}"
            if not isinstance(k, str):
                probs.error(p, "quote the key: YAML read it as " + type_name(k))
                continue
            if kind != "strmap" and not ENV_RE.match(k):
                probs.error(p, "invalid variable name: use letters, digits and _")
                continue
            if kind == "env":
                out[k] = env_value(x, p, probs, v1)
            elif kind == "refs":
                out[k] = None if x is None else check_ref(x, p, probs)   # null unsets (SPEC 4.7)
            elif x is None or isinstance(x, str):
                out[k] = x
            else:
                probs.error(p, f"expected a string, got {type_name(x)}")
        return out
    if kind == "ref":
        return check_ref(v, path, probs)
    raise AssertionError(f"unknown spec {spec!r}")


def env_value(v, path, probs, v1):
    """D18: str/int as text, null unsets, bool is an error (a warning in v1
    files, which keep v1's str()), float warns."""
    if v is None or isinstance(v, str):
        return v
    if isinstance(v, bool):
        if v1:
            probs.warn(path, f"boolean {v} is passed as {str(v)!r}; quote the value")
            return str(v)
        probs.error(path, 'quote the value: YAML turns yes/no/on/off/true/false into booleans')
        return None
    if isinstance(v, int):
        return str(v)
    if isinstance(v, float):
        probs.warn(path, f"number {v} is passed as {str(v)!r}; quote the value")
        return str(v)
    probs.error(path, f"expected a string, got {type_name(v)}")
    return None


def check_ref(v, path, probs):
    if isinstance(v, dict) and list(v) == ["cmd"]:
        v = "cmd:" + json.dumps(v["cmd"])
    if not isinstance(v, str):
        probs.error(path, f"expected a ref string, got {type_name(v)}")
        return None
    parts = path.split(".")
    err = ref_error(v, owner=parts[1] if len(parts) > 1 else "x", field=parts[-1].lower())
    if err:
        probs.error(path, err)
    return v


def ref_scheme(ref):
    if not isinstance(ref, str) or ":" not in ref:
        return None
    s = ref.split(":", 1)[0]
    return s if s in REF_RES else None


REF_FORMS = {"sops": "sops:<profile>/<key>", "keychain": "keychain:<service>/<account>",
             "op": "op://<vault>/<item>/<field>", "gh": "gh:<account>[@<host>]",
             "cmd": 'cmd:["<program>", "<arg>"]'}


def ref_error(ref, owner="x", field="token"):
    """None for a well-formed ref, else a message. Never repeats the value:
    a bad ref is often the secret itself, pasted in."""
    s = ref_scheme(ref)
    field = field if NAME_RE.match(field) else "token"
    if s is None:
        return (f'write a ref such as "sops:{owner}/{field}" (schemes: sops, keychain, op, gh, cmd); '
                f"if the value here is the secret itself, store it with "
                f"`actas secret set sops:{owner}/{field}` and remove it from this file")
    if not REF_RES[s].match(ref):
        return f"malformed {s}: ref (expected {REF_FORMS[s]})"
    if s == "cmd":
        try:
            argv = json.loads(ref[4:])
        except ValueError:
            argv = None
        if not (isinstance(argv, list) and argv and all(isinstance(x, str) for x in argv)
                and argv[0]):
            return 'a cmd: ref is a JSON list of strings, e.g. cmd:["pass", "show", "x"]'
    return None


# ================================================================ v1 front end

def translate_v1(raw, probs):
    """SPEC 2.4: a v1 document -> the equivalent v2 document. The engine
    never sees v1 semantics."""
    hint = 'this looks like v2; add "version: 2" (and run actas migrate to convert the rest)'
    envs, defaults = raw.get("environments") or {}, raw.get("defaults") or {}
    if not isinstance(envs, dict) or not isinstance(defaults, dict):
        probs.error("", "`environments` and `defaults` must be mappings")
        return None
    for k in raw:
        if k in V2_ONLY:
            probs.error(str(k), hint)
        elif k not in V1_TOP:
            probs.unknown(str(k), k, V1_TOP)
    bodies = [("defaults", defaults)] + [(f"environments.{n}", e) for n, e in envs.items()]
    for where, body in bodies:
        for k in (body if isinstance(body, dict) else {}):
            if k in V2_ONLY:
                probs.error(f"{where}.{k}", hint)
    if probs.errors():
        return None
    profiles = {}
    for name, env in envs.items():
        if not isinstance(name, str) or not NAME_RE.match(name):
            probs.error(f"environments.{name}", "invalid name: use letters, digits, '.', '_' or '-'")
        elif env is not None and not isinstance(env, dict):
            probs.error(f"environments.{name}", "must be a mapping")
        else:         # v1 semantics, kept exactly: defaults then the environment, *shallow*
            profiles[name] = v1_profile(name, {**copy.deepcopy(defaults), **(env or {}), "name": name}, probs)
    return {"version": 2, "profiles": profiles}


# A v1 key-name field holding a pasted credential (R10): never echoed or migrated.
# A known prefix counts only with a token-like body (16+ letters and digits, or
# separators with both digits and capitals), so npm_token or ghs_deploy load.
TOKEN_RE = re.compile(r"^(sk-ant-[a-z]+\d\d-|eyJ)[\w.-]{10}|^(AKIA|ASIA)[A-Z0-9]{16}$"
                      r"|^(sk-|gh[pousr]_|github_pat_|glpat-|npm_|hf_|AIza|xox[abposr]-|xapp-)"
                      r"([A-Za-z0-9]{16,}|(?=.*\d)(?=.*[A-Z])[\w.-]{16,})$")
PASTED = "looks like a pasted token, not a key name (the value is not repeated)"
# The same prefixes anywhere inside a string (redact_argv), plus JWTs and a
# `Bearer` value: what a shell-expanded credential in an argv looks like.
TOKEN_IN_RE = re.compile(r"(?<![\w-])(?:sk-ant-[a-z]+\d\d-[\w-]{10,}|eyJ[\w-]{10,}(?:\.[\w-]+){0,2}"
                         r"|(?:AKIA|ASIA)[A-Z0-9]{16}(?![A-Za-z0-9])"
                         r"|(?:sk-|gh[pousr]_|github_pat_|glpat-|npm_|hf_|AIza|xox[abposr]-|xapp-)"
                         r"(?:[A-Za-z0-9]{16,}|(?=[\w.-]*\d)(?=[\w.-]*[A-Z])[\w.-]{16,}))"
                         r"|(?<=[Bb]earer )[\w.~+/=-]{16,}")
# Variables whose values redact_argv hides: credentials actas or the tools
# put in the environment, and any name that says it holds one.
CRED_VARS = set("GH_TOKEN GITHUB_TOKEN GH_ENTERPRISE_TOKEN GITHUB_ENTERPRISE_TOKEN COPILOT_GITHUB_TOKEN "
                "ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN CLAUDE_CODE_OAUTH_TOKEN AWS_BEARER_TOKEN_BEDROCK "
                "OPENAI_API_KEY CODEX_API_KEY CODEX_ACCESS_TOKEN GEMINI_API_KEY GOOGLE_API_KEY "
                "AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN AZURE_CLIENT_SECRET".split())
CRED_NAME_RE = re.compile(r"TOKEN|SECRET|PASSW|API_?KEY|ACCESS_KEY|PRIVATE_KEY|AUTH_KEY", re.I)


def pasted_token(v):
    return isinstance(v, str) and (len(v) > 64 or bool(TOKEN_RE.match(v)))


def v1_profile(L, body, probs):
    p = f"environments.{L}"
    out, claude, github, git = {}, {}, {}, {}
    for k in body:
        if k not in V1_KEYS:
            probs.unknown(f"{p}.{k}", k, V1_KEYS)

    def sub(key):
        v = body.get(key)
        if v is None:
            return None
        if not isinstance(v, dict):
            probs.error(f"{p}.{key}", f"expected a map, got {type_name(v)}")
            return None
        for k in v:
            if k not in V1_KEYS[key]:
                probs.unknown(f"{p}.{key}.{k}", k, V1_KEYS[key])
        return v

    m = body.get("match")
    if m is not None:
        if not isinstance(m, (str, list)):
            probs.error(f"{p}.match", f"expected a string or list, got {type_name(m)}")
        else:
            out["match"] = [str(x) for x in as_list(m)]
    provider = body.get("provider")
    if provider is not None and not isinstance(provider, str):
        probs.error(f"{p}.provider", f"expected a string, got {type_name(provider)}")
        provider = None
    provider = (provider or "subscription").lower()
    if provider not in ("subscription", "gateway"):
        probs.error(f"{p}.provider", f"unknown provider {provider!r}: v1 files support "
                    "subscription or gateway" + did_you_mean(provider, ("subscription", "gateway")))
    gw = sub("gateway")
    if provider == "gateway":
        gw = gw or {}
        claude["provider"] = "gateway"
        if gw.get("base_url") is not None:
            claude["base_url"] = gw["base_url"]
        secret, src = gw.get("secret", "token"), gw.get("secret_from", L)
        pasted = [w for w, val in (("secret", secret), ("secret_from", src)) if w in gw and pasted_token(val)]
        for what, val in (("secret", secret), ("secret_from", src)):
            if what in pasted:
                probs.error(f"{p}.gateway.{what}", PASTED)
            elif not isinstance(val, str) or not NAME_RE.match(val):
                probs.error(f"{p}.gateway.{what}", "invalid name: use letters, digits, '.', '_' or '-'")
        if not pasted:                 # the ref would carry the token into doctor and migrate
            claude["token"] = f"sops:{src}/{secret}"
        claude["export_token"] = True
    args = body.get("claude_args")
    if args and isinstance(args, str):
        probs.warn(f"{p}.claude_args", "is a string; split like a shell would "
                                       "(write a list to be explicit)")
        try:
            claude["args"] = shlex.split(args)
        except ValueError as e:
            probs.error(f"{p}.claude_args", f"cannot split it: {e}")
    elif args and (not isinstance(args, list) or not all(isinstance(x, str) for x in args)):
        probs.error(f"{p}.claude_args", "expected a list of strings")
    elif args:
        claude["args"] = list(args)
    aws = sub("aws") or {}
    aws_out = {k: aws[k] for k in ("profile", "region") if aws.get(k)}
    gh = sub("github")
    if gh:
        if gh.get("account"):
            github["auth"] = f"gh:{gh['account']}"
        for k in ("name", "email"):
            if gh.get(k):
                git[k] = gh[k]
    se = body.get("secret_env")
    secret_env = None
    if se is not None:
        if not isinstance(se, dict):
            probs.error(f"{p}.secret_env", f"expected a map, got {type_name(se)}")
        else:
            secret_env = {}
            for var, key in se.items():
                if pasted_token(key):
                    probs.error(f"{p}.secret_env.{var}", PASTED)
                    continue
                if key is not None and (not isinstance(key, str) or not NAME_RE.match(key)):
                    probs.error(f"{p}.secret_env.{var}", "invalid secret name: use letters, digits, "
                                "'.', '_' or '-' (the value is not repeated, in case it is a secret)")
                    continue
                secret_env[var] = None if key is None else f"sops:{L}/{key}"
            # v1 applied secret_env last, so a GH_TOKEN there won for gh and
            # for git (the helper read $GH_TOKEN): make it the GitHub auth.
            if secret_env.get("GH_TOKEN"):
                ref = secret_env.pop("GH_TOKEN")
                github["auth"] = ref
                if secret_env.get("GITHUB_TOKEN") == ref:
                    secret_env.pop("GITHUB_TOKEN")
    out.update((k, v) for k, v in (("claude", claude), ("aws", aws_out), ("github", github), ("git", git)) if v)
    if body.get("env") is not None:
        out["env"] = body["env"]
    if secret_env:
        out["secret_env"] = secret_env
    if body.get("agents_may_use") is not None:   # agent reach only; no effect on the environment
        out["agents_may_use"] = body["agents_may_use"]
    out["permissions"] = {"builtin": False}    # v1 rendered no agent rules
    return out


# ================================================== composition and resolution

def get_path(x, p):
    for k in p:
        if not isinstance(x, dict):
            return None
        x = x.get(k)
    return x


def linearize(name, nodes, stack=()):
    if name in stack:
        raise ManifestError("cycle: " + " -> ".join(stack + (name,)))
    if len(stack) >= MAX_DEPTH:
        raise ManifestError(f"use: chain deeper than {MAX_DEPTH} at {name}")
    if name not in nodes:
        raise ManifestError(f"unknown role or profile {name!r} in use: of {stack[-1]}"
                            + did_you_mean(name, nodes))
    order = []
    for parent in as_list(nodes[name].get("use")):
        for n in linearize(parent, nodes, stack + (name,)):
            if n not in order:
                order.append(n)
    order.append(name)
    return order                    # diamond A:[B,C], B,C:[D] -> D,B,C,A


def guard_sticky(old, p, layer, prov):
    """Replacing or nulling a value must not drop a sticky list at or below it."""
    for sp in sorted(STICKY):
        if sp[:len(p)] == p and get_path(old, sp[len(p):]):
            src = (prov.get(sp) or {}).get("from", "?")
            raise ManifestError(f"{layer}: cannot replace {'.'.join(p)}: it would drop "
                                f"{'.'.join(sp)} (added by {src})")


def note(prov, p, layer, value, old):
    prev = prov.get(p)
    prov[p] = {"from": layer, "value": copy.deepcopy(value),
               "was": None if old is None else {"from": prev and prev["from"],
                                                "value": copy.deepcopy(old)}}


def drop_below(prov, p):
    for q in [q for q in prov if len(q) > len(p) and q[:len(p)] == p]:
        del prov[q]


def merge(dst, src, layer, prov, path=()):
    for k, v in src.items():
        if not path and k in LOCAL_ONLY:
            continue
        p = path + (k,)
        old = dst.get(k)
        if v is None or (old is not None and not isinstance(v, dict) and p not in UNION):
            guard_sticky(old, p, layer, prov)
        if v is None:
            dst.pop(k, None)
            drop_below(prov, p)
            note(prov, p, layer, None, old)
        elif v == "inherit" and len(p) == 1 and k in MODULE_KEYS:
            dst[k] = "inherit"
            drop_below(prov, p)
            note(prov, p, layer, "inherit", old)
        elif isinstance(v, dict):
            if not isinstance(old, dict):
                dst[k] = {}         # fresh map: recurse so nested nulls get provenance
                prov.pop(p, None)
            merge(dst[k], v, layer, prov, p)
        elif p in UNION:
            cur = as_list(old)
            dst[k] = cur + [x for x in as_list(v) if x not in cur]
            note(prov, p, layer, dst[k], old)
        else:
            dst[k] = copy.deepcopy(v)
            note(prov, p, layer, v, old)


def merge_profile(name, cfg, check=True):
    """SPEC 3.1: defaults, then the use: chain (linearized), then the profile.
    Returns the effective profile; meta keys start with "_"."""
    if name not in cfg.profiles:
        if name in cfg.roles:
            raise ManifestError(f"{name} is a role; roles are used by profiles, not run", 2)
        raise ManifestError(f"unknown profile {name!r}{did_you_mean(name, cfg.profiles)}. known: "
                            f"{', '.join(sorted(cfg.profiles)) or '(none)'}\n       see: actas list")
    nodes = {**cfg.roles, **cfg.profiles}
    out, prov = {}, {}
    merge(out, cfg.defaults, "defaults", prov)
    chain = linearize(name, nodes)
    for layer in chain:
        merge(out, nodes[layer], layer, prov)
    inherited = max([LEVELS[nodes[n]["level"]] for n in chain[:-1] if nodes[n].get("level")] or [0])
    declared = nodes[name].get("level")
    if declared and LEVELS[declared] < inherited:
        raise ManifestError(f"{name}: declares level {declared} but uses a higher-level layer "
                            "(compose upward: a profile is at least as privileged as what it uses)")
    for k in ("level", "confirm"):
        out.pop(k, None)
        prov.pop((k,), None)
    out["level"] = LEVEL_NAMES[(max(inherited, LEVELS.get(declared, 0)) or LEVELS["standard"]) - 1]
    out["confirm"] = any(bool(nodes[n].get("confirm")) for n in chain)
    out["match"] = as_list(nodes[name].get("match"))
    # An absent key takes the defaults' list; a present one, even null or [], replaces it.
    own = nodes[name]["agents_may_use"] if "agents_may_use" in nodes[name] else cfg.defaults.get("agents_may_use")
    out["agents_may_use"] = list(own or [])
    out["_own_amu"] = "agents_may_use" in nodes[name]
    out["description"] = nodes[name].get("description")
    out["name"] = name
    out["_chain"] = ["defaults"] + chain
    out["_prov"] = prov
    out["_nulled"] = sorted(p for p, r in prov.items() if r["value"] is None and get_path(out, p) is None)
    out["_v1"] = cfg.version == 1
    out["_owned"] = owned_scope(cfg)
    if out["_v1"]:    # D-A: v1 left a module it did not configure alone
        out["_owned"] = [n for n in out["_owned"] if not (n.startswith("AWS_") and "aws" not in out
                                                          or n.startswith(("GH_", "GITHUB_")) and "github" not in out)]
        # v1 set git's identity too: the shell's GIT_AUTHOR_*/GIT_COMMITTER_*
        # would override it, so they go, but only for what the profile sets.
        g = section(out, "git")
        out["_owned"] += [f"GIT_{w}_{k.upper()}" for k in ("name", "email") if g.get(k)
                          for w in ("AUTHOR", "COMMITTER")]
    gh = out.get("github")
    m = REF_RES["gh"].match(gh.get("auth") or "") if isinstance(gh, dict) else None
    if m and not m.group(2) and gh.get("host") and gh["host"] != "github.com":
        # github.host names the account's host: gh:ada with host ghe.corp.example
        # is gh:ada@ghe.corp.example everywhere (token read, git helper, login).
        gh["auth"] = f"{gh['auth']}@{gh['host']}"
    out["_cred_rules"] = cred_rules(cfg)
    if check:
        check_selectors(out)
    return out


def check_selectors(prof):
    """Requirements that only make sense on the merged profile."""
    n, c, aws, gh = prof["name"], section(prof, "claude"), section(prof, "aws"), section(prof, "github")
    provider = c.get("provider") or "subscription"
    need = []
    if provider == "gateway":
        if not c.get("base_url"):
            need.append("gateway.base_url" if prof["_v1"] else "claude.base_url")
        if not c.get("token"):
            need.append("claude.token")
    elif provider == "api-key" and not c.get("token"):
        need.append("claude.token")
    elif provider == "bedrock":
        if not aws.get("region"):
            need.append("aws.region")
        if not aws.get("profile") and not c.get("bearer_token"):
            need.append("aws.profile or claude.bearer_token")
    elif provider == "vertex":
        if not c.get("region"):
            need.append("claude.region")
        if not c.get("project") and not section(prof, "gcp").get("project"):
            need.append("claude.project or gcp.project")
    if need:
        raise ManifestError(f"profile {n!r} is provider: {provider} but has no {', '.join(need)}")
    if gh.get("auth") and gh.get("home"):
        raise ManifestError(f"profile {n!r}: github sets both auth and home (pick one)")
    m = REF_RES["gh"].match(gh.get("auth") or "")
    if m and m.group(2) and gh.get("host") and gh["host"] != m.group(2):
        raise ManifestError(f"profile {n!r}: github.host {gh['host']} disagrees with "
                            f"{gh['auth']}")


def hit(cwd, pat):
    """cwd is pat, below pat, matches pat as a glob, or is below a directory
    that does (`~/code/*/infra` covers `~/code/a/infra/modules`)."""
    base = pat.rstrip("/")
    return (cwd == pat or cwd.startswith(base + "/") or fnmatch.fnmatch(cwd, pat)
            or (has_glob(pat) and fnmatch.fnmatch(cwd, base + "/*")))


def match_dir(cfg, cwd, fold=False):
    """v1 algorithm: longest expanded pattern wins; a tie keeps the earlier one."""
    best, best_len, best_pat = None, -1, None
    for name, body in cfg.profiles.items():
        for pat in as_list(body.get("match")):
            ex = expand(pat)
            c, x = (cwd.casefold(), ex.casefold()) if fold else (cwd, ex)
            if hit(c, x) and len(ex) > best_len:
                best, best_len, best_pat = name, len(ex), pat
    return best, best_pat


def locate(cfg, cwd=None):
    """Directory -> (profile name or None, matched_by, pattern, expanded cwd).
    Fallbacks are tried only when the v1 algorithm finds nothing (SPEC 3.3)."""
    cwd = expand(cwd or os.getcwd())
    name, pat = match_dir(cfg, cwd)
    if name:
        return name, "pattern", pat, cwd
    pwd = os.environ.get("PWD")
    if pwd and expand(pwd) != cwd:
        try:
            same = os.path.samefile(pwd, cwd)
        except OSError:
            same = False
        if same:
            name, pat = match_dir(cfg, expand(pwd))
            if name:
                return name, "logical-pwd", pat, cwd
    if sys.platform == "darwin" or os.path.normcase("A") != "A":
        name, pat = match_dir(cfg, cwd, fold=True)
        if name:
            return name, "casefold", pat, cwd
    if cfg.fallback:
        return cfg.fallback, "fallback", None, cwd
    return None, None, None, cwd


def resolve(name=None, cwd=None, cfg=None):
    """Pick a profile by name, or by matching the working directory against
    each profile's `match` patterns, and return it merged."""
    cfg = cfg or load()
    if not name:
        name, _, _, path = locate(cfg, cwd)
        if not name:
            no_match(cfg, path)
    try:
        return merge_profile(name, cfg)
    except ManifestError as e:
        die(str(e), e.code)


def suggest_match(path):
    """The pattern the no-match hint offers: the top of path's git repository
    when that is below HOME, else path. It walks path's own spelling (not
    git's resolved one), so the pattern also matches under a symlink."""
    home, d = str(HOME).rstrip("/"), path
    while d.startswith(home + "/"):
        if os.path.exists(os.path.join(d, ".git")):
            return d
        d = os.path.dirname(d)
    return path


def no_match_text(cfg, path):
    return (f"no profile matches {tilde(path)} (known: {', '.join(cfg.profiles) or '(none)'}); "
            f"add `match: [{json.dumps(tilde(suggest_match(path)))}]` to a profile "
            "(it covers subdirectories too), or set `fallback: <profile>`")


def no_match(cfg, path):
    die(no_match_text(cfg, path))


def all_profiles(cfg, check=False, names=None):
    """Merge every profile (or names): ({name: profile}, {name: error})."""
    profs, errors = {}, {}
    for n in cfg.profiles if names is None else names:
        try:
            profs[n] = merge_profile(n, cfg, check=check)
        except ManifestError as e:
            errors[n] = e
    return profs, errors


# =================================================================== secrets

def age_key_file():
    """sops resolves its default key path with Go's UserConfigDir, which on
    macOS is ~/Library/Application Support, not ~/.config. Point it at
    whichever location actually holds the key."""
    if os.environ.get("SOPS_AGE_KEY_FILE"):
        return os.environ["SOPS_AGE_KEY_FILE"]
    for c in (HOME / ".config" / "sops" / "age" / "keys.txt",
              HOME / "Library" / "Application Support" / "sops" / "age" / "keys.txt"):
        if c.exists():
            return str(c)
    return None


def sops_env():
    e = dict(os.environ)
    k = age_key_file()
    if k:
        e["SOPS_AGE_KEY_FILE"] = k
    return e


def secret_path(env_name, key):
    for kind, v in (("environment", env_name), ("secret", key)):
        if not isinstance(v, str) or not NAME_RE.match(v):
            die(f"invalid {kind} name {v!r}: use letters, digits, '.', '_' or '-'")
    return f'["{env_name}"]["{key}"]'


def sops_missing():
    if not SECRETS.exists():
        return f"no secrets file at {SECRETS}"
    return None if find_bin("sops") else "sops not found (brew install sops age)"


def sops_decrypt(args):
    return run([find_bin("sops"), "-d"] + args + [str(SECRETS)], env=sops_env(), timeout=30,
               stdin=subprocess.DEVNULL)


def sops_extract(a, b):
    """One-off read of ["a"]["b"] -> (value, error)."""
    err = sops_missing()
    if err:
        return None, err
    r = sops_decrypt(["--extract", secret_path(a, b)])
    if r.returncode != 0:
        return None, f"could not read secret {a}.{b}: {r.stderr.strip()}"
    return strip_nl(r.stdout), None


_SOPS = {}


def sops_data():
    """Decrypt the whole secrets file once per invocation (D22)."""
    if "data" not in _SOPS:
        data, err = None, sops_missing()
        r = None if err else sops_decrypt(["--output-type", "json"])
        if r is not None and r.returncode != 0:
            err = f"could not decrypt {SECRETS}: {(r.stderr.strip().splitlines() or ['?'])[-1]}"
        elif r is not None:
            try:
                data = json.loads(r.stdout)
            except ValueError:
                err = f"could not decrypt {SECRETS}: sops printed no JSON"
        _SOPS.update(data=data if isinstance(data, dict) else {}, err=err)
    return _SOPS["data"], _SOPS["err"]


def gh_home_managed(path):
    """A GH_CONFIG_DIR under STATE/homes/github: the `_off` home or another
    profile's `github.home`, never where `gh auth login` stored gh: accounts."""
    if not path:
        return False
    with suppress(OSError, ValueError):
        p = os.path.realpath(expand(path))
        base = os.path.realpath(str(STATE / "homes" / "github"))
        return p == base or p.startswith(base.rstrip(os.sep) + os.sep)
    return False


def gh_own_env():
    """os.environ for the user's own gh config, where gh: accounts live: inside
    a session GH_CONFIG_DIR may point at actas's empty fail-closed home or another
    profile's managed home, and a token in the env would shadow the account."""
    env = {k: v for k, v in os.environ.items() if not k.endswith("_TOKEN")}
    if gh_home_managed(env.get("GH_CONFIG_DIR", "")):
        del env["GH_CONFIG_DIR"]
    return env


def read_gh(user, host):
    gh = find_bin("gh")
    if not gh:
        return None, "gh not found (install the GitHub CLI)", None
    env = gh_own_env()
    r = run([gh, "auth", "token", "--user", user, "--hostname", host], timeout=30,
            stdin=subprocess.DEVNULL, env=env)
    tok = strip_nl(r.stdout) if r.returncode == 0 else ""
    if not tok.strip():
        return None, f"no stored gh token for account {user!r}", f"run: gh auth login --hostname {host}"
    return tok, None, None


def read_ref(ref, batch=False):
    """Resolve one ref -> (value, error, hint). batch=True uses the one-shot
    sops decrypt; otherwise sops --extract reads just that key."""
    err = ref_error(ref)
    if err:
        return None, f"invalid ref: {err}", None
    s = ref_scheme(ref)
    if s == "sops":
        a, b = REF_RES["sops"].match(ref).groups()
        hint = f"run: actas secret {a} {b} --set"
        if not batch:
            v, e = sops_extract(a, b)
            return v, e, hint if e else None
        data, e = sops_data()
        if e:
            return None, e, None
        v = data.get(a).get(b) if isinstance(data.get(a), dict) else None
        if v is None or isinstance(v, (dict, list)):
            return None, f"secret {a}.{b} is not set", hint
        return (strip_nl(v) if isinstance(v, str) else json.dumps(v)), None, None
    if s == "gh":
        user, host = REF_RES["gh"].match(ref).groups()
        return read_gh(user, host or "github.com")
    if s == "keychain":
        if sys.platform != "darwin":
            return None, ('keychain: refs need macOS; elsewhere use '
                          'cmd:["secret-tool", "lookup", "service", "<name>"]'), None
        svc, acct = REF_RES["keychain"].match(ref).groups()
        argv = ["security", "find-generic-password", "-s", svc, "-a", acct, "-w"]
    elif s == "op":
        argv = ["op", "read", ref]
    else:
        argv = json.loads(ref[4:])
    exe = argv[0] if "/" in argv[0] else find_bin(argv[0])
    if not exe:
        return None, f"{argv[0]} not found (needed for {s}: refs)", None
    r = run([exe] + argv[1:], timeout=30, stdin=subprocess.DEVNULL)
    if r.returncode != 0:
        last = (r.stderr.strip().splitlines() or [f"exit {r.returncode}"])[-1]
        return None, f"could not read {ref}: {last}", (f"run: actas secret set {ref}"
                                                       if s == "keychain" else None)
    return strip_nl(r.stdout), None, None


def resolve_refs(refs):
    """{VAR: ref} -> {VAR: value or None}. Missing secrets warn, never fail."""
    seen, out, missing = {}, {}, {}
    for var, ref in refs.items():
        if ref not in seen:
            seen[ref] = read_ref(ref, batch=True)
        out[var] = seen[ref][0]
        if out[var] is None:
            missing.setdefault(ref, []).append(var)
    for ref, names in missing.items():
        _, err, hint = seen[ref]
        warn(f"{err}, leaving {', '.join(names)} unset" + (f" ({hint})" if hint else ""))
    return out


def secret_set_ref(ref):
    """`actas secret set REF`: sops (value prompted or from stdin) or keychain
    (security prompts for it itself: -w last, no value, never in argv)."""
    err = ref_error(ref)
    if err:
        die(f"invalid ref: {err}", 2)
    s = ref_scheme(ref)
    if s == "sops":
        secret_set(*REF_RES["sops"].match(ref).groups(), read_secret_value())
    elif s == "keychain":
        if sys.platform != "darwin":
            die("keychain: refs need macOS; store the value with your secret tool and use a cmd: ref")
        security = find_bin("security") or die("security not found")
        svc, acct = REF_RES["keychain"].match(ref).groups()
        r = run([security, "add-generic-password", "-U", "-s", svc, "-a", acct, "-w"],
                capture_output=False)
        if r.returncode != 0:
            die(f"could not store {ref} in the keychain")
    else:
        die(f"{s}: refs are read-only for actas; store the value with that tool")
    info(f"stored {ref}")


def secret_set(env_name, key, value):
    if not value:
        die("refusing to store an empty secret")
    path = secret_path(env_name, key)
    sops = find_bin("sops") or die("sops not found (brew install sops age)")
    if not SECRETS.exists():
        # sops looks for .sops.yaml from the current directory upwards, so
        # name it explicitly - actas is usually run from a project directory.
        cfg = ROOT / ".sops.yaml"
        if not cfg.exists():
            die(f"no {cfg} saying who can decrypt secrets (run: actas init)")
        write_private(SECRETS, "_meta:\n  managed_by: actas\n")
        r = run([sops, "--config", str(cfg), "-e", "-i", str(SECRETS)], env=sops_env())
        if r.returncode != 0:
            SECRETS.unlink()
            die(f"could not initialise secrets file: {r.stderr.strip()}")
    r = run([sops, "set", "--help"], stdin=subprocess.DEVNULL, timeout=30)
    if "--value-stdin" in (r.stdout or "") + (r.stderr or ""):
        r = run([sops, "set", "--value-stdin", str(SECRETS), path], input=json.dumps(value),
                env=sops_env())
    else:
        warn("older sops without --value-stdin: the value is visible in `ps` briefly")
        r = run([sops, "set", str(SECRETS), path, json.dumps(value)], env=sops_env())
    if r.returncode != 0:
        die(f"could not write secret: {r.stderr.strip()}")


# =================================================================== helpers

def _under(p, d):
    p, d = os.path.abspath(p), os.path.abspath(d)
    return p == d or p.startswith(d.rstrip("/") + "/")


XCODE_PY_RE = re.compile(r"^/Applications/Xcode[^/]*\.app/Contents/Developer/|^/Library/Developer/CommandLineTools/")


def helper_python():
    """The python helper strings run (SPEC 5.4): the base interpreter of a
    venv or conda env (F31), so deleting the env keeps helpers working; no
    realpath (Homebrew's symlink survives upgrades); the stable /usr/bin/python3
    stub, not the Xcode/CLT python it re-executes (F44)."""
    py = os.path.abspath(sys.executable or "python3")
    if sys.prefix != sys.base_prefix or "envs" in Path(sys.prefix).parts:
        base = getattr(sys, "_base_executable", None)
        cands = [base] if base else []
        cands += [os.path.join(d or ".", "python3") for d in os.environ.get("PATH", "").split(os.pathsep)]
        py = next((os.path.abspath(c) for c in cands if os.path.isfile(c) and os.access(c, os.X_OK)
                   and not _under(c, sys.prefix)), py)
    return SYSTEM_PY if XCODE_PY_RE.match(py) and os.path.isfile(SYSTEM_PY) else py


SYSTEM_PY = "/usr/bin/python3"


def current_name(path):
    """Legacy: started through the deprecated `ccenv` alias (the package's
    second console script, or a bin/ccenv link), helpers name the `actas`
    next to it when there is one, so the next sync writes the new name."""
    d, base = os.path.split(path)
    alt = os.path.join(d, "actas")
    return alt if base == "ccenv" and os.path.exists(alt) else path


def helper_prefix(quiet=False):
    """How helper strings call actas (SPEC 5.4): the package's console script
    (it carries its venv's shebang), else python plus this script's path as
    started, without realpath, so a symlinked install survives a moved checkout.
    quiet: no project-local warning (agent_policy renders it into deny rules)."""
    if BUILD == "package":
        a = sys.argv[0] if sys.argv and sys.argv[0] else "actas"
        a = os.path.abspath(a) if "/" in a else (shutil.which(a) or os.path.abspath(a))
        return shell_quote(current_name(a))
    py = helper_python()
    if not quiet and (_under(py, os.getcwd()) or {".venv", "venv", "envs"} & set(Path(py).parts)):
        warn(f"helpers will run {py}, which looks project-local; "
             "run actas with a system python3 so helpers survive")
    return shell_quote(py) + " " + shell_quote(current_name(os.path.abspath(__file__)))


def api_key_helper(ref):
    return f"{helper_prefix()} secret --ref {shell_quote(ref)}"


def git_helper(ref, username):
    return (f"!{helper_prefix()} git-credential --ref {shell_quote(ref)} "
            f"--username {shell_quote(username)}")


# ===================================================== plans and environments

def new_plan():
    return {"set": {}, "secret": {}, "git": [], "settings": {}, "notes": []}


def home_dir(kind, value, ctx):
    """A module/tool home: a name under STATE/homes/<kind>/, or a path. Made
    (0700) only when launching; `_off` is the reserved empty home of null."""
    managed = not value.startswith(("/", "~"))
    path = STATE / "homes" / kind / value if managed else Path(expand(value))
    if ctx.get("materialize"):
        if managed and value == "_off":
            off_aside([kind])
        ensure_dir(path, tighten=managed)
    return str(path)


def off_aside(mods=None, move=True):
    """A login in an `_off` home (F2), which every null / fail-closed profile
    expects empty: move it aside (kept, not deleted), or only warn."""
    for kind in mods or sorted(OFF_CRED):
        path = STATE / "homes" / kind / "_off"
        found = ", ".join(off_logins(path))
        if not found:
            continue
        what = f"{tilde(path)} must stay empty, but someone logged in there ({found})"
        if not move:
            warn(f"{what}; actas run, exec and sync move it aside")
            continue
        aside = path.with_name(f"_off.{time.strftime('%Y%m%d-%H%M%S')}.{os.getpid()}")
        try:
            os.rename(str(path), str(aside))
        except OSError as e:
            die(f"{what}, and moving it aside failed ({e.strerror}); remove it by hand")
        warn(f"{what}; moved it to {tilde(aside)} and started a new empty one. Log in in a named "
             f"{kind}.home instead, and delete the moved directory")


def off_logins(path):
    """The credential files a login left in an `_off` home (OFF_CRED); the
    empty aws files actas makes there do not count."""
    found = []
    for n in OFF_CRED.get(Path(path).parent.name, ()):
        f = os.path.join(str(path), n)
        if os.path.isdir(f) or (os.path.isfile(f) and os.path.getsize(f) > 0):
            found.append(n)
    return found


def emit_vars(mod, v, ctx):
    """The table-driven part of every emitter (EMITS)."""
    p = new_plan()
    for key, spec in EMITS.get(mod, {}).items():
        if v.get(key):
            kind, _, names = spec.rpartition(":")
            val = (home_dir(mod, v[key], ctx) if kind == "home"
                   else expand(v[key]) if kind == "path" else v[key])
            for n in names.split():
                p["set"][n] = val
    return p


def emit_null(mod, ctx):
    """SPEC 4.8: point the tool at an empty actas-owned config, so it cannot
    fall back to [default], the global gcloud account, ~/.azure or gh's keyring."""
    p, off = new_plan(), home_dir(mod, "_off", ctx)
    if mod == "aws":
        for var, f in (("AWS_CONFIG_FILE", "config"), ("AWS_SHARED_CREDENTIALS_FILE", "credentials")):
            path = os.path.join(off, f)
            if ctx.get("materialize") and not os.path.exists(path):
                write_private(path, "")
            p["set"][var] = path
    else:
        p["set"][NULL_VARS[mod]] = off
    p["notes"].append(f"{mod}: off (isolated in {tilde(off)})")
    return p


def emit_aws(a, prof, ctx):
    p = emit_vars("aws", a, ctx)
    aws = find_bin("aws") if a.get("profile") else None
    if aws:
        p["settings"]["awsAuthRefresh"] = f"{shell_quote(aws)} sso login --profile {shell_quote(a['profile'])}"
    return p


def emit_azure(z, prof, ctx):
    p = emit_vars("azure", z, ctx)
    if not z.get("home"):
        p["notes"].append("azure: no home, so az uses ~/.azure's current subscription; "
                          "only Terraform (ARM_SUBSCRIPTION_ID) is pinned")
    return p


def gh_host(gh):
    m = REF_RES["gh"].match(gh.get("auth") or "")
    return (m and m.group(2)) or gh.get("host") or "github.com"


def gh_token_vars(host):
    return (("GH_TOKEN", "GITHUB_TOKEN") if host == "github.com" or host.endswith(".ghe.com")
            else ("GH_ENTERPRISE_TOKEN", "GITHUB_ENTERPRISE_TOKEN"))


def emit_github(g, prof, ctx):
    p, host = new_plan(), gh_host(g)
    if g.get("auth"):
        if host != "github.com":
            p["set"]["GH_HOST"] = host        # gh outside a repo would default to github.com
        p["secret"].update(dict.fromkeys(gh_token_vars(host), g["auth"]))
        if not prof["_v1"] and not ctx.get("human_shell"):
            # Fail closed: with the token missing or stripped, gh finds an
            # empty config instead of the keyring's active account. Not in
            # the human's own direnv/shell output, which leaves the token out
            # by design: there gh keeps working with its keyring (F16).
            p["set"]["GH_CONFIG_DIR"] = home_dir("github", "_off", ctx)
    elif g.get("home"):
        p["set"]["GH_CONFIG_DIR"] = home_dir("github", g["home"], ctx)
        if host != "github.com":
            p["set"]["GH_HOST"] = host
    return p


def github_pairs(prof):
    """Reset the credential helper list for the host, then add ours (D2)."""
    g = prof.get("github")
    if isinstance(g, dict):
        key = f"credential.https://{gh_host(g)}.helper"
        if g.get("auth"):
            return [(key, ""), (key, git_helper(g["auth"], "x-access-token"))]
        gh = find_bin("gh") if g.get("home") else None
        return [(key, ""), (key, f"!{shell_quote(gh)} auth git-credential")] if gh else []
    if ("github",) in prof["_nulled"]:
        return [("credential.https://github.com.helper", "")]   # nothing authenticates
    return []


def emit_git(prof):
    """Git pairs in SPEC 4.6 order: identity, sshCommand, signing, github,
    credentials, config. Nothing touches ~/.gitconfig."""
    p, g, pairs = new_plan(), section(prof, "git"), []
    for key, name in (("name", "user.name"), ("email", "user.email")):
        if g.get(key):
            pairs.append((name, g[key]))
    if g.get("ssh_key"):
        pairs.append(("core.sshCommand",
                      f"ssh -i {shell_quote(expand(g['ssh_key']))} -o IdentitiesOnly=yes"))
    sig = g.get("signing") or {}
    if sig.get("format"):
        pairs.append(("gpg.format", sig["format"]))
    if sig.get("key"):
        pairs.append(("user.signingkey", sig["key"]))
    if sig.get("program"):
        pairs.append(("gpg.ssh.program" if sig.get("format") == "ssh" else "gpg.program",
                      sig["program"]))
    if isinstance(g.get("sign"), bool):
        pairs += [(k, "true" if g["sign"] else "false") for k in ("commit.gpgsign", "tag.gpgsign")]
    pairs += github_pairs(prof)
    for url, c in (g.get("credentials") or {}).items():
        if isinstance(c, dict) and c.get("token"):
            key = f"credential.{url}.helper"
            pairs += [(key, ""), (key, git_helper(c["token"], c.get("username") or "x-access-token"))]
    pairs += [(k, v) for k, v in (g.get("config") or {}).items() if v is not None]
    p["git"] = pairs
    return p


def emit_claude(c, prof, ctx):
    """SPEC 6.1. Process env plus the settings fragment (provider blanks and
    apiKeyHelper); tokens reach Claude through apiKeyHelper, not the file."""
    provider = c.get("provider") or "subscription"
    p = emit_vars("claude", c, ctx)
    s, st = p["set"], p["settings"]
    home = s.get("CLAUDE_CONFIG_DIR")
    if home and ctx.get("materialize") and not os.listdir(home):
        info(f"{tilde(home)} has no login yet: run /login in the first claude session started there")
    st["env"] = dict.fromkeys(("ANTHROPIC_BASE_URL",) + CLAUDE_USE, "")
    st["apiKeyHelper"] = ""
    if provider in ("gateway", "api-key"):
        st["apiKeyHelper"] = api_key_helper(c["token"])
        if provider == "gateway":
            s["ANTHROPIC_BASE_URL"] = c["base_url"]
        if c.get("export_token"):
            var = ("ANTHROPIC_API_KEY" if provider == "api-key" or c.get("auth_header") == "x-api-key"
                   else "ANTHROPIC_AUTH_TOKEN")
            p["secret"][var] = c["token"]
    elif provider == "subscription" and c.get("oauth_token"):
        p["secret"]["CLAUDE_CODE_OAUTH_TOKEN"] = c["oauth_token"]
    elif provider == "bedrock":
        s["CLAUDE_CODE_USE_BEDROCK"] = "1"
        if c.get("base_url"):
            s["ANTHROPIC_BEDROCK_BASE_URL"] = c["base_url"]
        if c.get("bearer_token"):
            p["secret"]["AWS_BEARER_TOKEN_BEDROCK"] = c["bearer_token"]
        if not c.get("models") and ctx.get("materialize"):
            warn("bedrock without claude.models: pin model IDs your account has enabled")
    elif provider == "vertex":
        s["CLAUDE_CODE_USE_VERTEX"] = "1"
        s["ANTHROPIC_VERTEX_PROJECT_ID"] = c.get("project") or section(prof, "gcp").get("project")
        s["CLOUD_ML_REGION"] = c["region"]
    for k, var in MODEL_VARS.items():
        if (c.get("models") or {}).get(k):
            s[var] = c["models"][k]
    return p


def emit_gemini(x, prof, ctx):
    p = emit_vars("gemini", x, ctx)
    if x.get("auth") == "vertex":
        p["set"]["GOOGLE_GENAI_USE_VERTEXAI"] = "true"
        project = x.get("project") or section(prof, "gcp").get("project")
        if project:
            p["set"]["GOOGLE_CLOUD_PROJECT"] = project
        if x.get("location"):
            p["set"]["GOOGLE_CLOUD_LOCATION"] = x["location"]
    elif x.get("api_key"):
        p["secret"]["GEMINI_API_KEY"] = x["api_key"]
    return p


EMITTERS = {"aws": emit_aws, "azure": emit_azure, "github": emit_github, "claude": emit_claude,
            "gemini": emit_gemini}


def emit(mod, prof, ctx):
    """One Plan per module/tool (SPEC 4.1), or None when it emits nothing."""
    v = prof.get(mod)
    if mod in ("env", "secret_env"):
        p = new_plan()
        p["set" if mod == "env" else "secret"].update(
            {k: x for k, x in (v or {}).items() if x is not None})
        return p
    if mod == "git":
        p = emit_git(prof)
    elif isinstance(v, dict) or mod == "claude":
        v = section(prof, mod)
        p = EMITTERS[mod](v, prof, ctx) if mod in EMITTERS else emit_vars(mod, v, ctx)
    elif v is None and (mod,) in prof["_nulled"] and mod in NULL_VARS:
        return emit_null(mod, ctx)
    else:
        return None
    if ctx.get("agent") and isinstance(prof.get(mod), dict):
        p["set"].update(AGENT_ENV.get(mod, {}))
    return p


def owned_scope(cfg):
    """SPEC 4.1: what a run may scrub from the parent env. v2: the owned
    variables of every module/tool referenced anywhere in the manifest, plus
    every secret_env name the manifest defines (one profile's token must not
    reach another's session). env: values are not secrets and are not owned
    (a profile that wants one cleared lists it in unset:). Translated v1:
    exactly what v1 managed."""
    if cfg.owned is None:
        if cfg.version == 1:
            cfg.owned = list(V1_OWNED)
            return cfg.owned
        refd, bodies = referenced(cfg)
        owned = [v for m in PLAN_ORDER if m in refd for v in OWNS[m]]
        if any(section(b, "claude").get("home") for b in bodies):
            owned += OWNS_IF["claude"]
        if any("aws" in b and (b["aws"] is None or section(b, "aws").get("config_file")) for b in bodies):
            owned += OWNS_IF["aws"]
        owned += sorted({k for b in bodies for k in section(b, "secret_env")
                         if k not in owned and k not in NEVER_OWNED and not k.startswith(NEVER_OWNED_PREFIX)})
        cfg.owned = owned
    return cfg.owned


def referenced(cfg):
    """Modules/tools named anywhere in the manifest (claude when some
    profile's tool is claude), and the bodies looked at."""
    bodies = [cfg.defaults] + list(cfg.roles.values()) + list(cfg.profiles.values())
    refd = {k for b in bodies for k in b if k in OWNS}
    if any(profile_tool(cfg, n) == "claude" for n in cfg.profiles):
        refd.add("claude")
    return refd, bodies


def rule_path(p):
    """A path in Claude's Read/Edit rule syntax: ~/x under HOME, else //abs
    (a single leading / would be relative to the settings file)."""
    t = tilde(expand(p))
    return t if t.startswith("~") else "/" + expand(p)


def cred_rules(cfg):
    """SPEC 7.1, the file part of the secrets intent, rendered from the real
    ROOT, STATE, age key and the credential stores of referenced modules."""
    if cfg.cred_rules is None:
        refd, bodies = referenced(cfg)
        refd |= {profile_tool(cfg, n) for n in cfg.profiles}
        age = age_key_file() or "~/.config/sops/age/keys.txt"
        rules = [f"Edit({rule_path(ROOT)}/**)", f"Read({rule_path(age)})", f"Edit({rule_path(STATE)}/**)"]
        # Legacy: while ~/.config/ccenv (or the state dir) is in use, creating
        # the new place would move actas there, so it is guarded as well.
        rules += [f"Edit({rule_path(base / 'actas')}/**)" for d, base in
                  ((ROOT, HOME / ".config"), (STATE, XDG_STATE)) if d == base / "ccenv"]
        for m in PLAN_ORDER:
            if m not in refd:
                continue
            paths = list(CRED_PATHS.get(m, []))
            for c in as_list(HOME_CRED.get(m)):
                paths.append(f"{STATE}/homes/{m}/*/{c}")
                paths += [f"{expand(h)}/{c}" for h in
                          (section(b, m).get("home") for b in bodies)
                          if isinstance(h, str) and h.startswith(("/", "~"))]
            rules += [r for r in (f"Read({rule_path(x)})" for x in paths) if r not in rules]
        cfg.cred_rules = rules
    return cfg.cred_rules


def agent_policy(prof):
    """SPEC 7.2: the level preset (unless permissions.builtin is false), then
    the chain's deny/ask lists and claude.settings.permissions lists."""
    perms, level = section(prof, "permissions"), prof["level"]
    pol = {"builtin": perms.get("builtin") is not False, "deny": [], "ask": []}
    if pol["builtin"]:
        for intent, act in PRESETS[level].items():
            if act != "allow":
                pol[act] += INTENT_RULES[intent] + (list(prof.get("_cred_rules") or []) if intent == "secrets" else [])
            if act != "allow" and intent == "secrets":
                pol[act] += helper_rules()
    extra = section(section(prof, "claude").get("settings") or {}, "permissions")
    for k in ("deny", "ask"):
        for r in list(perms.get(k) or []) + [x for x in as_list(extra.get(k)) if isinstance(x, str)]:
            if r not in pol[k]:
                pol[k].append(r)
    pol["gemini"] = GEMINI_MODE[level]
    return pol


def helper_rules():
    """The exact command lines apiKeyHelper and git's credential helper run
    (the agent sees them in settings and GIT_CONFIG_VALUE_*), denied like the
    bare `actas secret`: INTENT_RULES' */actas forms miss a quoted path."""
    pre = helper_prefix(quiet=True)
    return [f"Bash({pre} {sub}*)" for sub in ("secret", "git-credential", "shell", "aws-handoff")]


def profile_tool(cfg, name):
    nodes = {**cfg.roles, **cfg.profiles}
    try:
        chain = linearize(name, nodes)
    except ManifestError:
        return "claude"
    tool = cfg.defaults.get("tool")
    for n in chain:
        tool = nodes[n].get("tool", tool)
    return tool or "claude"


def names_in(patterns, env):
    """Owned names; "*" entries are matched against the variables present."""
    out = set()
    for n in patterns:
        out |= {k for k in env if fnmatch.fnmatchcase(k, n)} if "*" in n else {n}
    return out


def git_config_env(pairs, parent, base=None):
    """GIT_CONFIG_* appended after the parent's pairs (D29). A nested actas
    truncates back to ACTAS_GIT_BASE. base=0 (sync, --format env, --vscode)
    starts from scratch; it still sets ACTAS_GIT_BASE=0, so an actas run from
    that app drops these pairs (a credential helper) instead of keeping them
    as the user's own."""
    if base is None:
        try:
            n0 = int(parent.get("GIT_CONFIG_COUNT") or 0)
        except ValueError:
            n0 = 0
        b = env_get("ACTAS_GIT_BASE", parent) or ""
        nested = b.isdigit() and int(b) <= n0
        n0 = int(b) if nested else n0
    else:
        n0, nested = base, False
    if not pairs and not nested:
        return {}
    out = {"GIT_CONFIG_COUNT": str(n0 + len(pairs))}
    for i, (k, v) in enumerate(pairs, n0):
        out[f"GIT_CONFIG_KEY_{i}"] = k
        out[f"GIT_CONFIG_VALUE_{i}"] = v
    out["ACTAS_GIT_BASE"] = str(n0)
    return out


class Ref(str):
    """A not-yet-resolved secret reference inside assemble()."""


def assemble(prof, want_secrets=True, parent=None, git_base=None, ctx=None):
    """SPEC 5.1. ctx: agent, tool (what run launches), materialize (create
    homes). Returns env (to set, Plan order, ACTAS last), remove (to drop from
    the parent), unset (those the parent has), scrubbed (the non-empty ones),
    scrub (declared scope), secret (names from refs), refs, conflicts,
    settings (Claude fragments), notes."""
    parent = os.environ if parent is None else parent
    ctx = ctx or {}
    out, origin, conflicts, frags, notes = {}, {}, [], [], []

    def put(var, val, mod):
        if var in out and origin[var] != mod and out[var] != val:
            conflicts.append((var, origin[var], mod))
        out[var], origin[var] = val, mod

    for mod in PLAN_ORDER:                       # later Plans win
        plan = emit(mod, prof, ctx)
        if plan is None:
            continue
        for k, v in plan["set"].items():
            put(k, v, mod)
        for k, v in git_config_env(plan["git"], parent, git_base).items() if mod == "git" else ():
            put(k, v, mod)
        for k, r in plan["secret"].items():
            put(k, Ref(r), mod)
        if plan["settings"]:
            frags.append(plan["settings"])
        notes += plan["notes"]
    explicit = [q[1] for q in prof["_nulled"] if len(q) == 2 and q[0] in ("env", "secret_env")]
    explicit += [k for k in prof.get("unset") or [] if k not in explicit]
    for k in explicit:                           # unset and null win over every Plan
        out.pop(k, None)
    inherit = set(prof.get("inherit") or [])
    for m in MODULE_KEYS:
        if prof.get(m) == "inherit":
            inherit |= set(OWNS.get(m, []) + OWNS_IF.get(m, []))
    plain = {k for k, v in out.items() if not isinstance(v, Ref)}
    refs = {k: str(v) for k, v in out.items() if isinstance(v, Ref)}
    scope = [n for n in prof.get("_owned", ()) if n not in inherit]
    # Secret names are dropped from the parent too: a missing secret leaves
    # the variable unset rather than the shell's (other identity's) value.
    remove = ((names_in(scope, parent) - names_in(inherit, parent)) | set(explicit) | set(refs)) - plain
    values = resolve_refs(refs) if want_secrets else {}
    for k in refs:
        if values.get(k) is None:
            del out[k]
        else:
            out[k] = values[k]
    # ACTAS_AGENT: the agent tool run launches, or the user's own marker (6.4).
    agent = ctx["tool"] if ctx.get("tool") in TOOL_NAMES else env_get("ACTAS_AGENT", out)
    for k in ("ACTAS_AGENT", "ACTAS_LEVEL", "ACTAS"):
        out.pop(k, None)
        out.pop(legacy_name(k), None)
    if agent is not None:
        out["ACTAS_AGENT"] = agent
    out["ACTAS_LEVEL"] = prof["level"]
    out["ACTAS"] = prof["name"]
    # Legacy: CCENV* markers an old shell or ccenv session left would name
    # another profile next to the new ACTAS* ones, so they are dropped.
    stale = {legacy_name(k) for k in ("ACTAS", "ACTAS_LEVEL", "ACTAS_GIT_BASE")}
    stale |= {legacy_name("ACTAS_AGENT")} if agent is not None else set()
    remove |= stale
    unset = sorted(k for k in remove if k in parent and k not in out)
    return {"env": out, "remove": sorted(remove), "unset": unset,
            "scrubbed": [k for k in unset if parent[k] != "" and k not in stale],
            "scrub": sorted((set(scope) | set(explicit)) - plain - set(refs)),
            "secret": sorted(refs), "refs": sorted(set(refs.values())), "conflicts": conflicts,
            "settings": frags, "notes": notes}


def child_env(res, parent=None):
    env = dict(os.environ if parent is None else parent)
    if "GIT_CONFIG_COUNT" in res["env"]:
        base = int(res["env"].get("ACTAS_GIT_BASE") or 0)
        for k in [k for k in env if re.match(r"^GIT_CONFIG_(KEY|VALUE)_\d+$", k)]:
            if int(k.rsplit("_", 1)[1]) >= base:
                del env[k]
    for k in res["remove"]:
        env.pop(k, None)
    env.update(res["env"])
    return env


def merge_settings(dst, src, path=()):
    """claude.settings passthrough: maps merge, permissions.* lists union."""
    for k, v in src.items():
        if isinstance(v, dict) and isinstance(dst.get(k), dict):
            merge_settings(dst[k], v, path + (k,))
        elif isinstance(v, list) and path == ("permissions",) and isinstance(dst.get(k), list):
            dst[k] = dst[k] + [x for x in v if x not in dst[k]]
        else:
            dst[k] = copy.deepcopy(v)


def public_env(res):
    return {k: v for k, v in res["env"].items() if k not in res["secret"] and k not in PROCESS_ONLY}


def settings_for(prof, res=None, source="run"):
    """SPEC 6.1: every non-secret variable the session sets (a settings-file
    value beats a shell export), the provider blanks, apiKeyHelper and
    awsAuthRefresh, then claude.settings, then the SessionStart hook (source
    run or sync). Never a secret value."""
    res = res or assemble(prof, want_secrets=False)
    s = {"env": {}}
    for frag in res["settings"]:
        for k, v in frag.items():
            if k == "env":
                s["env"].update(v)
            else:
                s[k] = v
    s["env"].update(public_env(res))
    pol = agent_policy(prof)                     # SPEC 7.3: Claude rules
    if pol["deny"] or pol["ask"]:
        s["permissions"] = {k: pol[k] for k in ("deny", "ask") if pol[k]}
    merge_settings(s, section(prof, "claude").get("settings") or {})
    hooks = s["hooks"] if isinstance(s.get("hooks"), dict) else {}
    s["hooks"] = hooks
    hooks["SessionStart"] = list(hooks.get("SessionStart") or []) + [
        {"hooks": [{"type": "command", "command": f"{helper_prefix()} hook session-start --profile "
                                                  f"{shell_quote(prof['name'])} --source {source}"}]}]
    return s


def write_settings_file(name, settings):
    """CACHE/<p>.<sha256[:12]>.settings.json: concurrent runs with different
    content never share a file. Files older than 7 days are pruned."""
    import hashlib
    text = json.dumps(settings, indent=2) + "\n"
    ensure_dir(CACHE, tighten=True)
    f = CACHE / f"{name}.{hashlib.sha256(text.encode()).hexdigest()[:12]}.settings.json"
    write_private(f, text)
    cutoff = time.time() - 7 * 86400
    for old in CACHE.glob("*.settings.json"):
        with suppress(OSError):
            if old.stat().st_mtime < cutoff:
                old.unlink()
    return f


def fish_quote(s):
    return "'" + str(s).replace("\\", "\\\\").replace("'", "\\'") + "'"


# ================================================================ guardrails
# SPEC 8 (Tier A, a seatbelt): agent detection from env markers and the
# process table, session records written by `actas run`, the elevation gate,
# `actas-stop:` refusals with exit 3/4 and an ask_user text, the audit log.

def read_ps():
    # The system ps before PATH: an agent can put a fake ps first in PATH to
    # hide its ancestors (F8). PATH only when neither system path exists.
    ps = next((p for p in PS_BINS if os.path.exists(p)), None) or find_bin("ps")
    if not ps:
        return None
    r = run([ps, "-A", "-o", "pid=,ppid=,lstart=,comm="], timeout=5, stdin=subprocess.DEVNULL,
            env=dict(os.environ, LC_ALL="C"))
    return r.stdout if r.returncode == 0 else None


_DAYS = ("Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun")
_MONTHS = ("Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec")
KINFO_SIZE, KINFO_PID, KINFO_PPID = 648, 40, 560   # struct kinfo_proc on 64-bit macOS; start time at 0


def ps_lstart(sec):
    """ps's lstart for a start time, as ps_table keeps it: `%c` in the C
    locale (day of month not zero-padded) with runs of spaces collapsed."""
    t = time.localtime(sec)
    return (f"{_DAYS[t.tm_wday]} {_MONTHS[t.tm_mon - 1]} {t.tm_mday} "
            f"{t.tm_hour:02d}:{t.tm_min:02d}:{t.tm_sec:02d} {t.tm_year}")


def read_chain():
    """macOS: this process and its ancestors, in read_ps's format, from
    sysctl instead of `ps -A` (whose ~80-120 ms goes on reading every
    process's arguments). Each row holds what ps prints: ppid and start
    time from KERN_PROC_PID, comm = argv[0] from KERN_PROCARGS2. A process
    whose arguments this user cannot read (another user's, such as login or
    launchd), or whose argv[0] is not plain printable ASCII (ps escapes
    it), is asked of the system ps with one `ps -p`, so every row equals
    its `ps -A` row. None (the caller then runs `ps -A`) off macOS or on
    anything unexpected. Nothing here depends on PATH or the environment."""
    if sys.platform != "darwin":
        return None
    try:
        import ctypes
        libc = ctypes.CDLL(None, use_errno=True)

        def sysctl(mib, size):
            buf, n = ctypes.create_string_buffer(size), ctypes.c_size_t(size)
            if libc.sysctl((ctypes.c_int * len(mib))(*mib), len(mib), buf, ctypes.byref(n), None, 0) != 0:
                return None
            return buf.raw[:n.value]

        def num(raw, off, size):
            return int.from_bytes(raw[off:off + size], sys.byteorder, signed=True)

        def argv0(pid):
            raw = sysctl((1, 49, pid), 1 << 16)       # CTL_KERN, KERN_PROCARGS2: argc, exec path, argv
            if not raw or len(raw) < 4 or num(raw, 0, 4) < 1:
                return None
            rest = raw[4:].split(b"\0", 1)
            if len(rest) < 2:
                return None
            a0 = rest[1].lstrip(b"\0").split(b"\0", 1)[0]     # ps skips the same NUL padding
            return a0.decode() if a0 and all(0x20 <= c < 0x7f for c in a0) else None

        rows, got, pid = {}, {}, os.getpid()
        while pid > 0 and pid not in rows and len(rows) < 66:
            k = sysctl((1, 14, 1, pid), KINFO_SIZE)   # CTL_KERN, KERN_PROC, KERN_PROC_PID
            if k == b"":
                break                                  # gone: `ps -A` would not list it either
            if k is None or len(k) != KINFO_SIZE or num(k, KINFO_PID, 4) != pid:
                return None                            # an unknown layout: use `ps -A`
            rows[pid] = (num(k, KINFO_PPID, 4), ps_lstart(num(k, 0, 8)), argv0(pid))
            pid = rows[pid][0]
        ask = [p for p, r in rows.items() if r[2] is None]
        if ask:
            # One pid per ps: given several, macOS ps reads the whole table
            # (~35 ms); one pid takes ~5 ms, and these run side by side.
            ps = next((p for p in PS_BINS if os.path.exists(p)), None)
            if not ps:
                return None
            groups = [[p] for p in ask] if len(ask) <= 4 else [ask]
            procs = [subprocess.Popen([ps, "-p", ",".join(map(str, g)), "-o", "pid=,ppid=,lstart=,comm="],
                                      stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                      stderr=subprocess.DEVNULL, text=True, env=dict(os.environ, LC_ALL="C"))
                     for g in groups]
            for pr in procs:
                try:
                    text = pr.communicate(timeout=5)[0]
                except subprocess.TimeoutExpired:
                    for x in procs:
                        x.kill()
                    return None
                for line in text.splitlines():
                    f = line.split(None, 7)
                    if len(f) == 8 and f[0].isdigit() and f[1].isdigit():
                        got[int(f[0])] = line
            if not got:
                return None
        out = []
        for p, (ppid, start, comm) in rows.items():   # child to ancestor
            if comm is None and p not in got:
                break                                  # exited meanwhile: the chain ends here, as in `ps -A`
            out.append(got[p] if comm is None else f"{p} {ppid} {start} {comm}")
        return "\n".join(out) + "\n"
    except Exception:
        return None


def read_procs():
    """The process table ps_table parses: on macOS only this process's
    ancestor chain (read_chain), else, or if that fails, `ps -A`."""
    return (read_chain() if PS_NATIVE else None) or read_ps()


def tty_confirm(prompt):
    """The human's typed answer, read from /dev/tty; None without a terminal."""
    try:      # separate handles: "r+" on a tty needs a seekable stream and always fails
        with open("/dev/tty", "w") as w, open("/dev/tty") as r:
            w.write(prompt)
            w.flush()
            return r.readline().strip()
    except OSError:
        return None


PS_READER = read_procs       # tests inject a fake process table
CONFIRM_FN = tty_confirm     # tests inject the typed answer
_CACHE = {}                  # per invocation: the process table, who(), the yq probe (cleared by main)
SESSIONS = STATE / "sessions"


def passwd_home():
    with suppress(KeyError):         # no passwd entry (some containers)
        return pwd.getpwuid(os.getuid()).pw_dir
    return None


# Fixed places no environment variable moves (F8): the system ps, and a
# per-user copy of every session record under the passwd home, so an agent
# that moves HOME/XDG_STATE_HOME still finds its record. actas_testlib
# rewrites these lines in its sandbox copy; there is no runtime override.
# PS_NATIVE: read the ancestor chain with sysctl on macOS (read_chain); the
# sandbox turns it off so its fake ps (which masks agent names) is used.
# The sessions dir follows the state dir's legacy fallback (legacy_dir): an
# old ccenv run's records are found while ~/.local/state/ccenv is in use. Once
# ~/.local/state/actas exists, such a record names the old state dir and would
# be refused (override) anyway, so the old dir is not searched.
PS_BINS = ("/bin/ps", "/usr/bin/ps")
PS_NATIVE = True
USER_STATE = Path(passwd_home() or HOME) / ".local" / "state"
USER_SESSIONS = legacy_dir(USER_STATE) / "sessions"


def ps_table():
    """{pid: (ppid, lstart, comm)} from one PS_READER call (on macOS only
    this process and its ancestors); {} on failure."""
    if "ps" not in _CACHE:
        table = {}
        try:
            text = PS_READER() or ""
        except Exception:        # a broken reader means "no ancestors", never a crash
            text = ""
        for line in text.splitlines():
            f = line.split(None, 7)          # pid ppid + 5 lstart tokens + comm (may hold spaces)
            if len(f) == 8 and f[0].isdigit() and f[1].isdigit():
                table[int(f[0])] = (int(f[1]), " ".join(f[2:7]), f[7].strip())
        _CACHE["ps"] = table
    return _CACHE["ps"]


def ancestors(table):
    out, pid = [], os.getppid()
    while pid in table and pid not in out and len(out) < 64:
        out.append(pid)
        pid = table[pid][0]
    return out


def detect_agent():
    """SPEC 8.2 -> (agent?, signals). ACTAS plus a non-tty is not a signal."""
    env, table = os.environ, ps_table()
    sig = [k for k in AGENT_MARKERS if env.get(k)] + sorted(k for k in env if k.startswith("CODEX_SANDBOX"))
    for pid in ancestors(table):
        comm = table[pid][2]
        name = "Claude.app" if "Claude.app/" in comm else os.path.basename(comm)
        if (name == "Claude.app" or name in ANCESTOR_AGENTS) and f"ancestor:{name}" not in sig:
            sig.append(f"ancestor:{name}")
    return bool(sig), sig


def session_record(table):
    """The nearest valid record: its pid is an ancestor and its start time
    still matches that pid's (a reused pid does not inherit a session). The
    fixed copies are searched first for every ancestor, so a record forged
    in a moved ACTAS_STATE does not beat them; STATE's only when none fits."""
    for d in dict.fromkeys((USER_SESSIONS, SESSIONS)):
        for pid in ancestors(table):
            try:
                rec = json.loads((d / f"{pid}.json").read_text())
            except (OSError, ValueError):
                continue
            if isinstance(rec, dict) and rec.get("pid") == pid and rec.get("start") == table[pid][1]:
                return rec
    return None


def who():
    if "who" not in _CACHE:
        agent, signals = detect_agent()
        _CACHE["who"] = {"agent": agent, "signals": signals, "record": session_record(ps_table())}
    return _CACHE["who"]


def session_of(cfg, w=None):
    """(profile, source) of this session: the record's, else $ACTAS's."""
    w = w or who()
    if w["record"]:
        name = w["record"].get("profile")
        return (name if name in cfg.profiles else None), "record"
    e = env_get("ACTAS")
    return (e, "env") if e and e in cfg.profiles else (None, None)


def profile_or_none(cfg, name):
    try:
        return merge_profile(name, cfg, check=False) if name in cfg.profiles else None
    except ManifestError:
        return None


def pid_alive(pid):
    """Whether pid names a live process (the table may hold only our
    ancestors). Another user's process counts as alive."""
    try:
        os.kill(pid, 0)
    except PermissionError:
        return True
    except (OSError, OverflowError, ValueError):
        return False
    return pid > 0


def write_record(prof, allowed=None):
    """STATE/sessions/<own pid>.json (and the same in USER_SESSIONS) just
    before exec: the pid survives exec, so the record belongs to the agent
    process. Dead pids are pruned. allowed: an agent's nested run keeps the
    outer session's reach (F9). Returns whether a record was written."""
    table, me, dirs = ps_table(), os.getpid(), list(dict.fromkeys((SESSIONS, USER_SESSIONS)))
    for f in [f for d in dirs if table and d.is_dir() for f in d.glob("*.json")]:
        if not f.stem.isdigit() or not pid_alive(int(f.stem)):
            with suppress(OSError):
                f.unlink()
    start = table.get(me, (0, None))[1]
    if not start:
        warn("no process table: no session record, so agents in this session cannot reach power profiles")
        return False
    rec = {"pid": me, "start": start, "profile": prof["name"], "level": prof["level"], "root": str(ROOT),
           "state": str(STATE), "created": time.strftime("%Y-%m-%dT%H:%M:%S%z")}
    if allowed is not None:
        rec["allowed"] = sorted(allowed)
    ensure_dir(SESSIONS, tighten=True)
    write_private(SESSIONS / f"{me}.json", json.dumps(rec) + "\n")
    if USER_SESSIONS != SESSIONS:
        with suppress(OSError):
            ensure_dir(USER_SESSIONS, tighten=True)
            write_private(USER_SESSIONS / f"{me}.json", json.dumps(rec) + "\n")
    return True


def audit(action, prof=None, decision="allowed", reason=None, from_profile=None, cmd=None, refs=()):
    """One JSON line in STATE/audit.jsonl (SPEC 8.5). Names, never values."""
    import hashlib
    w = who()
    rec = w["record"] or {}
    name, level = (prof["name"], prof["level"]) if isinstance(prof, dict) else (prof, None)
    try:
        cwd = tilde(os.getcwd())
    except OSError:
        cwd = None
    line = {"ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "action": action, "profile": name, "level": level,
            "from_profile": from_profile, "decision": decision, "reason": reason,
            "agent": {"detected": w["agent"], "signals": w["signals"],
                      "session": rec.get("profile") or env_get("ACTAS"), "record_pid": rec.get("pid")},
            "cmd0": redact_argv(cmd[:1])[0][0] if cmd else None,
            "argv_sha256": hashlib.sha256(json.dumps(list(cmd)).encode()).hexdigest() if cmd else None,
            "cwd": cwd, "refs": sorted(refs), "actas_version": __version__}
    try:
        ensure_dir(STATE, tighten=True)
        fd = os.open(str(STATE / "audit.jsonl"), os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
        with os.fdopen(fd, "a") as f:
            f.write(json.dumps(line) + "\n")
    except OSError as e:
        warn(f"could not write the audit log ({e})")


def clean_reason(text):
    return "".join(ch for ch in str(text) if ch.isprintable())[:200] if text else None


def redact_argv(argv, names=()):
    """-> (argv with credential values hidden, the placeholders used). A
    value of a credential variable in this environment (CRED_VARS, names, or
    a name that says so; 8+ characters) becomes <$NAME>, a token-shaped
    string <token>: an agent's shell may have expanded one into the argv."""
    names = set(names) | CRED_VARS
    vals = sorted(((v.strip(), k) for k, v in os.environ.items()
                   if (k in names or CRED_NAME_RE.search(k)) and not k.startswith(NEVER_OWNED_PREFIX)
                   and len(v.strip()) >= 8),
                  key=lambda x: (-len(x[0]), x[1]))
    shown, used = [], []

    def mark(ph):
        if ph not in used:
            used.append(ph)
        return ph
    for a in map(str, argv):
        for v, k in vals:
            if v in a:
                a = a.replace(v, mark(f"<${k}>"))
        shown.append(TOKEN_IN_RE.sub(lambda _m: mark("<token>"), a))
    return shown, used


def secret_names(cfg):
    """Every secret_env name the manifest defines (any profile's may be in
    the agent's environment)."""
    bodies = [cfg.defaults] + list(cfg.roles.values()) + list(cfg.profiles.values())
    return {k for b in bodies if isinstance(b, dict) for k in section(b, "secret_env")}


def ask_user(T, cmd, suggest, reason=None, human=False, names=()):
    """SPEC 8.4. The command comes from argv and is shown with shlex.join,
    so `;` or `|` inside an argument is quoted, never run. Credential values
    in it are hidden (redact_argv), with a line saying so."""
    raw, (cmd, hidden), suggest = cmd, redact_argv(cmd, names), redact_argv(suggest, names)[0]
    ids = [f"aws:{section(T, 'aws')['profile']}"] if section(T, "aws").get("profile") else []
    ids += [f"gh:{gh_label(T)}"] if gh_label(T) else []
    what = f"`{shlex.join(cmd)}` as actas profile {T['name']} ({T['level']}{'; ' + ', '.join(ids) if ids else ''})"
    if human:
        lines = [f"Running {what} needs a typed confirmation.", "Run it yourself in an interactive terminal:"]
    else:
        lines = [f"The agent wants to run {what}."]
        if clean_reason(reason):
            lines.append(f'Agent\'s reason: "{clean_reason(reason)}"')
        lines.append("If you agree, run it yourself in a separate terminal (not inside the agent session):")
    lines.append("  " + shlex.join(suggest))
    if hidden:
        lines.append(redacted_note(hidden, T["name"]))
    cmd = raw
    if cmd and (INTERPRETER_RE.match(os.path.basename(cmd[0])) or any(SHELL_META_RE.search(x) for x in cmd)
                or len(cmd) > 1 and RUNNER_RE.match(f"{os.path.basename(cmd[0])} {cmd[1]}")):
        lines.append("Warning: this runs a shell or interpreter; read the whole command before running it.")
    return "\n".join(lines)


def redacted_note(hidden, name=None):
    whose = f"profile {name}'s own value" if name else "the right value"
    return (f"Note: credential values are hidden as {', '.join(hidden)}, so this does not run as shown. "
            f"Put {whose} back in yourself (the agent's copy belongs to its own session), "
            "or have it read from the variable by name, e.g. sh -c '... \"$NAME\" ...'.")


def stop(reason, ask, profile=None, code="needs_user", current=None, requested=None, command=None,
         agent_reason=None, action="refusal", payload=True, raw_command=None):
    """A refusal: the `actas-stop:` line first on stderr, then prose and the
    ask_user text; the JSON payload on stdout with --json (SPEC 10.4).
    command: as shown (redacted); raw_command: what the audit hash covers."""
    if isinstance(profile, str):          # from argv: may be a pasted value
        profile = redact_argv([profile])[0][0]
    name = profile["name"] if isinstance(profile, dict) else profile
    print(f"actas-stop: code={code} reason={reason} profile={name or '-'}", file=sys.stderr)
    release()
    print(f"{paint('actas:', 'red', sys.stderr)} refused: {REASONS[reason].format(p=name or 'this profile')}",
          file=sys.stderr)
    print("actas: show the user this ask_user text exactly, then stop:\n" + ask, file=sys.stderr)
    cur = current or {"profile": None, "level": None, "source": None}
    audit(action, profile, "refused-needs-user", reason=reason, from_profile=cur["profile"],
          cmd=command if raw_command is None else raw_command)
    if payload and _MODE["json"]:
        print(json.dumps({"ok": False, "code": code, "reason": reason, "current": cur, "requested": requested,
                          "command": command, "agent_reason": clean_reason(agent_reason), "ask_user": ask,
                          "warnings": WARNINGS}, indent=2))
    sys.exit(4 if code == "expired" else 3)


def gate(cfg, T, action, cmd, suggest, reason=None):
    """SPEC 8.3: may this caller `action` (run/exec) cmd as profile T? ->
    {decision, from, allowed (an agent's reach; None for humans)}. Refusals
    exit 3, a declined confirmation 1; the agent branch never prompts."""
    w, L = who(), (lambda p: LEVELS[p["level"]])
    s_name, source = session_of(cfg, w) if w["agent"] else (
        (env_get("ACTAS"), "env") if env_get("ACTAS") in cfg.profiles else (None, None))
    if w["agent"] and not ps_table():
        s_name = source = None       # no process table: a hidden record cannot be told apart (F8)
    S = profile_or_none(cfg, s_name)

    def refuse(r, human=False):
        names = secret_names(cfg)
        ask = ask_user(T, cmd, suggest, reason, human, names)
        if r == "not_allowed" and L(T) <= L(S) and not (not R and T["level"] == "power"):
            ask += "\n" + allow_hint(S, T, frozen=bool(R and isinstance(R.get("allowed"), list)))
        stop(r, ask, T,
             current={"profile": S and S["name"], "level": S and S["level"], "source": source if S else None},
             requested={"profile": T["name"], "level": T["level"], "confirm": T["confirm"]},
             command=redact_argv(cmd, names)[0], raw_command=list(cmd), agent_reason=reason, action=action)

    allowed, R = None, w["record"]
    if w["agent"]:
        if T["confirm"]:
            refuse("confirm")
        if R and (R.get("root") != str(ROOT) or R.get("state") != str(STATE)):
            refuse("override")
        # No record: ACTAS_ROOT/ACTAS_STATE may only name the default places,
        # and an agent `actas run` started (ACTAS_SESSION) must still find its
        # record, whatever XDG_STATE_HOME or HOME now say (F8, F27). The
        # legacy CCENV_ names count exactly the same.
        moved = any(os.environ.get(n) and Path(os.environ[n]) != d
                    for k, d in (("ACTAS_ROOT", DEFAULT_ROOT), ("ACTAS_STATE", DEFAULT_STATE))
                    for n in (k, legacy_name(k)))
        if not R and (moved or env_any("ACTAS_SESSION")):
            refuse("override")
        if S is None:
            # Only the readonly profile of the process's own directory (D-C).
            try:
                here = profile_or_none(cfg, locate(cfg)[0])
            except OSError:          # the working directory is gone
                here = None
            allowed = [here["name"]] if here and here["level"] == "readonly" else []
            if T["name"] not in allowed:
                refuse("no_session")
        else:
            allowed = R.get("allowed") if R and isinstance(R.get("allowed"), list) else (
                [S["name"]] + list(S["agents_may_use"]))
            if T["name"] not in allowed and ANY not in allowed:
                refuse("not_allowed")
            if L(T) > L(S):
                refuse("elevation")
            if not R and T["level"] == "power":
                refuse("unanchored")
        decision = "allowed"
    elif T["confirm"] or (S and L(T) > L(S)):
        release()
        frm = f"{S['name']} ({S['level']})" if S else "this shell"
        typed = CONFIRM_FN(f"Elevate {frm} -> {T['name']} ({T['level']}) to run: "
                           f"{shlex.join(cmd) or 'claude'}.\nType the profile name to continue: ")
        if typed is None:
            refuse("no_tty", human=True)
        if typed != T["name"]:
            audit(action, T, "refused-confirm", from_profile=S and S["name"], cmd=cmd)
            die("not confirmed")
        decision = "confirmed-tty"
    else:
        decision = "allowed"
    release()
    return {"decision": decision, "from": S and S["name"], "allowed": allowed}


def allow_hint(S, T, frozen=False):
    """The not_allowed refusal also tells the user (not the agent) how to allow
    such hops for good: where the session profile's list comes from."""
    where = MANIFEST if MANIFEST.exists() else "the manifest"
    sect = "environments" if S.get("_v1") else "profiles"
    add = f'add {T["name"]} (or "*" for every profile at the same or a lower level) to agents_may_use'
    if frozen:
        return ("For the user, not the agent: this nested agent session keeps the agents_may_use list of "
                f"the session that started it. To allow such hops, {add} in {where}, then start a new session.")
    if S.get("_v1"):         # translated: own and default lists look the same
        place = (f"of {sect}.{S['name']}, or in defaults (an environment's own agents_may_use "
                 "replaces the defaults one)")
    elif S.get("_own_amu"):
        place = f"of {sect}.{S['name']} (its own list; defaults.agents_may_use does not apply to it)"
    else:
        place = (f"in defaults (applies to every profile without its own list), or give {sect}.{S['name']} "
                 "its own list (it then replaces the defaults one)")
    return f"For the user, not the agent: to let agents in {S['name']} sessions do this, {add} {place}, in {where}."


def require_human(what, profile=None, argv=None):
    """Human-only commands (SPEC 8.3) stop with exit 3 in agent context.
    argv: what to show in ask_user when the real argv could hold a value."""
    if not who()["agent"]:
        return
    argv = ["actas"] + list(argv if argv is not None else _MODE["argv"] or [what])
    shown, hidden = redact_argv(argv)
    stop("human_only", "In your own terminal (not inside the agent session), run: " + shlex.join(shown)
         + ("\n" + redacted_note(hidden) if hidden else ""),
         profile, command=shown, raw_command=argv, action=what)


def surface(w):
    if any(s == "ancestor:Claude.app" for s in w["signals"]):
        return "desktop"
    return "terminal" if os.environ.get("TERM", "dumb") != "dumb" else "unknown"


# ======================================================================== aws

def aws_sso_argv(v):
    """The one AWS SSO login for an aws block (F40): per sso_session, or per profile."""
    return ["sso", "login"] + (["--sso-session", v["sso_session"]] if v.get("sso_session")
                               else ["--profile", v["profile"]])


def aws_login(v, env=None):
    aws = find_bin("aws") or die("aws not found (install the AWS CLI v2)")
    info(f"aws: aws {' '.join(aws_sso_argv(v))}")
    return run([aws] + aws_sso_argv(v), capture_output=False, env=env).returncode == 0


def aws_sections(path=None):
    """~/.aws/config (or $AWS_CONFIG_FILE, or path) as a list of {"_name": ..., key: value}."""
    cfg = Path(path or os.environ.get("AWS_CONFIG_FILE") or HOME / ".aws" / "config")
    try:
        lines = cfg.read_text().splitlines()
    except OSError:
        return []
    sections, cur = [], None
    for line in lines:
        line = line.strip()
        if line.startswith("[") and line.endswith("]"):
            cur = {"_name": line[1:-1].strip()}
            sections.append(cur)
        elif cur is not None and "=" in line and not line.startswith(("#", ";")):
            k, _, v = line.partition("=")
            cur[k.strip()] = v.strip()
    return sections


def aws_portals():
    """Map each SSO login (an `[sso-session X]`, else a start URL) to the
    profiles that use it, so one browser round-trip covers them all (D15)."""
    portals = {}
    for sec in aws_sections():
        name = sec["_name"]
        if name.startswith("sso-session"):
            continue
        name = name[len("profile "):].strip() if name.startswith("profile ") else name
        key = f"sso-session {sec['sso_session']}" if sec.get("sso_session") else sec.get("sso_start_url")
        if key:
            portals.setdefault(key, []).append(name)
    return portals


def aws_profile_names(path):
    """The profile names an AWS config or credentials file defines. Reads
    section headers only, never values."""
    try:
        lines = Path(path).read_text().splitlines()
    except (OSError, UnicodeDecodeError):
        return set()
    names = set()
    for line in lines:
        line = line.strip()
        if line.startswith("[") and line.endswith("]"):
            n = line[1:-1].strip()
            if not n.startswith(("sso-session ", "services ")):
                names.add(n[len("profile "):].strip() if n.startswith("profile ") else n)
    return names


def gh_logins(env=None):
    """The (host, account) pairs `gh auth status` lists, or None without gh."""
    gh = find_bin("gh")
    if not gh:
        return None
    r = run([gh, "auth", "status"], stdin=subprocess.DEVNULL, timeout=30, env=env)
    return list(dict.fromkeys(m.groups() for m in
                              re.finditer(r"Logged in to (\S+) account (\S+)", r.stdout + r.stderr)))


def gh_accounts(args=(), env=None):
    """The accounts `gh auth status [args]` lists, or None without gh."""
    gh = find_bin("gh")
    if not gh:
        return None
    r = run([gh, "auth", "status"] + list(args), stdin=subprocess.DEVNULL, timeout=30, env=env)
    return list(dict.fromkeys(line.split("account")[-1].strip().split()[0] for line in
                              (r.stdout + r.stderr).splitlines() if "Logged in to" in line and "account" in line))


# =========================================================== describing profiles

def gh_label(prof):
    g = section(prof, "github")
    auth = g.get("auth") or ""
    if auth.startswith("gh:"):
        return auth[3:]
    if auth:
        return "pat"
    return "home" if g.get("home") else None


def provider_of(prof):
    """claude.provider, or for a subscription profile the provider a truthy
    CLAUDE_CODE_USE_* in env selects (the Foundry recipe): "foundry" etc. (F38)."""
    p = section(prof, "claude").get("provider") or "subscription"
    env = section(prof, "env") if p == "subscription" else {}
    on = [v for v in CLAUDE_USE if str(env.get(v) or "").lower() not in ("", "0", "false")]
    return on[0][len("CLAUDE_CODE_USE_"):].lower().replace("_", "-") if on else p


def ref_json(ref):
    return {"ref": ref, "present": None} if ref else None


def identities(prof):
    """Who this profile is, per module/tool. Refs are names, never values."""
    nulled = {p[0] for p in prof["_nulled"] if len(p) == 1}
    c = section(prof, "claude")
    ids = {"claude": {"provider": provider_of(prof),
                      "base_url": c.get("base_url"), "home": c.get("home")}}
    if c.get("token"):
        ids["claude"]["token"] = ref_json(c["token"])
    for mod in ("aws", "github", "git", "gcp", "azure"):
        v = prof.get(mod)
        if v == "inherit":
            ids[mod] = {"mode": "inherit"}
        elif v is None:
            if mod in nulled:
                ids[mod] = {"mode": "off"}
        elif mod == "aws":
            ids[mod] = {"profile": v.get("profile"), "region": v.get("region")}
        elif mod == "github":
            auth = v.get("auth") or ""
            if auth.startswith("gh:"):
                ids[mod] = {"auth": "gh", "account": REF_RES["gh"].match(auth).group(1),
                            "host": gh_host(v)}
            elif auth:
                ids[mod] = {"auth": "ref", "ref": ref_json(auth), "host": gh_host(v)}
            elif v.get("home"):
                ids[mod] = {"auth": "home", "home": v["home"], "host": gh_host(v)}
        elif mod == "git":
            ids[mod] = {"name": v.get("name"), "email": v.get("email")}
        else:
            ids[mod] = dict(v)
    for tool in ("codex", "gemini"):
        if isinstance(prof.get(tool), dict):
            ids[tool] = {k: (ref_json(x) if k == "api_key" else x) for k, x in prof[tool].items()}
    return ids


def describe(mod, v):
    if v.get("mode"):
        return v["mode"]
    if mod == "claude":
        return " ".join(x for x in (v["provider"], v.get("base_url"),
                                    v.get("home") and f"home:{v['home']}") if x)
    if mod == "aws":
        return " ".join(x for x in (v.get("profile"), v.get("region")) if x) or "-"
    if mod == "github":
        if v["auth"] == "gh":
            return f"gh:{v['account']}" + ("" if v["host"] == "github.com" else f"@{v['host']}")
        if v["auth"] == "ref":
            return f"token {v['ref']['ref']}"
        return f"home {v['home']}"
    if mod == "git":
        return f"{v.get('name') or '?'} <{v.get('email') or '?'}>"
    return " ".join(f"{k}={x['ref'] if isinstance(x, dict) and 'ref' in x else show(x)}"
                    for k, x in sorted(v.items()) if x not in (None, "", {}, [])) or "-"


def show(v):
    return v if isinstance(v, str) else json.dumps(v)


# ================================================================== commands

def exec_cmd(cmd, env, hint=""):
    release()
    try:
        os.execvpe(cmd[0], cmd, env)
    except FileNotFoundError:
        die(f"{cmd[0]} not found on PATH{hint}")
    except OSError as e:
        die(f"cannot start {cmd[0]}: {e}")


def cmd_run(a):
    """resolve -> gate -> --login -> probe the target's AWS profile (warn
    only) -> build the env -> settings, context, session record -> badge ->
    audit -> exec the tool (SPEC 6.1)."""
    cfg = load()
    prof = resolve(default_target(cfg, a), a.cwd, cfg)
    name, tool = prof["name"], a.tool or prof.get("tool") or "claude"
    suggest = (["actas", "run", name] + (["-t", a.tool] if a.tool else [])
               + (["--"] + a.args if a.args else []))
    g = gate(cfg, prof, "run", [tool] + a.args, suggest)
    profile = section(prof, "aws").get("profile")
    # Never log in unless asked to with --login; otherwise only probe the
    # target profile (D14) and start anyway. Both see the profile's AWS env.
    # The plain probe runs in a background thread while secrets resolve
    # (daemon: a die() while resolving does not wait for aws); --login stays
    # serial because it is interactive.
    probe = None
    if profile and (a.login or not a.no_check):
        aws_env = child_env(assemble(prof, want_secrets=False))
        if a.login:
            if probe_aws(profile, aws_env)["status"] != "ok" and (
                    not aws_login(section(prof, "aws"), aws_env) or probe_aws(profile, aws_env)["status"] != "ok"):
                die(f"AWS SSO login failed for profile {profile}")
        else:
            import threading
            box = {}
            probe = threading.Thread(target=lambda: box.update(st=probe_aws(profile, aws_env)["status"]),
                                     daemon=True)
            probe.start()
    res = assemble(prof, ctx={"agent": True, "tool": tool, "materialize": True})
    if probe:
        probe.join()
        if box.get("st") == "expired":
            warn(f"AWS credentials for {profile} have expired; starting anyway (run: actas login {name})")
    env = child_env(res)
    args = list(section(prof, tool).get("args") or []) + a.args
    if tool == "claude":
        cmd = ["claude", "--settings", str(write_settings_file(name, settings_for(prof, res)))] + args
        write_context(cfg, prof)
        here = expand(a.cwd or os.getcwd())
        synced = ledger_entry_for(here)
        if synced and synced[1].get("profile") != name:
            other = synced[1].get("profile")
            if locate(cfg, os.path.dirname(os.path.dirname(synced[0])))[0] != other:
                warn(f"{synced[0]} is synced to {other}, which no longer resolves there; run actas sync")
            else:     # a nested profile (D6) is information; another profile here is a warning
                (info if locate(cfg, here)[0] == name else warn)(
                    f"this repo is synced to {other}: Claude also reads {tilde(synced[0])}, so keys "
                    f"{name} does not set come from {other}")
        if synced and missing_helpers(synced[1]):
            info(f"helper path in {synced[0]} no longer exists; run actas sync")
    elif tool == "gemini":
        cmd = ["gemini", "--approval-mode", GEMINI_MODE[prof["level"]]] + args
    else:
        cmd = [tool] + args
    if write_record(prof, g["allowed"]):
        env["ACTAS_SESSION"] = str(os.getpid())  # exec keeps the pid; process env only
        env.pop("CCENV_SESSION", None)           # legacy: an outer ccenv run's marker
    else:
        env.pop("ACTAS_SESSION", None)
        env.pop("CCENV_SESSION", None)           # legacy
    if res["scrubbed"]:
        info(paint(f"cleared from your shell: {', '.join(res['scrubbed'])}", "dim", sys.stderr))
    badge = [paint(name, "cyan", sys.stderr), prof["level"], provider_of(prof) if tool == "claude" else tool]
    badge += [f"aws:{profile}"] if profile else []
    badge += [f"gh:{gh_label(prof)}"] if gh_label(prof) else []
    info(" · ".join(badge))
    audit("run", prof, g["decision"], from_profile=g["from"], cmd=cmd, refs=res["refs"])
    exec_cmd(cmd, env, "; install it or use actas exec")


def cmd_exec(a):
    """Run any command with a profile's identity (no settings file)."""
    if not a.args:
        die("usage: actas exec [profile] [--reason TEXT] -- command [args...]", 2)
    cfg = load()
    prof = resolve(default_target(cfg, a), a.cwd, cfg)
    g = gate(cfg, prof, "exec", a.args, ["actas", "exec", prof["name"], "--"] + a.args, a.reason)
    res = assemble(prof, ctx={"agent": who()["agent"], "materialize": True})
    audit("exec", prof, g["decision"], from_profile=g["from"], cmd=a.args, refs=res["refs"])
    env, tool = child_env(res), os.path.basename(a.args[0])
    if tool in ANCESTOR_AGENTS and not env_any("ACTAS_AGENT", env):
        env["ACTAS_AGENT"] = tool    # macOS shows python/node for interpreted agent CLIs (F11)
    exec_cmd(a.args, env)


def default_target(cfg, a):
    """An agent's default profile is its session's, never the cwd's (SPEC
    8.3); an explicit name or --cwd always chooses (D-B)."""
    if a.env or a.cwd or not who()["agent"]:
        return a.env
    return session_of(cfg)[0]


def cmd_shell(a):
    """Print the profile's environment for eval, fish, direnv, JSON or a
    GUI app's env setting (SPEC 5.3)."""
    fmt = a.format
    no_secrets = a.no_secrets or fmt in ("json", "env")
    if not no_secrets:
        require_human("shell", a.env)
    prof = resolve(a.env, a.cwd)
    human = a.no_secrets and fmt not in ("json", "env") and not who()["agent"]
    res = assemble(prof, want_secrets=not no_secrets, git_base=0 if fmt == "env" else None,
                   ctx={"materialize": True, "human_shell": human})
    env, gone = res["env"], res["unset"]
    if fmt == "env" and env.get("ANTHROPIC_BASE_URL"):
        info(f"ANTHROPIC_BASE_URL comes without a credential here: Claude gets the gateway token "
             f"only through apiKeyHelper (actas run, or actas sync for a repo), or in Desktop "
             f"through `actas desktop {prof['name']} --print-3p`")
    if fmt == "json":
        print(json.dumps({"ok": True, "warnings": WARNINGS, "set": env, "unset": gone}, indent=2))
    elif fmt == "env":
        for k, v in env.items():
            if "\n" in v:
                warn(f"{k} spans several lines; left out of KEY=value output")
            else:
                print(f"{k}={v}")
    elif fmt == "fish":
        for k, v in env.items():
            print(f"set -gx {k} {fish_quote(v)}")
        for k in gone:
            print(f"set -e {k}")
    else:
        for k, v in env.items():
            print(f"export {k}={shell_quote(v)}")
        if gone:
            print("unset " + " ".join(gone))


def list_row(name, prof):
    provider = provider_of(prof)
    return {"name": name, "description": prof.get("description"), "match": prof["match"],
            "level": prof["level"], "confirm": prof["confirm"], "tool": prof.get("tool") or "claude",
            "provider": provider, "aws": section(prof, "aws").get("profile"),
            "github": gh_label(prof), "remote_control": provider == "subscription"}


def cmd_list(a):
    cfg = load()
    if a.names:                      # for scripts and shell completion: nothing merged or probed
        for name in sorted(cfg.profiles):
            print(name)
        return
    rows, (profs, errors) = [], all_profiles(cfg, names=sorted(cfg.profiles))
    for name, e in errors.items():
        warn(f"profile {name}: {e}")
    checked = {}
    if a.check:      # each distinct (AWS profile, config file) once, 6 at a time (SPEC 4.2)
        from concurrent.futures import ThreadPoolExecutor
        jobs = {}
        for name, p in profs.items():
            if section(p, "aws").get("profile"):
                env = child_env(assemble(p, want_secrets=False))   # the profile's own AWS_CONFIG_FILE
                jobs[name] = ((section(p, "aws")["profile"], env.get("AWS_CONFIG_FILE")), env)
        envs = {k: env for k, env in jobs.values()}
        with ThreadPoolExecutor(max_workers=6) as pool:
            found = dict(zip(envs, pool.map(lambda k: probe_aws(k[0], envs[k])["status"], envs)))
        checked = {n: found[k] for n, (k, _) in jobs.items()}
    secret_ok = {}       # a token shared by several profiles is read once (one op/keychain prompt)
    for name, prof in profs.items():
        row = list_row(name, prof)
        if a.check:
            row["check"] = {"aws": checked.get(name)}
            tok = section(prof, "claude").get("token")
            if row["provider"] == "gateway" and tok:
                if tok not in secret_ok:
                    secret_ok[tok] = bool(read_ref(tok, batch=True)[0])
                row["check"]["secret"] = "ok" if secret_ok[tok] else "missing"
        rows.append(row)
    if a.json:
        roles = [{"name": n, "description": b.get("description"), "use": as_list(b.get("use")),
                  "level": b.get("level"), "confirm": bool(b.get("confirm"))}
                 for n, b in sorted(cfg.roles.items())]
        print(json.dumps({"ok": True, "warnings": WARNINGS, "profiles": rows, "roles": roles},
                         indent=2))
        return
    if not rows:
        print("no profiles defined")
        return
    try:
        here = locate(cfg, a.cwd)[0]
    except OSError:                  # a deleted working directory
        here = None
    session = session_of(cfg)[0]
    for r in rows:
        remote = "yes" if r["remote_control"] else paint(f"no ({r['provider']})", "dim")
        mark = ("*" if r["name"] == here else "") + ("+" if r["name"] == session else "")
        line = (f"{paint(format(r['name'] + (' ' + mark if mark else ''), '<20'), 'bold')} "
                f"provider={r['provider']:<13} "
                f"aws={r['aws'] or '-':<22} gh={r['github'] or '-':<22} remote={remote}")
        if cfg.version == 2:
            line += f" level={r['level']}" + (" confirm" if r["confirm"] else "")
        if a.check:
            ck = r["check"]
            mark = {"ok": paint("ok", "green"), "expired": paint("expired", "red")}.get(ck["aws"], ck["aws"] or "-")
            line += f" awsauth={mark}"
            if "secret" in ck:
                line += f" secret={paint(ck['secret'], 'green' if ck['secret'] == 'ok' else 'red')}"
        print(line)
    legend = [x for x, on in (("* this directory", here in profs), ("+ this session", session in profs)) if on]
    if legend:
        print(paint(", ".join(legend), "dim"))
    if cfg.roles:
        print(f"roles: {', '.join(sorted(cfg.roles))}")


def cmd_status(a):
    cfg = load()
    cwd_name, how, pat, path = locate(cfg, a.cwd)
    w = who()
    sess, source = session_of(cfg, w)
    if a.env:
        target, chosen = a.env, "name"
    elif sess and not a.cwd:             # an explicit --cwd chooses (D-B)
        target, chosen = sess, "session"
    elif cwd_name:
        target, chosen = cwd_name, how
    elif a.why or a.probe:               # they need a profile
        no_match(cfg, path)
    else:
        return status_none(cfg, path, w, sess, source, a.json)
    prof = resolve(target, cfg=cfg)
    off_aside(move=False)            # status never mutates; it only warns (F2)
    d = {"ok": True, "warnings": WARNINGS,
         "session": {"profile": sess, "source": source,
                     "record_pid": w["record"]["pid"] if w["record"] else None},
         "cwd": {"path": tilde(path), "profile": cwd_name, "matched_by": how,
                 "pattern": pat},
         "mismatch": bool(cwd_name and how != "fallback" and cwd_name != prof["name"]),
         "profile": prof["name"], "matched_by": chosen, "level": prof["level"],
         "confirm": prof["confirm"], "tool": prof.get("tool") or "claude",
         "agents_may_use": prof["agents_may_use"], "identities": identities(prof),
         "agent": {"detected": w["agent"], "signals": w["signals"]}, "surface": surface(w)}
    expired = probe_all(prof, d["identities"]) if a.probe else []
    if a.why:
        res = assemble(prof, want_secrets=False)
        d["chain"] = prof["_chain"]
        d["keys"] = {".".join(p): {"value": r["value"], "from": r["from"], "was": r["was"]}
                     for p, r in sorted(prof["_prov"].items())}
        d["env"] = {"set": sorted(res["env"]), "secret": res["secret"], "scrub": res["scrub"],
                    "clears": [k for k in res["unset"] if k not in res["secret"]]}
        d["notes"] = res["notes"]
        d["agent_policy"] = agent_policy(prof)
    if a.json:
        print(json.dumps(d, indent=2))
        return status_expired(prof, expired)
    row = lambda label, text: print(f"{paint(format(label, '<9'), 'bold')} {text}")  # noqa: E731
    row("profile", f"{d['profile']}  ({d['level']}{', confirm' if d['confirm'] else ''}; "
                   f"by {chosen})" + (f"  {prof['description']}" if prof.get("description") else ""))
    where = f"{d['cwd']['path']} -> {cwd_name or '(no match)'}"
    if how:
        where += f"  ({how}{' ' + tilde(pat) if pat else ''})"
    row("cwd", where)
    if d["mismatch"]:
        row("", paint(f"this directory belongs to {cwd_name}, not {prof['name']}", "yellow"))
    elif how == "fallback" and cwd_name != prof["name"]:
        row("", f"this directory matches no profile (fallback: {cwd_name})")
    if sess:
        row("session", f"{sess} ({source}" + (f" pid {w['record']['pid']})" if w["record"] else ")")
            + ("" if sess == prof["name"] else f"; the report above is for {prof['name']}, not the session"))
    if w["agent"]:
        row("agent", ", ".join(w["signals"]))
    if d["tool"] != "claude":
        row("tool", d["tool"])
    for mod, v in d["identities"].items():
        pr = v.get("probe") if isinstance(v, dict) else None
        row(mod, describe(mod, v) + (f"  [{pr['status']}{' ' + pr['account'] if pr.get('account') else ''}]"
                                     if pr else ""))
    if a.why:
        row("chain", " -> ".join(d["chain"]))
        for k, r in d["keys"].items():
            was = r["was"]
            tail = f", was {show(was['value'])} from {was['from']}" if was else ""
            print(f"          {k} = {show(r['value'])} (from {r['from']}{tail})")
        for k in ("set", "secret", "scrub", "clears"):
            row(f"env.{k}", ", ".join(d["env"][k]) or "-")
        for n in d["notes"]:
            row("note", n)
        pol = d["agent_policy"]
        row("rules", f"{len(pol['deny'])} deny, {len(pol['ask'])} ask"
                     + ("" if pol["builtin"] else " (built-in preset off)") + f"; gemini {pol['gemini']}")
    status_expired(prof, expired)


def status_none(cfg, path, w, sess, source, as_json):
    """status where no profile applies (no name, no session, no match, no
    fallback): report that, with the hint, and exit 0 - it is an answer."""
    off_aside(move=False)
    hint = no_match_text(cfg, path)
    d = {"ok": True, "warnings": WARNINGS,
         "session": {"profile": sess, "source": source,
                     "record_pid": w["record"]["pid"] if w["record"] else None},
         "cwd": {"path": tilde(path), "profile": None, "matched_by": None, "pattern": None},
         "mismatch": False, "profile": None, "matched_by": None, "level": None,
         "confirm": None, "tool": None, "agents_may_use": [], "identities": {},
         "agent": {"detected": w["agent"], "signals": w["signals"]}, "surface": surface(w),
         "hint": hint}
    if as_json:
        print(json.dumps(d, indent=2))
        return
    row = lambda label, text: print(f"{paint(format(label, '<9'), 'bold')} {text}")  # noqa: E731
    row("profile", "(none): no profile applies here")
    row("cwd", f"{d['cwd']['path']} -> (no match)")
    row("", hint)
    if sess:
        row("session", f"{sess} ({source}" + (f" pid {w['record']['pid']})" if w["record"] else ")"))
    if w["agent"]:
        row("agent", ", ".join(w["signals"]))


def status_expired(prof, expired):
    if expired:
        stop("login", "In your own terminal (not inside the agent session), run: "
             + shlex.join(["actas", "login", prof["name"]] + [x for m in expired if m != "aws"
                                                              for x in ("--module", m)]),
             prof, code="expired", action="status", payload=False)


def probe_aws(profile, env):
    aws = find_bin("aws")
    if not aws:
        return {"status": "unknown", "detail": "aws not installed"}
    r = run([aws, "sts", "get-caller-identity", "--profile", profile, "--output", "json",
             "--cli-connect-timeout", "3", "--cli-read-timeout", "5"], timeout=8,
            stdin=subprocess.DEVNULL, env=dict(env, AWS_PAGER=""))
    if r.returncode == 0:
        try:
            j = json.loads(r.stdout)
            return {"status": "ok", "account": j.get("Account"), "arn": j.get("Arn")}
        except (ValueError, AttributeError):
            return {"status": "unknown"}
    if EXPIRED_RE.search(r.stderr or ""):
        return {"status": "expired"}
    return {"status": "missing" if "could not be found" in (r.stderr or "") else "unknown"}


def probe_rc(argv, env, quiet=True):
    """(status, stdout) of a probe command: exit code decides, 8 s timeout."""
    exe = find_bin(argv[0])
    if not exe:
        return "unknown", None
    kw = {"capture_output": False, "stdout": subprocess.DEVNULL, "stderr": subprocess.DEVNULL} if quiet else {}
    r = run([exe] + argv[1:], timeout=8, stdin=subprocess.DEVNULL, env=env, **kw)
    if getattr(r, "timed_out", False):
        return "unknown", None
    return ("ok" if r.returncode == 0 else "expired"), (r.stdout if not quiet else None)


def probe_github(g, env):
    host = gh_host(g)
    if g.get("home"):
        return {"status": probe_rc(["gh", "auth", "status", "--hostname", host], env)[0]}
    tok, _, _ = read_ref(g["auth"])
    if tok is None:
        return {"status": "missing"}
    e = dict(env, **{gh_token_vars(host)[0]: tok})     # --hostname picks the host
    st, out = probe_rc(["gh", "api", "user", "--hostname", host, "--jq", ".login"], e, quiet=False)
    m = REF_RES["gh"].match(g["auth"])
    login = (out or "").strip() or None
    if st == "ok" and m and login != m.group(1):
        return {"status": "mismatch", "login": login}
    return {"status": st, "login": login} if st == "ok" else {"status": st}


def in_parallel(jobs):
    """{name: fn()} for {name: fn}, each fn in its own thread (the probes
    wait on network round trips). An exception is re-raised here, in the
    main thread, as if the calls had run one after another."""
    import threading
    res, errs = {}, {}

    def work(k, fn):
        try:
            res[k] = fn()
        except BaseException as e:          # die() raises SystemExit
            errs[k] = e
    threads = [threading.Thread(target=work, args=kv, daemon=True) for kv in jobs.items()]
    for t in threads:
        t.start()
    for t in threads:
        t.join()
    for k in jobs:
        if k in errs:
            raise errs[k]
    return res


def probe_all(prof, ids):
    """status --probe (SPEC 4): one probe per active module, with the
    profile's env; adds identities.<m>.probe. Returns the expired modules."""
    env = child_env(assemble(prof, want_secrets=False))
    a, g, z = section(prof, "aws"), section(prof, "github"), section(prof, "azure")
    jobs = {}                   # independent and non-interactive: run side by side
    if a.get("profile"):
        jobs["aws"] = lambda: probe_aws(a["profile"], env)
    if isinstance(prof.get("gcp"), dict):
        jobs["gcp"] = lambda: {"status": probe_rc(["gcloud", "auth", "print-access-token", "--quiet"], env)[0]}
    if isinstance(prof.get("azure"), dict):
        jobs["azure"] = lambda: probe_rc(["az", "account", "show", "--query",
                                          "{id:id,tenant:tenantId,user:user.name}",
                                          "-o", "json", "--only-show-errors"], env, quiet=False)
    if g.get("auth") or g.get("home"):
        jobs["github"] = lambda: probe_github(g, env)
    res = in_parallel(jobs)
    for m in ("aws", "gcp"):
        if m in res:
            ids[m]["probe"] = res[m]
    if "azure" in res:
        st, out = res["azure"]
        pr = {"status": st}
        with suppress(ValueError):
            pr.update(json.loads(out) if st == "ok" else {})
        if st == "ok" and z.get("subscription") and pr.get("id") != z["subscription"]:
            warn(f"az is on subscription {pr.get('id')}, not {z['subscription']}")
        ids["azure"]["probe"] = pr
    if "github" in res:
        ids["github"]["probe"] = res["github"]
    return [m for m, v in ids.items() if isinstance(v, dict) and (v.get("probe") or {}).get("status") == "expired"]


def login_steps(mod, v, prof, a):
    """argv lists (without the binary) for one module's login (SPEC 4)."""
    if mod == "aws":
        if not v.get("profile"):
            die(f"profile {prof['name']!r} has no aws.profile")
        return [aws_sso_argv(v)]
    if mod == "gcp":
        return [["auth", "login"]] + ([["auth", "application-default", "login"]] if a.adc else [])
    if mod == "azure":
        steps = [["login"] + (["--tenant", v["tenant"]] if v.get("tenant") else [])]
        if v.get("subscription") and v.get("home"):
            steps.append(["account", "set", "--subscription", v["subscription"]])
        elif v.get("subscription"):
            info("azure has no home: not running `az account set` (it would change ~/.azure)")
        return steps
    if mod == "github":
        if v.get("auth") and not v["auth"].startswith("gh:"):
            info(f"github uses a token: create a fine-grained PAT (Contents, Metadata, Pull requests: "
                 f"read for readonly), then run: actas secret set {v['auth']}")
            return []
        return [["auth", "login", "--hostname", gh_host(v), "--web"]]
    return [["login", "--with-api-key"] if v.get("login") == "api" else ["login"]]


def cmd_login(a):
    require_human("login", a.env)
    cfg = load()
    release()
    if a.all:
        audit("login", None, reason="all")
        # Only portals backing a profile some environment uses - not every
        # profile that happens to be in ~/.aws/config.
        used = {section(p, "aws").get("profile") for p in all_profiles(cfg)[0].values()} - {None}
        portals = {url: [pr for pr in profiles if pr in used] for url, profiles in aws_portals().items()}
        portals = {url: profiles for url, profiles in portals.items() if profiles}
        if not portals:
            die("no profile uses an SSO profile from ~/.aws/config")
        info(f"{len(portals)} SSO portals for profiles: {', '.join(sorted(used))}")
        failed = []
        for url, profiles in portals.items():
            n = f"({len(profiles)} profiles)"
            if probe_aws(profiles[0], dict(os.environ))["status"] == "ok":
                print(f"{paint('ok', 'green')}      {url}  {n}")
                continue
            print(f"{paint('login', 'yellow')}   {url}  {n}")
            # Like the single-profile login: a failed step or a still-expired probe failed.
            if (not aws_login({"profile": profiles[0]})
                    or probe_aws(profiles[0], dict(os.environ))["status"] in ("expired", "missing")):
                print(f"{paint('failed', 'red')}  {url}  {n}")
                failed.append(url)
        if failed:      # a human ran this (require_human): a plain error, not an agent stop
            die(f"{len(failed)} of {len(portals)} SSO logins did not take: {', '.join(failed)} "
                "(check the SSO session in your browser, then run: actas login --all)")
        return
    prof = resolve(a.env, a.cwd, cfg)
    audit("login", prof)
    mods = a.module or ((["aws"] if section(prof, "aws").get("profile") else [])
                        + (["codex"] if prof.get("tool") == "codex" or prof.get("codex") else []))
    if not mods:
        die(f"nothing to log in to for {prof['name']!r}; pick one with --module "
            "aws|gcp|azure|github|codex")
    env = child_env(assemble(prof, want_secrets=False, ctx={"materialize": True}))
    for mod in mods:
        v, stdin = section(prof, mod), None
        if mod in ("gcp", "azure", "github") and not isinstance(prof.get(mod), dict):
            die(f"profile {prof['name']!r} has no {mod} block")
        exe = find_bin(LOGIN_BINS[mod]) or die(f"{LOGIN_BINS[mod]} not found (needed to log in to {mod})")
        gh_m = REF_RES["gh"].match(v.get("auth") or "") if mod == "github" else None
        e, gh_acct, active = dict(env), gh_m and gh_m.group(1), None
        if gh_acct:
            e.pop("GH_CONFIG_DIR", None)     # gh: accounts live in gh's own config
            # gh makes the new account the active one; switch back afterwards (F39)
            active = (gh_accounts(["--active", "--hostname", gh_host(v)], e) or [None])[0]
        if mod == "codex" and v.get("login") == "api":
            if not v.get("home"):       # codex would store the key in the global ~/.codex/auth.json
                die(f"codex login: api needs codex.home on {prof['name']!r}: codex stores the key in "
                    "plain text in its home's auth.json, and without a home that is the global "
                    "~/.codex shared by every profile")
            key, err, _ = read_ref(v["api_key"]) if v.get("api_key") else (None, "no codex.api_key", None)
            if key is None:
                die(f"codex login: {err}")
            stdin = key + "\n"              # on stdin, never in argv
        for argv in login_steps(mod, v, prof, a):
            info(f"{mod}: {LOGIN_BINS[mod]} {' '.join(argv)}")
            r = run([exe] + argv, env=e, capture_output=False, input=stdin)
            if r.returncode != 0:
                die(f"{mod} login failed ({LOGIN_BINS[mod]} exited {r.returncode})")
        if gh_acct and active != gh_acct:
            back = ["auth", "switch", "--hostname", gh_host(v), "--user", active] if active else None
            if back and run([exe] + back, env=e, stdin=subprocess.DEVNULL).returncode == 0:
                info(f"github: switched gh's active account back to {active}")
            else:
                warn(f"gh's active account is now {gh_acct}"
                     + (f"; switch back with: gh {' '.join(back)}" if back else ""))
        if mod == "aws" and probe_aws(v["profile"], env)["status"] == "expired":
            stop("login", "The AWS login did not take: check the SSO session in your browser, then run "
                 f"in your own terminal: actas login {prof['name']}", prof, code="expired", action="login")


def cmd_secret(a):
    if a.ref is not None and (a.env or a.key or a.set):
        die("use either `secret --ref REF` or `secret ENV KEY`", 2)
    if a.env == "set" and a.key and ":" in a.key:     # v1 keys never contain ":"
        if a.value is not None or a.set:
            die("usage: actas secret set REF  (the value is prompted for or read from stdin)", 2)
        require_human("secret set")
        secret_set_ref(a.key)
        audit("secret-set", refs=[a.key])
        return
    if a.ref is None and (not a.env or not a.key):
        die("usage: actas secret ENV KEY [--set]  |  actas secret --ref REF  |  "
            "actas secret set REF", 2)
    if a.set:
        require_human("secret --set", argv=["secret", a.env, a.key, "--set"])  # never echo a value
        if a.value is not None:
            warn("a value passed as an argument is visible in shell history and `ps`; "
                 "omit it to be prompted, or pipe it on stdin")
        secret_set(a.env, a.key, read_secret_value() if a.value is None else a.value)
        audit("secret-set", refs=[f"sops:{a.env}/{a.key}"])
        info(f"stored {a.env}.{a.key} in {SECRETS}")
        return
    # A read; neither form loads the manifest. ENV KEY (the v1 form) is
    # sops:ENV/KEY: its names are checked first for the clearer message.
    if a.ref is None:
        secret_path(a.env, a.key)
    ref = a.ref if a.ref is not None else f"sops:{a.env}/{a.key}"
    if who()["agent"]:
        audit("secret-read", refs=[ref])
    val, err, hint = read_ref(ref)
    if val is None:
        die(err + (f" ({hint})" if hint else ""))
    sys.stdout.write(val)


def read_secret_value():
    if sys.stdin.isatty():
        import getpass
        return getpass.getpass("value: ")
    return strip_nl(sys.stdin.read())


def cmd_git_credential(a):
    """git credential helper: `get` prints username/password for the ref.
    Any problem prints nothing (git then fails closed), exit 0."""
    if not sys.stdin.isatty():
        with suppress(OSError, ValueError):
            sys.stdin.read()
    if (a.op or "get") != "get":
        return
    user = a.username or "x-access-token"
    if who()["agent"]:
        audit("git-credential", refs=[a.ref])
    val, err, _ = read_ref(a.ref)
    if val is None:
        info(f"git-credential: {err}")
        return
    if any(ch in user + val for ch in "\r\n\0"):
        return
    sys.stdout.write(f"username={user}\npassword={val}\n")


# ========================================================== sync and desktop

LEDGER = STATE / "sync-ledger.json"
# What an unledgered settings file written by ccenv v1 is assumed to own
# (plus the env keys the profile sets).
V1_ADOPT = {"env": ["ANTHROPIC_BASE_URL", "AWS_PROFILE", "AWS_REGION"],
            "top": ["apiKeyHelper", "awsAuthRefresh"]}
# Env names whose replaced value the ledger never copies, only that one existed.
CRED_NAME_RE = re.compile(r"token|key|secret|pass|credential|auth", re.I)
# Helper and hook commands this tool wrote, under its name or the pre-rename
# `ccenv` (legacy: v1's `ccenv secret ENV KEY`, v2's `.../bin/ccenv ...`).
TOOL_SECRET_RE = re.compile(r"(?:actas|ccenv)'?\s+secret\b")
TOOL_HOOK_RE = re.compile(r"(?:actas|ccenv)'?\s+hook\s+session-start\b")


def has_glob(p):
    return any(ch in p for ch in "*?[")


def sync_dirs(prof):
    import glob
    dirs = []
    for pat in prof["match"]:
        ex = expand(pat)
        hits = sorted(glob.glob(ex)) if has_glob(ex) else [ex]
        dirs += [h for h in hits if os.path.isdir(h) and h not in dirs]
    return dirs


def git(d, *args):
    exe = find_bin("git")
    return run([exe, "-C", str(d)] + list(args), stdin=subprocess.DEVNULL, timeout=10) if exe else None


def git_out(d, *args):
    r = git(d, *args)
    return r.stdout.strip() if r is not None and r.returncode == 0 and r.stdout.strip() else None


def claude_root(d):
    """(root, in_git): where Claude reads settings.local.json for d - the main
    checkout of d's git repository (a worktree maps to it), else d. git
    prints resolved paths; they are mapped back onto d's spelling so match
    patterns still apply under a symlinked directory."""
    common = git_out(d, "rev-parse", "--path-format=absolute", "--git-common-dir")
    if common and os.path.isabs(common) and os.path.basename(common) == ".git":
        top = os.path.dirname(common)
    else:        # not in git, git < 2.31, a submodule or a bare repo
        top = git_out(d, "rev-parse", "--show-toplevel")
        if top is None:
            return d, bool(common)
    top = os.path.realpath(top)
    for a in [d] + [str(p) for p in Path(d).parents]:
        ra = os.path.realpath(a)
        if _under(top, ra):
            return os.path.normpath(a + top[len(ra):]), True
    return top, True


def settings_file(d):
    return Path(d) / ".claude" / "settings.local.json"


def child_repos(d, depth=2):
    """Git repositories up to two levels below a plain folder: Claude started
    in one reads that repo's settings, never the folder's (F18)."""
    try:
        names = sorted(os.listdir(d)) if depth else []
    except OSError:
        return []
    out = []
    for n in names:
        p = os.path.join(d, n)
        if n.startswith(".") or os.path.islink(p) or not os.path.isdir(p):
            continue
        out += [p] if os.path.exists(os.path.join(p, ".git")) else child_repos(p, depth - 1)
    return out


def load_ledger():
    try:
        data = json.loads(LEDGER.read_text())
        return data if isinstance(data, dict) else {}
    except FileNotFoundError:
        return {}
    except (OSError, ValueError) as e:
        warn(f"ignoring unreadable {tilde(LEDGER)} ({e})")
        return {}


def ledger_entry_for(cwd):
    """(file, entry) of the synced file Claude reads at cwd: the ledgered
    file with the longest root containing cwd."""
    best, cwd = None, os.path.realpath(cwd)
    for f, e in load_ledger().items():
        root = os.path.realpath(os.path.dirname(os.path.dirname(f)))
        if isinstance(e, dict) and _under(cwd, root) and (not best or len(root) > len(best[0])):
            best = (root, f, e)
    return best[1:] if best else None


def missing_helpers(entry):
    return [h for h in entry.get("helpers") or [] if not os.path.exists(h)]


def helper_paths(new):
    """Absolute executables in the helper strings of a settings fragment."""
    cmds = [new.get("apiKeyHelper"), new.get("awsAuthRefresh")]
    cmds += [v[1:] for k, v in new["env"].items() if k.startswith("GIT_CONFIG_VALUE_") and v[:1] == "!"]
    cmds += [h.get("command") for g in new.get("hooks", {}).get("SessionStart", []) if isinstance(g, dict)
             for h in g.get("hooks") or [] if isinstance(h, dict)]
    out = []
    for c in cmds:
        try:
            words = shlex.split(c or "")[:2]
        except ValueError:
            continue
        out += [w for w in words if w.startswith("/") and w not in out]
    return out


def read_settings(f):
    """The JSON object in f ({} when missing), or None (warned) when unreadable
    or a symlink: a repo can commit .claude/settings.local.json as a link to a
    credential file, which sync must neither read nor copy into the repo."""
    link = [str(x) for x in (f.parent, f) if os.path.islink(str(x))]
    if link:
        warn(f"skip {f}: {link[0]} is a symlink; actas neither follows nor replaces it")
        return None
    try:
        with os.fdopen(os.open(str(f), os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))) as h:
            data = json.loads(h.read())
    except FileNotFoundError:
        data = {}
    except (ValueError, OSError) as e:
        warn(f"skip {f}: cannot read it ({e})")
        return None
    if not isinstance(data, dict):
        warn(f"skip {f}: cannot read it (not a JSON object)")
        return None
    if not isinstance(data.get("env"), dict):      # "env": null -> {}
        data.pop("env", None)
    return data


def tool_hooks(data):
    """SessionStart hook commands a sync wrote: `<prefix> actas hook
    session-start ...`, or the pre-rename `.../ccenv hook ...` (legacy)."""
    hooks = data.get("hooks") if isinstance(data.get("hooks"), dict) else {}
    return [h["command"] for g in as_list(hooks.get("SessionStart")) if isinstance(g, dict)
            for h in g.get("hooks") or [] if isinstance(h, dict) and isinstance(h.get("command"), str)
            and TOOL_HOOK_RE.search(h["command"])]


def owned_by(f, data, ledger, prof):
    """What actas owns in f: its ledger entry; for an unledgered file written
    by ccenv v1, the keys v1 managed plus the profile's env keys; and in an
    unledgered file, the SessionStart hook an earlier sync wrote."""
    e = ledger.get(str(f))
    if isinstance(e, dict):
        return e
    hooks = {"hooks": tool_hooks(data)} if tool_hooks(data) else {}
    # v1 wrote awsAuthRefresh (aws profiles), a `ccenv secret` apiKeyHelper
    # (gateway) or, for subscription, an empty apiKeyHelper and base URL (R4).
    # TOOL_SECRET_RE also takes the new name and the v2 `.../ccenv secret --ref` form.
    if ("awsAuthRefresh" in data or TOOL_SECRET_RE.search(str(data.get("apiKeyHelper") or ""))
            or (data.get("apiKeyHelper") == "" and (data.get("env") or {}).get("ANTHROPIC_BASE_URL") == "")):
        return dict({"env": V1_ADOPT["env"] + list(section(prof or {}, "env")), "top": list(V1_ADOPT["top"])},
                    **hooks)
    return hooks


def strip_hooks(group, cmds):
    """A hook group without our commands; None when nothing is left."""
    if not isinstance(group, dict) or not isinstance(group.get("hooks"), list):
        return group
    keep = [h for h in group["hooks"] if not (isinstance(h, dict) and h.get("command") in cmds)]
    return dict(group, hooks=keep) if keep or not group["hooks"] else None


def drop_owned(data, own):
    """Remove what actas owns and restore the user's values it replaced;
    returns the keys whose replaced value was not kept (credential names)."""
    env, perms, hooks = (data.get(k) if isinstance(data.get(k), dict) else {}
                         for k in ("env", "permissions", "hooks"))
    for k in own.get("env") or []:
        env.pop(k, None)
    for k in own.get("top") or []:
        if k.startswith("permissions."):
            perms.pop(k.split(".", 1)[1], None)
        else:
            data.pop(k, None)
    for k, items in (own.get("permissions") or {}).items():
        if isinstance(perms.get(k), list):
            perms[k] = [x for x in perms[k] if x not in items]
    cmds = set(own.get("hooks") or [])
    for event, groups in hooks.items():
        if isinstance(groups, list):
            hooks[event] = [g for g in (strip_hooks(x, cmds) for x in groups) if g is not None]
    for k in [k for k, v in hooks.items() if v == []]:
        del hooks[k]
    for k in [k for k, v in perms.items() if v == []]:
        del perms[k]
    for k in ("env", "permissions", "hooks"):
        if data.get(k) == {}:
            del data[k]
    for k, v in (own.get("prev") or {}).items():     # the user's values actas replaced (F34)
        head, _, sub = k.partition(".") if k.startswith(("env.", "permissions.")) else (k, "", "")
        if not sub:
            data[k] = v
        elif isinstance(data.setdefault(head, {}), dict):
            data[head][sub] = v
    return list(own.get("replaced") or [])


def drop_legacy_markers(data):
    """Legacy: the CCENV* variables a pre-rename sync wrote; actas writes ACTAS*."""
    env = data.get("env") if isinstance(data.get("env"), dict) else {}
    for k in [k for k in env if k.startswith(LEGACY_PREFIX)]:
        del env[k]
    if "env" in data and data["env"] == {}:
        del data["env"]


def put_fragment(data, new):
    """Apply a settings fragment; returns what actas now owns in the file:
    env keys, top-level keys, permission rules it added, hook commands; under
    "prev" the user's own values it replaced (restored on drop), and under
    "replaced" credential-looking env names whose values it never copies."""
    own = {"env": list(new["env"]), "top": [], "permissions": {}, "hooks": []}
    env, perms = (data.get(k) if isinstance(data.get(k), dict) else {} for k in ("env", "permissions"))
    old = {f"env.{k}": env[k] for k in new["env"] if k in env}
    old.update((k, data[k]) for k in new if k not in ("env", "permissions", "hooks") and k in data)
    if isinstance(new.get("permissions"), dict):
        old.update((f"permissions.{k}", perms[k]) for k, v in new["permissions"].items()
                   if not isinstance(v, list) and k in perms)
    # Not the user's (R3): actas's own output - ACTAS* keys, or anything in a
    # file that still carries env.ACTAS after drop_owned (a sync whose ledger
    # entry was lost; env.CCENV from a pre-rename sync counts too). A value
    # equal to actas's is still the user's (kept).
    for k, cur in old.items() if not {"ACTAS", "CCENV"} & set(env) else ():
        if k.startswith(("env.ACTAS", "env.CCENV")):
            continue
        if k.startswith("env.") and CRED_NAME_RE.search(k[4:]):
            own.setdefault("replaced", []).append(k)
        else:
            own.setdefault("prev", {})[k] = cur
    data.setdefault("env", {}).update(new["env"])
    for k, v in new.items():
        if k == "env":
            continue
        if k in ("permissions", "hooks") and isinstance(v, dict):
            cur = data[k] = data[k] if isinstance(data.get(k), dict) else {}
            for sk, sv in v.items():
                if k == "hooks":
                    cmds = {h.get("command") for g in sv if isinstance(g, dict)
                            for h in g.get("hooks") or [] if isinstance(h, dict)}
                    old = [g for g in (strip_hooks(x, cmds) for x in as_list(cur.get(sk))) if g is not None]
                    cur[sk] = old + copy.deepcopy(sv)
                    own["hooks"] += sorted(c for c in cmds if c)
                elif isinstance(sv, list):
                    old = cur[sk] if isinstance(cur.get(sk), list) else []
                    add = [x for x in sv if x not in old]
                    cur[sk] = old + add
                    if add:
                        own["permissions"][sk] = add
                else:
                    cur[sk] = copy.deepcopy(sv)
                    own["top"].append(f"permissions.{sk}")
        else:
            data[k] = copy.deepcopy(v)
            own["top"].append(k)
    return own


def replaced_note(f, k):
    info(f"{f}: your own {k} was overwritten by actas sync earlier and its value was not kept "
         "(it looks like a credential); set it again if you need it")


def flat_keys(d):
    out = {f"env.{k}": v for k, v in (d.get("env") or {}).items()}
    out.update((k, v) for k, v in d.items() if k != "env")
    return out


def key_diff(old, new):
    """Key names only (+ added, ~ changed, - removed); never values."""
    a, b = flat_keys(old), flat_keys(new)
    ch = ([f"+{k}" for k in b if k not in a] + [f"~{k}" for k in b if k in a and a[k] != b[k]]
          + [f"-{k}" for k in a if k not in b])
    return " ".join(ch) or "no changes"


def sync_write(f, prof, new, ledger, a, git_root):
    data = read_settings(f)
    if data is None:
        return False
    before = copy.deepcopy(data)
    lost = drop_owned(data, owned_by(f, data, ledger, prof))
    own = put_fragment(data, new)
    drop_legacy_markers(data)
    for k in lost:              # still overwritten: keep the note; else tell the user
        if k[4:] in own["env"]:
            own["replaced"] = sorted(set(own.get("replaced", [])) | {k})
        else:
            replaced_note(f, k)
    if a.dry_run:
        print(f"would write {f}  ({prof['name']}): {key_diff(before, data)}")
        return True
    try:
        write_private(f, json.dumps(data, indent=2) + "\n")
    except OSError as e:     # a read-only repo: skip it, keep going (the ledger is still saved)
        warn(f"skip {f}: cannot write it ({e.strerror or e})")
        return False
    ledger[str(f)] = dict({"profile": prof["name"], "version": 2,
                           "written": time.strftime("%Y-%m-%dT%H:%M:%S%z")}, **own,
                          helpers=helper_paths(new))
    print(f"{paint('wrote', 'green')} {f}  ({prof['name']})")
    r = git(git_root, "check-ignore", "-q", ".claude/settings.local.json") if git_root else None
    if r is not None and r.returncode == 1:
        info(f'add ".claude/settings.local.json" to .gitignore or .git/info/exclude in '
             f"{tilde(git_root)} (actas does not edit them)")
    return True


def global_routing():
    """Provider routing ~/.claude/settings.json sets for every project that a
    synced file does not override: apiKeyHelper, env.ANTHROPIC_BASE_URL."""
    try:
        g = json.loads((HOME / ".claude" / "settings.json").read_text())
    except (OSError, ValueError):
        return []
    g = g if isinstance(g, dict) else {}
    out = ["apiKeyHelper"] if g.get("apiKeyHelper") else []
    if isinstance(g.get("env"), dict) and g["env"].get("ANTHROPIC_BASE_URL"):
        out.append("env.ANTHROPIC_BASE_URL")
    return out


def owns_routing(entry, keys):
    """Which of the global routing keys a ledger entry overrides."""
    entry = entry if isinstance(entry, dict) else {}
    return [k for k in keys if (k[4:] in (entry.get("env") or []) if k.startswith("env.")
                                else k in (entry.get("top") or []))]


def sync_clean(f, ledger, a):
    """Remove what actas owns in f; delete the file when nothing else is left."""
    data = read_settings(f) if f.exists() else {}
    if data is None:
        return False
    own = owned_by(f, data, ledger, None) if f.exists() else {}
    if own:
        for k in drop_owned(data, own):
            replaced_note(f, k)
        drop_legacy_markers(data)
        verb = "deleted" if not data else "cleaned"
        if a.dry_run:
            print(f"would clean {f}  ({verb})")
            return True
        try:
            if data:
                write_private(f, json.dumps(data, indent=2) + "\n")
            else:
                f.unlink()
        except OSError as e:    # its ledger entry stays, so a later --clean retries
            warn(f"skip {f}: cannot clean it ({e.strerror or e})")
            return False
        if not data:
            with suppress(OSError):
                f.parent.rmdir()
        print(f"{paint('clean', 'green')} {f}  ({verb})")
    if not a.dry_run:
        ledger.pop(str(f), None)
    return True


def nested_profiles(cfg, prof):
    """Other profiles' directories inside this profile's ("infra/prod ->
    client-a-prod"): one repo has one settings file, so the note warns."""
    out = []
    for pat in prof["match"]:
        base = expand(pat)
        for other, body in cfg.profiles.items():
            for op in as_list(body.get("match")):
                ex = expand(op)
                if (other != prof["name"] and ex != base and hit(ex, base)
                        and match_dir(cfg, ex)[0] == other):
                    rel = os.path.relpath(ex, base) if _under(ex, base) and not has_glob(base) else tilde(ex)
                    if f"{rel} → {other}" not in out:
                        out.append(f"{rel} → {other}")
    return out


def context_text(cfg, prof):
    """The SessionStart note (SPEC 10.2): names only, never a secret."""
    parts, aws = [f"profile {prof['name']} ({prof['level']})"], section(prof, "aws")
    if aws.get("profile"):
        parts.append(" ".join(x for x in ("aws", aws["profile"], aws.get("region")) if x))
    if gh_label(prof):
        parts.append(f"gh {gh_label(prof)}")
    parts.append(f"claude {provider_of(prof)}")
    lines = ["actas: " + " · ".join(parts), CONTEXT_RULE]
    nested = nested_profiles(cfg, prof)
    if nested:
        lines.append(f"actas: subdirectories here may belong to other profiles (e.g. "
                     f"{', '.join(nested[:3])}); check actas status there.")
    return "\n".join(lines) + "\n"


def write_context(cfg, prof):
    ensure_dir(CACHE, tighten=True)
    write_private(CACHE / f"{prof['name']}.context.txt", context_text(cfg, prof))


def cmd_sync(a):
    """SPEC 11.1: write each profile's non-secret settings to <root>/.claude/
    settings.local.json, where root is the git checkout Claude reads them
    from. A directory is written only for the profile resolve() picks there
    (D4/D5); a nested profile under another profile's repo root is skipped
    (D6); the ledger records what actas owns in each file (D11)."""
    require_human("sync", a.env)
    release()
    if a.shared:
        die("sync --shared is not in actas 2.0: sync writes settings.local.json only", 2)
    if a.all and (not a.clean or a.env or a.include_confirm):
        die("--all goes with --clean alone: actas sync --clean --all [--dry-run] [--force]", 2)
    # --clean --all (uninstalling): every ledgered file, without reading the
    # manifest (it may be gone or broken); nothing new is written.
    cfg = None if a.all else load()
    if a.env:
        resolve(a.env, cfg=cfg)          # an unknown name or a role dies with the usual message
    ledger = load_ledger()
    before, failed, done, broken = copy.deepcopy(ledger), False, set(), set()
    if not a.all:
        off_aside(move=not a.dry_run)    # synced files point at the `_off` homes too (F2)
    try:
        for name in [] if a.all else [a.env] if a.env else list(cfg.profiles):
            try:
                prof = merge_profile(name, cfg)
            except ManifestError as e:
                warn(f"skip {name}: {e}")
                failed = True
                broken.add(name)         # its files are not orphans: --clean keeps them (R2)
                continue
            dirs, new = sync_dirs(prof), None
            held = prof["confirm"] and not a.include_confirm
            if held and dirs:
                info(f"skip {', '.join(tilde(d) for d in dirs)}: {name} requires confirmation; "
                     "use actas run (or sync --include-confirm)")
            for d in dirs:             # grows: the child repos of a plain folder (F18)
                got = locate(cfg, d)[0]
                if got != name:
                    if not held:
                        info(f"skip {tilde(d)}: resolves to {got or 'no profile'}")
                    continue
                root, in_git = claude_root(d)
                if not in_git:
                    dirs += [c for c in child_repos(d) if c not in dirs and locate(cfg, c)[0] == name]
                owner = name if root == d else locate(cfg, root)[0]
                # The root's file, and d's own when d is a worktree or a nested
                # profile's directory (F15): only a file actas wrote there earlier
                # (v1 wrote such dirs), kept current rather than left stale (D-E).
                cands = [f for f in [settings_file(x) for x in ([root] if owner == name else [])
                                     + ([d] if root != d else [])] if str(f) not in done]
                done.update(str(f) for f in cands)       # still targets: --clean never removes them
                if held:
                    continue
                files = []
                for f in cands:
                    if f != settings_file(root):
                        data = read_settings(f) if os.path.lexists(str(f)) else None
                        if data is None or not owned_by(f, data, ledger, prof):
                            continue
                        info(f"updating {f}: actas wrote it earlier and Claude may still read keys the repo "
                             "root does not set" + ("" if owner == name else
                                                    f" (the root {tilde(root)} is {owner or 'no profile'}; "
                                                    "use `actas run` here)"))
                    files.append(f)
                if owner != name and cands and not files:
                    warn(f"skip {tilde(d)}: Claude reads settings.local.json at the repo root "
                         f"{tilde(root)} (profile {owner or 'none'}); use `actas run` here")
                for f in files:
                    new = new or settings_for(prof, assemble(prof, want_secrets=False, git_base=0,
                                                             ctx={"agent": True}), "sync")
                    failed |= not sync_write(f, prof, new, ledger, a, f.parent.parent if in_git else None)
            if new is not None and not a.dry_run:
                try:
                    write_context(cfg, prof)
                except OSError as e:
                    warn(f"could not write {name}'s session note in {tilde(CACHE)} ({e.strerror or e})")
                    failed = True
        exposed = global_routing()
        for f, e in list(ledger.items()):
            owner = e.get("profile") if isinstance(e, dict) else None
            if f in done or owner in broken or (a.env and owner != a.env):
                continue
            if not a.clean:
                info(f"stale {f} ({owner or '?'}): no profile syncs it any more; "
                     "`actas sync --clean` removes what actas wrote there")
                continue
            own = owns_routing(e, exposed)
            if own and not a.force:
                warn(f"keep {f}: removing it lets ~/.claude/settings.json's {', '.join(own)} apply in "
                     f"{tilde(Path(f).parent.parent)}; `actas sync --clean --force` removes it anyway")
                continue
            failed |= not sync_clean(Path(f), ledger, a)
    finally:
        # Saved even when a later repo fails: files already written stay
        # ledgered, so sync and --clean can still find what actas owns there.
        if ledger != before and not a.dry_run:
            try:
                ensure_dir(STATE, tighten=True)
                write_private(LEDGER, json.dumps(ledger, indent=2, sort_keys=True) + "\n")
            except OSError as e:
                warn(f"could not save {tilde(LEDGER)} ({e.strerror or e})")
                failed = True
    if not a.dry_run:
        audit("sync", a.env, "allowed", reason="clean-all" if a.all else "clean" if a.clean else None)
    if a.all and not a.dry_run:
        if ledger:
            warn(f"{len(ledger)} synced file(s) kept (see above); {tilde(LEDGER)} still lists them")
        info(f"actas's own files are under {tilde(ROOT)}, {tilde(STATE)} and {tilde(CACHE)}, "
             "plus anything you installed with actas setup (README: Uninstall)")
    if failed:
        sys.exit(1)


def cmd_hook(a):
    """SessionStart hook (SPEC 10.2): print the profile's context note.
    Never parses the manifest; always exits 0."""
    p = a.profile
    if a.source == "sync" and env_any("ACTAS_SESSION"):
        return                               # the run-level hook speaks
    if (a.source == "run" and env_get("ACTAS") and env_get("ACTAS") != p) or not NAME_RE.match(p):
        return
    try:
        sys.stdout.write((CACHE / f"{p}.context.txt").read_text())
    except OSError:
        print(f"actas: profile {p} (run actas sync to refresh this note)")


def cmd_desktop(a):
    """SPEC 11.2-11.3: what reaches Claude Desktop, the IDE and GUI apps.
    Prints only; never writes app configuration, never prints a token."""
    prof = resolve(a.env, a.cwd)
    name, c = prof["name"], section(prof, "claude")
    provider = c.get("provider") or "subscription"
    if a.print_3p:
        if provider not in ("gateway", "api-key"):
            die(f"--print-3p is for gateway and api-key profiles; {name} is {provider}")
        words = shlex.split(helper_prefix())
        print(json.dumps({
            "inferenceProvider": "gateway",
            "inferenceGatewayBaseUrl": c.get("base_url") or "https://api.anthropic.com",
            "inferenceGatewayAuthScheme": c.get("auth_header")
            or ("x-api-key" if provider == "api-key" else "bearer"),
            "inferenceCredentialHelper": words[0],
            "inferenceCredentialHelperArgs": words[1:] + ["secret", "--ref", c["token"]]}, indent=2))
        for line in ("paste this in Claude Desktop under Developer -> Configure Third-Party Inference "
                     "(app-wide: every Desktop session then uses it)",
                     "inferenceGatewayAuthScheme needs app 1.3036.0 or later; "
                     "inferenceCredentialHelperArgs needs 2.110.0 or later",
                     "the app caches the helper's answer for inferenceCredentialHelperTtlSec (default "
                     "3600 s): a rotated token applies within that window",
                     "older apps: save these two lines as a 0700 script and use its path as "
                     "inferenceCredentialHelper (no Args):",
                     "  #!/bin/sh",
                     f"  exec {helper_prefix()} secret --ref {shell_quote(c['token'])}"):
            info(line)
        return
    if a.vscode:
        res = assemble(prof, want_secrets=False, git_base=0)
        pairs = [{"name": k, "value": v} for k, v in public_env(res).items()]
        print(json.dumps({"claudeCode.environmentVariables": pairs}, indent=2))
        info("paste into VS Code user settings (desktop-safe values only, no secrets)")
        if provider in ("gateway", "api-key"):
            info("the extension's login check also needs a credential: a global apiKeyHelper in "
                 "~/.claude/settings.json (unverified) or a token in this list (plaintext; not recommended)")
        return
    lines = [f"{name}: {provider} profile ({prof['level']})", DESKTOP_PROVIDER[provider].format(p=name),
             "Desktop local Code sessions, and bare claude or the IDE in a synced repo, read "
             ".claude/settings.local.json (actas sync): desktop-safe env (Desktop's own launch env "
             "wins), permissions and the SessionStart note. Never secret_env values; Desktop also "
             "ignores apiKeyHelper and ANTHROPIC_* credentials."]
    if prof["confirm"]:
        lines.append("This profile needs confirmation, so actas sync skips it: use actas run.")
    if c.get("home"):
        lines.append("claude.home applies only through actas run: project files ignore CLAUDE_CONFIG_DIR.")
    if provider_of(prof) == "subscription":
        lines.append("Cloud sessions and Remote Control work; for AWS there, run `actas aws-handoff` "
                     "in your terminal.")
    else:
        lines.append("Remote Control is off with a gateway, an API key or a cloud provider.")
    lines += [f"VS Code extension: `actas desktop {name} --vscode` prints claudeCode.environmentVariables.",
              f"Other GUI apps: `actas exec {name} -- /Applications/X.app/Contents/MacOS/X`, or paste "
              f"`actas shell {name} --format env` into the app's env setting."]
    print("\n".join(lines))


INSTRUCTION_HINTS = {
    "claude": "put this in AGENTS.md and add `@AGENTS.md` to CLAUDE.md",
    "codex": "put this in AGENTS.md (Codex reads it)",
    "gemini": 'put this in AGENTS.md and set context.fileName: ["GEMINI.md", "AGENTS.md"] '
              "in .gemini/settings.json",
    "generic": "put this in the instructions file your agent reads (often AGENTS.md)",
}


def cmd_instructions(a):
    """Print AGENT_RULES (or the direnv function, or a skill) on stdout; hints
    go to stderr so the output can be appended to a file. Never edits files
    (`actas setup` writes them)."""
    if sum(map(bool, (a.direnv, a.skill, a.agent))) > 1:
        die("--agent, --direnv and --skill are alternatives; give one", 2)
    if a.direnv:
        sys.stdout.write(DIRENVRC)
        return
    if a.skill:
        sys.stdout.write(SKILLS[a.skill])
        return
    print(AGENT_RULES)
    if a.agent:
        info(INSTRUCTION_HINTS[a.agent])


def direnv_lib():
    """direnv sources every $XDG_CONFIG_HOME/direnv/lib/*.sh, like direnvrc."""
    return Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config") / "direnv" / "lib" / "actas.sh"


def setup_write(dest, text, ours, a):
    """Write one `actas setup` file: say so when it is current, never write
    through a symlink, and replace an existing file only when it is an
    earlier copy from actas (ours(old_text)) or with --force."""
    with suppress(OSError):
        if dest.read_text() == text:
            print(f"up to date: {tilde(dest)}")
            return
    link = next((x for x in (dest, dest.parent) if x.is_symlink()), None)
    if link is not None:
        die(f"{tilde(link)} is a symlink (to {os.readlink(str(link))}); actas does not write through it. "
            "Update what it points to (e.g. git pull in a checkout), or remove the link and run this again")
    if dest.is_dir():
        die(f"{tilde(dest)} is a directory")
    verb = "write"
    if os.path.lexists(str(dest)):
        try:
            old = dest.read_text(errors="replace")
        except OSError as e:
            die(f"cannot read {tilde(dest)}: {e.strerror}")
        if not ours(old) and not a.force:
            die(f"{tilde(dest)} exists and was not written by actas; --force replaces it")
        verb = "replace"
    if a.dry_run:
        print(f"would {verb} {tilde(dest)}")
        return
    write_private(dest, text)
    print(f"{paint('wrote', 'green')} {tilde(dest)}")


def cmd_setup(a):
    """Install a file this actas ships: a Claude Code skill or the direnv
    function (the same text `actas instructions --skill/--direnv` prints),
    so a uv/pipx or install.sh install needs no checkout. Human-only: it
    writes outside the repository (a skill's allowed-tools are permissions)."""
    require_human("setup")
    if a.what == "skill":
        if a.file:
            die("setup skill takes --dir, not --file", 2)
        name = a.name or "actas"
        if name not in SKILLS:
            die(f"no skill {name!r}; one of: {', '.join(SKILLS)}" + did_you_mean(name, SKILLS), 2)
        base = (Path(a.dir).expanduser() if a.dir else
                HOME / ".claude" / "skills" if name == "actas"
                else Path(getattr(a, "cwd", None) or os.getcwd()).expanduser() / ".claude" / "skills")
        dest = base.absolute() / name / "SKILL.md"
        setup_write(dest, SKILLS[name], lambda old: f"\nname: {name}\n" in old, a)
        if name == "aws-handoff" and not a.dry_run:
            info("commit it to the repository: cloud sessions read the project's .claude/skills")
        return
    if a.name or a.dir:
        die("setup direnv takes no NAME or --dir (use --file)", 2)
    dest = Path(a.file).expanduser().absolute() if a.file else direnv_lib()
    setup_write(dest, DIRENVRC, lambda old: "use_actas()" in old, a)
    rc = dest.parent.parent / "direnvrc"
    with suppress(OSError):
        if not a.file and "use_actas()" in rc.read_text():
            info(f"{tilde(rc)} also defines use_actas (an earlier copy); remove it there, so the "
                 "copy `actas setup direnv` keeps current is the only one")
    if not a.dry_run:
        info("then add `use actas` (or `use actas <profile>`) to a project's .envrc")


def cmd_aws_handoff(a):
    """Short-lived credentials for a cloud session, which cannot reach the
    SSO cache. They land in its transcript: keep the TTL short, the role narrow."""
    require_human("aws-handoff", a.env)
    prof = resolve(a.env, a.cwd)
    aws = section(prof, "aws")
    profile = a.profile or aws.get("profile")
    region = aws.get("region") or os.environ.get("AWS_REGION")
    if region and not re.match(r"^[a-z0-9-]+$", region):
        die(f"invalid AWS region {region!r}")
    if not profile:
        die(f"profile {prof['name']!r} has no aws.profile")
    aws_bin = find_bin("aws") or die("aws not found (install the AWS CLI v2)")
    env = child_env(assemble(prof, want_secrets=False))
    # D26: never a browser login unless asked (--login); expired -> exit 4.
    if probe_aws(profile, env)["status"] == "expired":
        if not a.login:
            stop("login", f"In your own terminal, run: actas login {prof['name']}  (or: actas aws-handoff "
                 f"{prof['name']} --login)", prof, code="expired", action="aws-handoff")
        release()
        if not aws_login(dict(aws, profile=profile), env) or probe_aws(profile, env)["status"] != "ok":
            die(f"could not refresh AWS SSO for {profile}")
    release()
    # F24: wl-copy only in a Wayland session, xclip only under X11
    clip = next(([find_bin(b)] + x for b, x, display in (
        ("pbcopy", [], None), ("wl-copy", [], "WAYLAND_DISPLAY"), ("xclip", ["-selection", "clipboard"], "DISPLAY"))
        if find_bin(b) and (not display or os.environ.get(display))), None)
    if not clip and not a.stdout:
        die("no clipboard tool (pbcopy, wl-copy or xclip); use --stdout to print the credentials")
    audit("aws-handoff", prof, cmd=["aws", "configure", "export-credentials", "--profile", profile])
    r = run([aws_bin, "configure", "export-credentials", "--profile", profile, "--format", "process"],
            env=env, stdin=subprocess.DEVNULL)
    if r.returncode != 0:
        die(f"export-credentials failed: {r.stderr.strip()}")
    try:
        c = json.loads(r.stdout)
    except ValueError:
        die("export-credentials printed no JSON")
    if not (isinstance(c, dict) and c.get("AccessKeyId") and c.get("SecretAccessKey")):
        die("export-credentials printed no usable credentials")

    # Anything pasted into a chat lands in the session transcript, so never
    # hand over a long-lived access key. SSO profiles are already temporary;
    # static IAM keys get traded for a session token first.
    if not c.get("SessionToken") or not c.get("Expiration"):
        info(f"profile {profile} has long-lived keys - trading them for a "
             f"{a.duration}s session token")
        t = run([aws_bin, "sts", "get-session-token",
                 "--duration-seconds", str(a.duration), "--profile", profile], env=env,
                stdin=subprocess.DEVNULL)
        if t.returncode != 0:
            die("profile has long-lived credentials and get-session-token "
                f"failed, refusing to hand them over: {t.stderr.strip()}")
        try:
            cr = json.loads(t.stdout)["Credentials"]
            c = {"AccessKeyId": cr["AccessKeyId"], "SecretAccessKey": cr["SecretAccessKey"],
                 "SessionToken": cr["SessionToken"], "Expiration": str(cr["Expiration"])}
        except (ValueError, KeyError, TypeError):
            die("get-session-token printed no usable credentials; refusing to hand over "
                "the long-lived ones")

    block = (
        "Set up AWS credentials for this session by running exactly this, "
        "then confirm with `aws sts get-caller-identity`:\n\n"
        "```bash\n"
        "mkdir -p ~/.aws && cat > ~/.aws/credentials <<'AWSEOF'\n"
        "[default]\n"
        f"aws_access_key_id = {c['AccessKeyId']}\n"
        f"aws_secret_access_key = {c['SecretAccessKey']}\n"
        f"aws_session_token = {c.get('SessionToken', '')}\n"
        "AWSEOF\n"
        + (f"printf '[default]\\nregion = {region}\\n' > ~/.aws/config\n" if region else "")
        + "chmod 600 ~/.aws/credentials\n"
        "```\n"
    )
    if not a.stdout:
        # No pipes: xclip forks a server that would hold them open (F24).
        name = os.path.basename(clip[0])
        if run(clip, input=block, capture_output=False, stdout=subprocess.DEVNULL,
               stderr=subprocess.DEVNULL, timeout=10).returncode != 0:
            die(f"{name} failed; use --stdout to print the credentials")
        info(f"copied to clipboard ({name}) · profile {profile} · expires {c.get('Expiration', '?')}")
        info("paste it into the cloud session chat")
        warn("these credentials will be stored in that session's transcript")
    else:
        sys.stdout.write(block)


INIT_MANIFEST = """\
# actas: one profile per working context. Docs: actas help manifest
version: 2
profiles:
  personal:
    match: ~/code/personal
    # git:    { name: Your Name, email: you@example.com }  # who commits here; unset: your global git config
    # github: { auth: "gh:your-login" }          # an account from `gh auth status`
    # aws:    { profile: my-sso-profile, region: eu-west-1 }
    # claude: { provider: gateway, base_url: "https://llm.example.com", token: "keychain:actas/gw" }
# roles:                                         # reusable pieces, combined with use: [...]
#   readonly-aws: { level: readonly, aws: { profile: my-readonly } }
#   no-deploy:    { permissions: { deny: ["Bash(terraform apply *)"] } }
"""


INIT_DOC = {"version": 2, "profiles": {"personal": {"match": "~/code/personal"}}}
INIT_GIT_LINE = "    # git:    { name: Your Name, email: you@example.com }  # who commits here; unset: your global git config\n"


def git_global_identity():
    """(name, email) from the user's global git config, or None: the starter
    uses it rather than a placeholder that would end up in commits."""
    git = find_bin("git")
    if not git:
        return None
    vals = []
    for key in ("user.name", "user.email"):
        r = run([git, "config", "--global", "--get", key], timeout=5, stdin=subprocess.DEVNULL)
        v = r.stdout.strip() if r.returncode == 0 else ""
        if not v or "\n" in v:
            return None
        vals.append(v)
    return tuple(vals)


def init_starter(ident):
    """(YAML text, JSON-able doc) of the starter manifest. With an identity
    the git line is filled in; without one it stays a comment, so nothing
    writes a placeholder into commits."""
    if not ident:
        return INIT_MANIFEST, INIT_DOC
    name, email = ident
    q = json.dumps          # a JSON string is a YAML string; \u escapes keep the file ASCII
    line = f"    git:    {{ name: {q(name)}, email: {q(email)} }}  # from your global git config\n"
    doc = copy.deepcopy(INIT_DOC)
    doc["profiles"]["personal"]["git"] = {"name": name, "email": email}
    return INIT_MANIFEST.replace(INIT_GIT_LINE, line), doc


def cmd_init(a):
    """Create the config directory with a starter manifest and, when an age
    key exists, a .sops.yaml that encrypts secrets to it. Never overwrites."""
    require_human("init")
    ensure_dir(ROOT, tighten=True)
    if MANIFEST.exists():
        info(f"exists, left alone: {MANIFEST}")
    else:
        text, doc = init_starter(git_global_identity())
        if yaml_available():
            write_private(MANIFEST, text)
        else:       # F19: a starter this machine can read back
            write_private(MANIFEST, json.dumps(doc, indent=2) + "\n")
            info(f"no YAML parser here, so the starter is JSON (also valid YAML); for YAML, {YAML_HINT}")
        print(f"{paint('wrote', 'green')} {MANIFEST}")
    sops_cfg = ROOT / ".sops.yaml"
    key = age_key_file()
    lines = Path(key).read_text().splitlines() if key and Path(key).exists() else []
    pub = next((x.split(":", 1)[1].strip() for x in lines if x.startswith("# public key:")), None)
    if sops_cfg.exists():
        info(f"exists, left alone: {sops_cfg}")
    elif pub:
        write_private(sops_cfg,
                      "# Who can decrypt secrets.enc.yaml. Add a key, then run:\n"
                      "#   sops updatekeys secrets.enc.yaml\n"
                      "creation_rules:\n"
                      "  - path_regex: secrets\\.enc\\.yaml$\n"
                      f"    age: {pub}   # comma-separate to add more\n")
        print(f"{paint('wrote', 'green')} {sops_cfg}  (age key {pub[:16]}...)")
    else:
        info("secrets: use `keychain:` (macOS) or `op://` refs, or install age+sops for `sops:` refs "
             "(age-keygen -o ~/.config/sops/age/keys.txt, then actas init again)")
    print(f"next: edit {MANIFEST}, then run `actas doctor` and `actas list`")


# ==================================================================== doctor

def iter_refs(x, path=""):
    if isinstance(x, dict):
        for k, v in x.items():
            yield from iter_refs(v, f"{path}.{k}" if path else str(k))
    elif isinstance(x, str) and ref_scheme(x) and REF_RES[ref_scheme(x)].match(x):
        yield path, x


def manifest_checks(cfg):
    """SPEC 3.2 -> (Problems: error / warning / info, the merged profiles)."""
    out = Problems()
    out.items = list(cfg.problems.items)
    if cfg.problems.errors():
        return out, {}
    v1 = cfg.version == 1
    nodes = {**cfg.roles, **cfg.profiles}
    for name in cfg.roles:
        try:
            linearize(name, nodes)
        except ManifestError as e:
            out.error(f"roles.{name}", str(e))
    profs, errors = all_profiles(cfg, check=True)
    for name, e in errors.items():
        out.error(f"profiles.{name}", str(e))
    referenced = {cfg.fallback} | {u for b in nodes.values() for u in as_list(b.get("use"))}
    referenced |= {t for b in profs.values() for t in b["agents_may_use"]}
    if ANY in referenced:
        referenced |= set(profs)
    for t in cfg.defaults.get("agents_may_use") or []:
        if t != ANY and t not in profs:
            out.warn("defaults.agents_may_use", f"unknown profile {t!r}" + did_you_mean(t, cfg.profiles))
    wild = sorted(n for n, pr in profs.items() if ANY in pr["agents_may_use"] and not pr["confirm"])
    if wild:
        out.info("agents_may_use", f'"*" for {", ".join(wild)}: an agent in those sessions may '
                                   "`actas exec` every profile at the same or a lower level without confirm")
    for name, prof in profs.items():
        p = f"profiles.{name}"
        level, perms = prof["level"], section(prof, "permissions")
        if perms.get("builtin") is False and not v1:
            src = prof["_prov"].get(("permissions", "builtin"), {}).get("from", "?")
            n = len([r for i, act in PRESETS[level].items() if act != "allow" for r in INTENT_RULES[i]])
            out.info(p, f"built-in agent rules are off (permissions.builtin: false in {src}): looser than "
                        f"the {level} preset, whose {n} command rules and credential-file rules are not rendered")
        for t in prof["agents_may_use"] if prof.get("_own_amu") or v1 else []:
            if t == ANY:
                continue
            if t not in profs:
                out.warn(f"{p}.agents_may_use", f"unknown profile {t!r}" + did_you_mean(t, cfg.profiles))
            elif LEVELS[profs[t]["level"]] > LEVELS[level] or profs[t]["confirm"]:
                out.warn(f"{p}.agents_may_use", f"{t} is higher-level or needs confirm: "
                                                "agents are always refused")
        if level == "power" and not prof["confirm"]:
            out.warn(p, "level power without confirm: agents and Desktop sessions can use it "
                        "without a human")
        if level == "readonly" and (section(prof, "github").get("auth") or "").startswith("gh:"):
            out.info(p, "readonly with a gh: account: a gh OAuth token usually has full repo scope; "
                        "use a fine-grained read PAT ref for a real readonly boundary")
        if prof["confirm"] and prof["match"]:
            out.info(p, "confirm profile with match: sync skips it; use actas run there")
        if section(prof, "codex").get("login") == "api" and not section(prof, "codex").get("home"):
            out.warn(f"{p}.codex", "login: api without home: actas login refuses (codex would store "
                                   "the key in the global ~/.codex/auth.json); set codex.home")
        for var, m1, m2 in assemble(prof, want_secrets=False)["conflicts"]:
            out.warn(p, f"{var} is set by both {m1} and {m2}; {m2} wins")
        for k in prof.get("env") or {}:
            if SECRETISH_RE.search(k):
                out.warn(f"{p}.env.{k}", "env values are written to settings files; "
                                         "use secret_env for secrets")
        if not prof["match"] and name not in referenced:
            out.info(p, "no match and nothing uses it: reachable only by name")
    for sec, bodies in (("defaults", {"": cfg.defaults}), ("profiles", cfg.profiles),
                        ("roles", cfg.roles)):
        for n, b in bodies.items():
            for path, ref in iter_refs(b):
                if ref.startswith("cmd:"):
                    where = f"{sec}.{n}.{path}" if n else f"{sec}.{path}"
                    out.info(where, f"runs a command to read a secret: {ref}")
    return out, profs


EXAMPLE_DOMAINS = ("example.com", "example.net", "example.org", "example", "invalid")


def placeholder_git(g):
    """A starter or documentation git identity: the init placeholder's name, or
    an email at a reserved example domain (RFC 2606), as in the README."""
    dom = str(g.get("email") or "").lower().rpartition("@")[2]
    return g.get("name") == "Your Name" or bool(g.get("email")) and any(
        dom == d or dom.endswith("." + d) for d in EXAMPLE_DOMAINS)


def profile_refs(profs):
    """scheme -> {ref: [(profile, field path)]} over the merged profiles' ref
    fields (env holds literals, so it is skipped)."""
    out = {}
    for name, prof in profs.items():
        body = {k: v for k, v in prof.items() if not str(k).startswith("_") and k != "env"}
        for path, ref in iter_refs(body):
            out.setdefault(ref_scheme(ref), {}).setdefault(ref, []).append((name, path))
    return out


def some(uses):
    """profiles.x.field, or profiles.x.field and N more, for a list of (profile, path)."""
    first = f"profiles.{uses[0][0]}.{uses[0][1]}"
    return first + (f" and {len(uses) - 1} more" if len(uses) > 1 else "")


def ref_checks(profs, refs, logins):
    """doctor: are the gh: accounts the manifest names logged in, do its aws
    profiles exist, can its keychain: and cmd: refs run here? Local lookups
    only: no secret is read and nothing goes over the network."""
    out = []
    have = {(h.lower(), u.lower()) for h, u in logins or ()}
    for ref, uses in sorted(refs.get("gh", {}).items()):
        user, host = REF_RES["gh"].match(ref).groups()
        host = host or "github.com"
        if logins is not None and (host.lower(), user.lower()) not in have:
            own = next((n for n, path in uses if path == "github.auth"), None)
            fix = f"actas login {own} --module github" if own else f"gh auth login --hostname {host}"
            out.append(("refs", "warn", f"{ref} ({some(uses)}) is not an account logged in to gh "
                                        f"on {host}; run: {fix}"))
    known, missing = {}, {}
    for name, prof in profs.items():
        a = prof.get("aws")
        if not isinstance(a, dict) or not a.get("profile"):
            continue
        env = child_env(assemble(prof, want_secrets=False))     # the profile's own AWS_CONFIG_FILE
        files = (env.get("AWS_CONFIG_FILE") or str(HOME / ".aws" / "config"),
                 env.get("AWS_SHARED_CREDENTIALS_FILE") or str(HOME / ".aws" / "credentials"))
        if files not in known:
            known[files] = aws_profile_names(files[0]) | aws_profile_names(files[1])
        if a["profile"] not in known[files]:
            missing.setdefault((a["profile"], files), []).append(name)
    for (pr, files), names in missing.items():
        out.append(("refs", "warn", f"aws profile {pr} ({', '.join(names)}) is not in {tilde(files[0])} "
                                    f"or {tilde(files[1])}" + did_you_mean(pr, known[files])
                                    + f"; create it with: aws configure sso --profile {pr}"))
    kc = [u for uses in refs.get("keychain", {}).values() for u in uses]
    if kc and sys.platform != "darwin":
        out.append(("refs", "warn", f"keychain: refs ({some(kc)}) need macOS; "
                                    "here use an op://, sops: or cmd: ref"))
    elif kc and not find_bin("security"):
        out.append(("refs", "warn", f"security not found (needed for keychain: refs, {some(kc)})"))
    for ref, uses in sorted(refs.get("cmd", {}).items()):
        with suppress(ValueError, IndexError, TypeError):
            exe = json.loads(ref[4:])[0]
            found = (os.path.isfile(exe) and os.access(exe, os.X_OK)) if "/" in exe else find_bin(exe)
            if not found:
                out.append(("refs", "warn", f"{exe} not found (needed for the cmd: ref in {some(uses)})"))
    return out


def cmd_doctor(a):
    checks = []

    def add(name, status, detail):
        checks.append({"name": name, "status": status, "detail": detail})

    profs = {}
    if not MANIFEST.exists():
        add("manifest", "error", f"missing: {MANIFEST} (run: actas init)")
    else:
        cfg = load(strict=False, quiet=True)
        probs, profs = manifest_checks(cfg)
        levels = [lvl for lvl, _, _ in probs.items]
        status = ("error" if "error" in levels else "warn" if "warning" in levels else "ok")
        summary = (f"{MANIFEST}: version {cfg.version}, {len(cfg.profiles)} profiles, "
                   f"{len(cfg.roles)} roles")
        add("manifest", status, [{"path": p, "level": lvl, "message": fmt_problem(p, m)}
                                 for lvl, p, m in probs.items] or summary)
        if status != "ok":
            checks[-1]["summary"] = summary
    # What the manifest needs here: a missing tool for a ref in use is a warning.
    refs = profile_refs(profs)
    uses = {s: [u for us in refs.get(s, {}).values() for u in us] for s in ("sops", "gh", "op")}
    uses["aws"] = [(n, "aws.profile") for n, pr in profs.items()
                   if isinstance(pr.get("aws"), dict) and pr["aws"].get("profile")]
    for t in ("codex", "gemini"):
        uses[t] = [(n, "tool") for n, pr in profs.items() if pr.get("tool") == t]

    def needed(why, scheme):
        return f"needed for {why}, e.g. {some(uses[scheme])}" if uses.get(scheme) else f"needed for {why}"

    if SECRETS.exists() or not uses["sops"]:
        add("secrets", "ok" if SECRETS.exists() else "optional-missing",
            str(SECRETS) if SECRETS.exists() else f"{SECRETS} (needed only for sops: refs)")
    else:
        add("secrets", "warn", f"{SECRETS} is missing ({needed('sops: refs', 'sops')}; "
                               "the first `actas secret set sops:<group>/<key>` creates it)")
    for tool, why in (("claude", "actas run"), ("aws", "aws: blocks"), ("gh", "gh: accounts"),
                      ("sops", "sops: refs"), ("age", "creating age keys"),
                      ("op", "op:// refs"), ("codex", "tool: codex"), ("gemini", "tool: gemini")):
        if tool in ("op", "codex", "gemini") and not uses[tool]:
            continue                                # listed only when the manifest uses them
        p = find_bin(tool)
        add(tool, "ok" if p else ("warn" if tool == "claude" or uses.get(tool) else "optional-missing"),
            p or f"not installed ({needed(why, tool)})")
    key, sops_cfg, uses_age = age_key_file(), ROOT / ".sops.yaml", True
    with suppress(OSError):         # sops may decrypt with another key type (PGP, KMS)
        uses_age = not sops_cfg.exists() or "age" in sops_cfg.read_text(errors="replace")
    if key or not (uses["sops"] and uses_age):
        add("age key", "ok" if key else "optional-missing", key or "none (needed for sops: refs)")
    else:
        add("age key", "warn", f"none ({needed('sops: refs', 'sops')}; "
                               "create one: age-keygen -o ~/.config/sops/age/keys.txt)")
    logins = gh_logins(gh_own_env())       # the user's own gh accounts, also inside a session
    if logins is not None:
        accts = list(dict.fromkeys(u for _, u in logins))
        add("gh accts", "ok" if accts else "warn", ", ".join(accts) or "none logged in")
    portals = aws_portals()
    add("aws sso", "ok", f"{len(portals)} SSO logins, {sum(len(v) for v in portals.values())} profiles")
    if MANIFEST.exists() and not cfg.problems.errors():
        for name, status, detail in ref_checks(profs, refs, logins):
            add(name, status, detail)
            if detail.startswith("gh:"):        # a referenced account is not logged in
                for c in checks:
                    if c["name"] == "gh accts":
                        c["status"] = "warn"
        idents = {}
        for n, pr in profs.items():
            g = section(pr, "git")
            if placeholder_git(g):
                idents.setdefault((g.get("name"), g.get("email")), []).append(n)
        for (gname, email), names in idents.items():
            add("identity", "warn", f"git identity {gname or '?'} <{email or '?'}> in {', '.join(names)} "
                f"is a placeholder (an example address): commits there would use it; edit {tilde(MANIFEST)}")
        bare = [n for n, pr in profs.items() if "aws" not in pr and ("aws",) not in pr["_nulled"]]
        creds = os.environ.get("AWS_SHARED_CREDENTIALS_FILE") or str(HOME / ".aws" / "credentials")
        where = [tilde(f) for f in (os.environ.get("AWS_CONFIG_FILE") or str(HOME / ".aws" / "config"), creds)
                 if any(x["_name"] == "default" for x in aws_sections(f))]
        if bare and where:
            add("aws default", "warn", f"{' and '.join(where)} {'has' if len(where) == 1 else 'have'} a [default] profile, and "
                f"{', '.join(bare)} set no aws, so the aws CLI falls back to it there"
                + ("" if cfg.version == 2 else " unless your shell exports AWS_PROFILE (v1 files keep it)")
                + "; add `aws: null`" + (" after actas migrate" if cfg.version == 1 else ""))
        if "gemini" in referenced(cfg)[0] or any(profile_tool(cfg, n) == "gemini" for n in cfg.profiles):
            here, found = Path(expand(a.cwd or os.getcwd())), []
            for d in [here] + list(here.parents):
                found += [str(f) for f in (d / ".gemini" / ".env", d / ".env") if f.is_file()]
                if d == HOME:
                    break
            if found:
                add("gemini env", "warn", f"Gemini CLI loads {', '.join(tilde(f) for f in found)}; "
                                          "values there can override the profile's")
    if a.fix:      # only tightens modes of actas-owned directories (SPEC 1, D30)
        homes = [h for k in sorted(HOME_CRED) for h in sorted((STATE / "homes" / k).glob("*"))]
        for d in [ROOT, CACHE, STATE, STATE / "homes", STATE / "sessions"] + homes:
            try:
                if d.is_dir() and not d.is_symlink() and d.stat().st_mode & 0o077:
                    os.chmod(str(d), 0o700)
                    add("fixed", "ok", f"chmod 700 {tilde(d)}")
            except OSError as e:
                add("fixed", "warn", f"{tilde(d)}: {e.strerror}")
    for mod in sorted(OFF_CRED):
        off = STATE / "homes" / mod / "_off"
        if off_logins(off):
            add("off homes", "error", f"{tilde(off)} must stay empty but holds a login "
                f"({', '.join(off_logins(off))}): every {mod}: null or fail-closed profile uses it. "
                f"Remove it (`actas run`/`exec`/`sync` move it aside) and log in in a named {mod}.home")
    with suppress(OSError):
        if ROOT.is_dir() and ROOT.stat().st_mode & 0o077:
            add("config dir", "warn", f"{ROOT} is readable by others (chmod 700 {tilde(ROOT)})")
    for what, base in (("config dir", HOME / ".config"), ("state dir", XDG_STATE)):
        old, new = base / "ccenv", base / "actas"            # legacy: the pre-rename places
        if old.is_dir() and legacy_dir(base) == old:
            add(what, "info", f"using {tilde(old)} from before the rename to actas; it keeps working. "
                f"To move it (with no actas or ccenv session open): mv {tilde(old)} {tilde(new)}")
        elif old.is_dir():
            add(what, "info", f"{tilde(old)} is from before the rename and is no longer read "
                f"(actas uses {tilde(new)}); delete it once nothing there is needed")
    # Legacy: after the rename, hook text, agent rules and refusals call `actas`.
    if not shutil.which("actas"):
        how = (f"link it into a directory on PATH, e.g. ln -s {tilde(Path(__file__).resolve())} ~/.local/bin/actas"
               if BUILD != "package" else "reinstall the package (docs/migration.md, Coming from ccenv)")
        add("actas cmd", "warn", "the actas command is not on PATH, but the SessionStart note, agent "
            f"instructions and refusals tell agents and you to run it; {how}")
    # Legacy: a ccenv skill linked to a checkout dangles after the pull that
    # renamed skills/ccenv, and a copied one looks for the old stop marker.
    # Without a checkout next to this file (uv/pipx, install.sh), `actas setup skill` installs it.
    skills = Path(__file__).resolve().parent.parent / "skills" / "actas"
    for base in dict.fromkeys(Path(d) / "skills" for d in (HOME / ".claude", os.environ.get("CLAUDE_CONFIG_DIR"))
                              if d):
        old = base / "ccenv"
        rm = f"rm {tilde(old)}" if old.is_symlink() else f"rm -r {tilde(old)}"
        add_new = (f"ln -s {tilde(skills)} {tilde(base / 'actas')}" if (skills / "SKILL.md").is_file()
                   else f"actas setup skill --dir {tilde(base)}")
        fix = (f"remove it ({tilde(base / 'actas')} is installed): {rm}" if (base / "actas").exists()
               else f"replace it: {rm} && {add_new}")
        with suppress(OSError):
            cur = base / "actas" / "SKILL.md"
            if (not cur.parent.is_symlink() and cur.is_file() and "\nname: actas\n" in cur.read_text()
                    and cur.read_text() != SKILLS["actas"]):
                add("skill", "info", f"{tilde(cur)} is a copy from another actas version; refresh it: "
                    f"actas setup skill --dir {tilde(base)}")
        with suppress(OSError):
            if old.is_symlink() and not old.exists():
                add("skill", "warn", f"{tilde(old)} links to {os.readlink(str(old))}, which no longer exists "
                    f"(the skill is skills/actas since the rename), so Claude Code skips it; {fix}")
            elif (old / "SKILL.md").is_file() and "ccenv-stop:" in (old / "SKILL.md").read_text(errors="replace"):
                add("skill", "warn", f"{tilde(old)} is the ccenv skill from before the rename and looks for "
                    f"ccenv-stop:, which actas no longer prints; {fix}")
    if MANIFEST.exists() and not cfg.problems.errors():
        name = locate(cfg)[0]
        res = assemble(profs[name], want_secrets=False) if name in profs else None
        gone = [k for k in res["scrubbed"] if k not in res["secret"]] if res else []   # refs are replaced
        if gone:
            keep = (["`aws: inherit`"] if set(gone) & names_in(OWNS["aws"], gone) else []) + ["`inherit: [VAR]`"]
            add("shell", "info", f"actas run here ({name}) clears from this shell: {', '.join(gone)} "
                f"(keep them with {' or '.join(keep)}" + (" after actas migrate)" if cfg.version == 1 else ")"))
    ledger = load_ledger()
    stale = [f for f, e in ledger.items() if isinstance(e, dict) and missing_helpers(e)]
    if ledger:
        add("sync", "warn" if stale else "ok",
            f"helper path in {', '.join(stale)} no longer exists; run actas sync" if stale
            else f"{len(ledger)} synced files ({tilde(LEDGER)})")
    gl = global_routing()
    if gl:
        add("claude cfg", "info", f"~/.claude/settings.json sets {', '.join(gl)}: applies to "
                                  "every project not covered by `actas sync`")
    bad = {"error"} | ({"warn"} if a.strict else set())
    ok = not any(c["status"] in bad for c in checks)
    if a.json:
        print(json.dumps({"ok": ok, "warnings": WARNINGS, "checks": checks}, indent=2))
    else:
        colour = {"ok": "green", "warn": "yellow", "error": "red"}
        for c in checks:
            many = isinstance(c["detail"], list)
            print(f"{paint(format(c['name'], '<11'), 'bold')} {paint(c['status'], colour.get(c['status'], 'dim'))}"
                  f"  {c.get('summary', '') if many else c['detail']}")
            for d in c["detail"] if many else []:
                print(f"            {d['level']:<7} {d['message']}")
    if not ok:
        sys.exit(1)


# =================================================================== migrate

_PLAIN_KEY = re.compile(r"^[A-Za-z_][A-Za-z0-9_.-]*$")
_YAML_WORDS = {"y", "n", "yes", "no", "on", "off", "true", "false", "null", "~"}


def yaml_key(k):
    k = str(k)
    return k if _PLAIN_KEY.match(k) and k.lower() not in _YAML_WORDS else json.dumps(k)


def emit_yaml(obj, indent=0):
    """A tiny block emitter: maps in block style, scalar lists in flow style,
    every scalar quoted with json.dumps (so YAML 1.1 never reinterprets it)."""
    pad, lines = "  " * indent, []
    for k, v in obj.items():
        if isinstance(v, dict) and v:
            lines.append(f"{pad}{yaml_key(k)}:")
            lines += emit_yaml(v, indent + 1)
        elif isinstance(v, dict):
            lines.append(f"{pad}{yaml_key(k)}: {{}}")
        elif isinstance(v, list):
            if all(not isinstance(x, (dict, list)) for x in v):
                lines.append(f"{pad}{yaml_key(k)}: [{', '.join(json.dumps(x, ensure_ascii=False) for x in v)}]")
            else:
                lines.append(f"{pad}{yaml_key(k)}:")
                for x in v:
                    lines.append(f"{pad}  - {json.dumps(x)}")
        else:
            lines.append(f"{pad}{yaml_key(k)}: {json.dumps(v, ensure_ascii=False)}")
    return lines


def migrated_doc(cfg):
    """The translated v1 document minus the internal compat flags. An
    environment without aws gets `aws: inherit`: v1 left the shell's AWS_*
    alone there, and v2 would clear them (R11)."""
    profiles = {}
    for name, body in cfg.profiles.items():
        b = copy.deepcopy(body)
        if b.get("permissions") == {"builtin": False}:
            del b["permissions"]
        if "aws" not in b:
            b["aws"] = "inherit"
        profiles[name] = b
    return {"version": 2, "profiles": profiles}


def migrate_notes(doc):
    notes = [
        "after switching to version 2:",
        "  - built-in agent rules apply (each profile's level preset); "
        "add `permissions: {builtin: false}` to a profile to keep v1's none",
        "  - parent-shell variables of every module the manifest references are cleared "
        "(keep them with `aws: inherit` or `inherit: [VAR]`)",
        "  - GitHub token auth fails closed: gh cannot fall back to the keyring's active "
        "account (use github.home to keep gh's own config)",
        "  - boolean env values become errors: quote them",
        "  - comments in the v1 file are not carried over",
    ]
    if any(section(b, "claude").get("export_token") for b in doc["profiles"].values()):
        notes.append("  - gateway tokens stay exported (claude.export_token: true); remove it to "
                     "rely on apiKeyHelper only")
    blocks = {}
    for name, b in doc["profiles"].items():
        if b.get("claude"):
            blocks.setdefault(json.dumps(b["claude"], sort_keys=True), []).append(name)
    for names in blocks.values():
        if len(names) > 1:
            notes.append(f"suggestion: {', '.join(names)} share one claude block; move it to a "
                         "role (roles: {corp-gateway: {claude: ...}}) and `use:` it")
    no_aws = [n for n, b in doc["profiles"].items() if b.get("aws") == "inherit"]
    if no_aws:
        notes.append(f"suggestion: {', '.join(no_aws)} had no aws block, so v1 kept the shell's "
                     "AWS_PROFILE there; `aws: inherit` keeps that. Change it to `aws: null` to "
                     "isolate them (an empty AWS config, no fallback to [default])")
    return notes


def cmd_migrate(a):
    if a.write:
        require_human("migrate")
    cfg = load()
    if cfg.version == 2:
        info(f"{MANIFEST} is already version 2; nothing to do")
        return
    doc = migrated_doc(cfg)
    if yaml_available():
        text = ("# actas manifest, version 2 (converted from v1 by `actas migrate`).\n"
                "# Secrets keep their v1 sops paths: \"sops:<environment>/<key>\".\n"
                + "\n".join(emit_yaml(doc)) + "\n")
    else:
        text = json.dumps(doc, indent=2) + "\n"   # no YAML parser here: stay readable
    try:
        check = build_config(parse_text(text, "migrated manifest"))
    except ManifestError as e:
        die(f"internal error: {e}")
    if check.problems.errors():
        die("internal error: the migrated manifest does not validate: "
            + "; ".join(fmt_problem(p, m) for _, p, m in check.problems.errors()))
    backup = ROOT / "environments.v1.yaml"
    if not a.write:
        sys.stdout.write(text)
    elif backup.exists():
        die(f"{backup} exists; move it away first")
    else:
        shutil.copy2(str(MANIFEST), str(backup))
        write_private(MANIFEST, text)
        print(f"{paint('wrote', 'green')} {MANIFEST}  (old file: {backup})")
    for line in migrate_notes(doc):
        info(line)
    if not a.write:
        info("write it with: actas migrate --write (keeps the old file as environments.v1.yaml)")


# ======================================================================= cli

HIDDEN = {"git-credential", "hook"}
EVERYDAY = ("init", "run", "exec", "status", "list", "login", "sync", "doctor")   # SPEC 0.1.3
ADVANCED = ("shell", "secret", "desktop", "instructions", "setup", "migrate", "aws-handoff", "completion")
DOCS = "https://github.com/TsenkoTsenkov/actas/blob/main/docs/"
HELP_TOPICS = {
    "manifest": f"""The manifest: {MANIFEST}  (full reference: {DOCS}manifest.md)

The four rules:
  1. Later layers win, maps merge: defaults, then each role in use:, then the profile.
  2. null means off: the tool sees no account (aws: null gives aws an empty config).
  3. Compose upward: a profile is at least as privileged as anything it uses.
  4. A secret is always scheme:path (sops:, keychain:, op://, gh:, cmd:).

A minimal manifest:
  version: 2
  profiles:
    personal:
      match: ~/code/personal
      git:    {{ name: Ada Example, email: ada@example.com }}
      github: {{ auth: "gh:ada-personal" }}
      aws:    {{ profile: personal, region: eu-west-1 }}

Profile keys: description match use level confirm agents_may_use tool permissions
inherit unset env secret_env, the modules aws gcp azure github git and the tools
claude codex gemini. Roles (roles:) are reusable pieces combined with use: [...].
Check a manifest with `actas doctor`; see where a value comes from with `actas status --why`.""",
    "agents": f"""Agents (Claude Code, Codex, Gemini, ...) get the identity of the session they run in.
`actas run` starts one; `actas instructions` prints the rules below for AGENTS.md.
An agent may `actas exec` only its session profile or that profile's agents_may_use list
("*" for any; defaults: may set it for every profile), at the same or a lower level, never a
confirm profile. Anything else stops with a
`actas-stop:` line (exit 3) and text for the user to run in their own terminal.
Credentials are the boundary; these rules are a seatbelt. More: {DOCS}agents.md
""",
}


def version_text():
    """`actas --version`: the version, then which install runs: `package`
    (uv/pipx; plus the git commit when the install recorded one) or the git
    commit of a checkout (`+changes` when bin/actas differs from it). A
    copied single file (install.sh) prints the version alone."""
    extra = []
    if BUILD == "package":
        extra.append("package")
        with suppress(Exception):
            from importlib import metadata
            dist = metadata.distribution("actas")
            if Path(str(dist.locate_file("actas_cli.py"))).resolve() == Path(__file__).resolve():
                vcs = json.loads(dist.read_text("direct_url.json") or "{}").get("vcs_info") or {}
                if vcs.get("commit_id"):
                    extra.append(f"git {vcs['commit_id'][:7]}")
    else:
        here = Path(__file__).resolve().parent.parent
        commit = git_out(here, "rev-parse", "--short", "HEAD") if (here / ".git").exists() else None
        if commit:
            r = git(here, "diff", "--quiet", "HEAD", "--", "bin/actas")
            extra.append(f"git {commit}" + ("+changes" if r is not None and r.returncode == 1 else ""))
    return f"actas {__version__}" + (f" ({', '.join(extra)})" if extra else "")


class VersionAction(argparse.Action):
    """--version, computed only when asked (a checkout runs git)."""

    def __init__(self, option_strings, dest=argparse.SUPPRESS, default=argparse.SUPPRESS, help=None):
        super().__init__(option_strings, dest=dest, default=default, nargs=0, help=help)

    def __call__(self, parser, namespace, values, option_string=None):
        print(version_text())
        parser.exit()


class Parser(argparse.ArgumentParser):
    """Usage errors exit 2. At the top level (an unknown command) they show
    the full help menu; inside a known command, only that command's usage
    line and one hint (a did-you-mean, where `--` goes, or `actas help <cmd>`)."""
    cmd = None      # the subcommand a sub-parser handles; None at the top level

    def error(self, message, hint=None, full=None):
        if full is None:
            full = self.cmd is None
        if full:
            self.print_help(sys.stderr)
            print(file=sys.stderr)
        elif self.cmd:
            sys.stderr.write(self.format_usage())
        if hint is None and self.cmd and self.cmd not in HIDDEN:
            hint = f"more: actas help {self.cmd}"
        print(f"{paint('actas: error:', 'red', sys.stderr)} {message}"
              + (f"\n       {hint}" if hint else ""), file=sys.stderr)
        sys.exit(2)


def unknown_hint(sp, extra):
    """The one hint for arguments a known command does not take."""
    flag = next((x.split("=", 1)[0] for x in extra if x.startswith("-")), None)
    if flag:
        opts = [o for act in sp._actions if act.help != argparse.SUPPRESS
                for o in act.option_strings if o.startswith("--")]
        # run and exec: a stray flag is usually meant for the tool, so only a near miss counts
        close = difflib.get_close_matches(flag, opts, n=1, cutoff=0.8 if sp.cmd in ("run", "exec") else 0.75)
        if close:
            return f"did you mean: {close[0]}?"
    if sp.cmd == "exec":
        return "put the command after --  (actas exec <profile> -- aws s3 ls)"
    if sp.cmd == "run":
        return "arguments for the tool go after --  (actas run <profile> -- --resume)"
    return None


def manifest_names():
    """Profile names for a usage hint: never dies, warns, or leaves a
    half-validated manifest in the load cache."""
    try:
        return sorted(load(strict=False, quiet=True).profiles) if MANIFEST.exists() else []
    except (Exception, SystemExit):
        return []
    finally:
        _LOADED.clear()


def profile_word(p, argv, word, passthrough, dashdash):
    """`actas <profile> -- cmd` is `actas exec <profile> -- cmd` for a person.
    Inside an agent session it is a usage error pointing to exec, so an
    agent's switch is always spelled `actas exec` (the Switch ask rule)."""
    if dashdash and passthrough and not who()["agent"]:
        i = first_index(argv)
        return argv[:i] + ["exec"] + argv[i:]
    rest = shlex.join(passthrough) if passthrough else "<command>"
    p.error(f"{word!r} is a profile, not a command",
            f"did you mean: actas exec {word} -- {rest}"
            + ("  (agent sessions spell out exec)" if passthrough else f"  (or: actas run {word})"),
            full=False)


def short_help(sub):
    """`actas help` (SPEC 0.1.3): the everyday commands and one advanced line."""
    helps = {a.dest: a.help for a in sub._choices_actions}
    lines = ["usage: actas [--cwd DIR] [--no-color] [--version] <command> ...", "",
             (__doc__ or "").strip().splitlines()[0], "", "commands:"]
    lines += [f"  {c:<8} {helps.get(c) or ''}" for c in EVERYDAY]
    lines += ["", f"advanced: {' '.join(ADVANCED)} - actas help <cmd>",
              "more:     actas help manifest | agents; actas --help lists every option"]
    return "\n".join(lines)


def command_reference(sub):
    lines, seen = ["commands:"], set()
    for name, sp in sub.choices.items():
        if name in HIDDEN or id(sp) in seen:
            continue
        seen.add(id(sp))
        usage = " ".join(sp.format_usage().split()[1:])  # drop "usage:"
        usage = usage.replace(" [--cwd CWD]", "")
        lines.append(f"  {usage}")
        for act in sp._actions:
            if act.option_strings and act.dest not in ("help", "cwd") and act.help != argparse.SUPPRESS:
                lines.append(f"      {', '.join(act.option_strings):<16} {act.help or ''}")
    lines += [
        "",
        "examples:",
        "  actas run                     launch claude in the profile matching the cwd",
        "  actas run work -- --resume    pass arguments to claude after --",
        "  actas exec work -- aws s3 ls  run any command as profile work",
        "  actas work -- aws s3 ls       the same, shorter (not inside an agent session)",
        "  eval \"$(actas shell)\"        apply the profile to this shell",
        "  actas run --login             also refresh AWS SSO before starting",
        "  actas status --why            which profile applies here, and why",
        "  actas login work              refresh AWS SSO for one profile",
        "  actas --cwd ~/code/x shell    print the env vars for another directory",
        "  actas list --check            show profiles and auth status",
        "  actas help <command>          detailed help for one command",
        "  eval \"$(actas completion zsh)\" tab completion (bash, zsh, fish)",
    ]
    return "\n".join(lines)


def completion_spec(sub):
    """Each public command as (names, help, options, positional), read from
    the parser. An option is (flags, help, value, repeatable) with value None
    (a switch), a tuple of choices, "dir" or "" (free text); positional is
    "profile", a tuple of words, or None."""
    helps = {a.dest: a.help for a in sub._choices_actions}
    spec, seen = [], {}
    for name, sp in sub.choices.items():
        if name in HIDDEN:
            continue
        if id(sp) in seen:                    # an alias (whoami)
            seen[id(sp)][0].append(name)
            continue
        opts, pos = [], None
        for act in sp._actions:
            if act.help == argparse.SUPPRESS:
                continue
            if act.option_strings:
                value = (None if act.nargs == 0 else tuple(act.choices) if act.choices
                         else "dir" if act.dest == "cwd" else "")
                opts.append((act.option_strings, act.help or "", value, isinstance(act, argparse._AppendAction)))
            elif pos is None:
                pos = ("profile" if act.metavar == "profile" else tuple(act.choices) if act.choices else None)
        if name == "help":
            pos = tuple(c for c in sub.choices if c not in HIDDEN) + tuple(HELP_TOPICS)
        seen[id(sp)] = ([name], helps.get(name) or "", opts, pos)
        spec.append(seen[id(sp)])
    return spec


TOP_OPTS = [(["--cwd"], "resolve the profile as if from this directory", "dir", False),
            (["--no-color"], "no ANSI colours", None, False),
            (["--version"], "show the version", None, False),
            (["-h", "--help"], "show help", None, False)]


def completion_script(sub, shell):
    """`actas completion bash|zsh|fish`: profile names come from
    `actas list --names` at completion time, so nothing goes stale."""
    spec = completion_spec(sub)
    value_opts = sorted({f for _, _, opts, _ in spec for fl, _, v, _ in opts if v is not None for f in fl})
    return {"bash": bash_completion, "zsh": zsh_completion, "fish": fish_completion}[shell](spec, value_opts)


def bash_completion(spec, value_opts):
    cases = []
    for names, _, opts, pos in spec:
        body = [f"opts='{' '.join(f for fl, _, _, _ in opts for f in fl)}'"]
        body += [f"case $prev in {'|'.join(fl)}) COMPREPLY=($(compgen -W '{' '.join(v)}' -- \"$cur\")); "
                 "return 0 ;; esac" for fl, _, v, _ in opts if isinstance(v, tuple)]
        body += ["prof=1"] if pos == "profile" else [f"words='{' '.join(pos)}'"] if pos else []
        cases.append(f"        {'|'.join(names)})\n" + "\n".join(f"            {b}" for b in body) + " ;;")
    commands = " ".join(n for names, _, _, _ in spec for n in names)
    return f"""\
# actas completion for bash: add  eval "$(actas completion bash)"  to ~/.bashrc
_actas() {{
    local cur=${{COMP_WORDS[COMP_CWORD]}} prev=${{COMP_WORDS[COMP_CWORD-1]}}
    local i w cmd= npos=0 skip=0 opts= words= prof=0
    COMPREPLY=()
    for ((i = 1; i < COMP_CWORD; i++)); do
        w=${{COMP_WORDS[i]}}
        if ((skip)); then skip=0; continue; fi
        case $w in
            --) if ((i == COMP_CWORD - 1)); then COMPREPLY=($(compgen -c -- "$cur")); fi
                return 0 ;;
            {'|'.join(value_opts)}) skip=1 ;;
            -*) ;;
            *) if [[ -z $cmd ]]; then cmd=$w; else npos=$((npos + 1)); fi ;;
        esac
    done
    case $cmd in
        '') opts='{' '.join(f for fl, _, _, _ in TOP_OPTS for f in fl)}'; words='{commands}' ;;
{chr(10).join(cases)}
        *) return 0 ;;
    esac
    case $prev in
        --cwd) COMPREPLY=($(compgen -d -- "$cur")); return 0 ;;
        {'|'.join(value_opts)}) return 0 ;;
    esac
    if [[ $cur == -* ]]; then
        COMPREPLY=($(compgen -W "$opts" -- "$cur"))
    elif ((npos == 0)); then
        if ((prof)); then words=$("${{COMP_WORDS[0]}}" list --names 2>/dev/null); fi
        COMPREPLY=($(compgen -W "$words" -- "$cur"))
    fi
    return 0
}}
complete -o default -F _actas actas
"""


def zsh_quote(s):
    return "'" + s.replace("'", "'\\''") + "'"


def zsh_option(flags, text, value, repeat):
    desc = text.replace("\\", "\\\\").replace("[", "\\[").replace("]", "\\]").replace(":", "\\:")
    arg = ("" if value is None else f":{flags[-1].lstrip('-')}:({' '.join(value)})" if isinstance(value, tuple)
           else ":directory:_files -/" if value == "dir" else ":value: ")
    rest = f"[{desc}]{arg}"
    star = "*" if repeat else ""
    if len(flags) == 1:
        return zsh_quote(f"{star}{flags[0]}{rest}")
    return zsh_quote(f"{star}({' '.join(flags)})") + "{" + ",".join(flags) + "}" + zsh_quote(rest)


def zsh_completion(spec, value_opts):
    commands = [zsh_quote(f"{n}:{text}") for names, text, _, _ in spec for n in names]
    cases = []
    for names, _, opts, pos in spec:
        args = [zsh_option(*o) for o in opts]
        if pos == "profile":
            args.append(zsh_quote("1:profile:_actas_profiles"))
        elif pos:
            args.append(zsh_quote(f"1:word:({' '.join(pos)})"))
        cases.append(f"        ({'|'.join(names)})\n          _arguments \\\n"
                     + " \\\n".join(f"            {x}" for x in args) + " && ret=0 ;;")
    top = " \\\n".join(f"    {zsh_option(*o)}" for o in TOP_OPTS)
    return f"""\
#compdef actas
# actas completion for zsh: add  eval "$(actas completion zsh)"  to ~/.zshrc, after compinit
# (or save the output as _actas in a directory on $fpath).
_actas_profiles() {{
  local -a profiles
  profiles=(${{(f)"$(_call_program profiles ${{(q)_actas_bin}} list --names 2>/dev/null)"}})
  _describe -t profiles profile profiles
}}

_actas() {{
  local _actas_bin=${{words[1]}} curcontext=$curcontext state state_descr line ret=1 i
  typeset -A opt_args
  local -a commands
  commands=(
{chr(10).join(f"    {c}" for c in commands)}
  )
  _arguments -C \\
{top} \\
    '1: :->command' \\
    '*:: :->args' && ret=0
  case $state in
    (command) _describe -t commands 'actas command' commands && ret=0 ;;
    (args)
      for (( i = 2; i < CURRENT; i++ )); do
        if [[ ${{words[i]}} == -- ]]; then
          shift $i words
          (( CURRENT -= i ))
          _normal && ret=0
          return ret
        fi
      done
      curcontext=${{curcontext%:*:*}}:actas-${{words[1]}}:
      case ${{words[1]}} in
{chr(10).join(cases)}
      esac ;;
  esac
  return ret
}}

if [[ ${{funcstack[1]}} == _actas ]]; then _actas "$@"; else compdef _actas actas; fi
"""


def fish_completion(spec, value_opts):
    lines = []
    for flags, text, value, _ in TOP_OPTS:
        lines.append(fish_line("__actas_using -", flags, text, value))
    for names, text, _, _ in spec:
        lines += [f"complete -c actas -n '__actas_using -' -a {n} -d {fish_quote(text)}" for n in names]
    for names, _, opts, pos in spec:
        using = "__actas_using " + " ".join(names)
        lines += [fish_line(using, *o[:3]) for o in opts]
        if pos == "profile":
            lines.append(f"complete -c actas -n '__actas_slot {' '.join(names)}' -a '(__actas_profiles)'")
        elif pos:
            lines.append(f"complete -c actas -n '__actas_slot {' '.join(names)}' -a {fish_quote(' '.join(pos))}")
    return f"""\
# actas completion for fish:
#   actas completion fish > ~/.config/fish/completions/actas.fish
function __actas_state --description 'actas: the command (- for none) and its positional count'
    set -l cmd -
    set -l npos 0
    set -l skip 0
    set -l first 1
    for t in (commandline -opc)
        if test $first = 1
            set first 0
        else if test $skip = 1
            set skip 0
        else
            switch $t
                case --
                    return 1
                case {' '.join(value_opts)}
                    set skip 1
                case '-*'
                case '*'
                    if test "$cmd" = -
                        set cmd $t
                    else
                        set npos (math $npos + 1)
                    end
            end
        end
    end
    echo $cmd
    echo $npos
end

function __actas_using --description 'actas: the command is one of these (- for none yet)'
    set -l s (__actas_state); or return 1
    contains -- $s[1] $argv
end

function __actas_slot --description "actas: completing one of these commands' first positional"
    set -l s (__actas_state); or return 1
    contains -- $s[1] $argv; and test $s[2] = 0
end

function __actas_profiles
    set -l bin (commandline -opc)
    $bin[1] list --names 2>/dev/null
end

function __actas_after_dd
    contains -- -- (commandline -opc)
end

function __actas_dd_complete --description 'actas: complete the command after --'
    set -l rest
    set -l seen 0
    for t in (commandline -opc)
        if test $seen = 1
            set -a rest $t
        else if test "$t" = --
            set seen 1
        end
    end
    complete -C (string join ' ' -- (string escape -- $rest) (commandline -ct))
end

complete -c actas -f
complete -c actas -n __actas_after_dd -a '(__actas_dd_complete)'
{chr(10).join(lines)}
"""


def fish_line(cond, flags, text, value):
    parts = [f"complete -c actas -n '{cond}'"]
    parts += [f"-s {f[1:]}" if not f.startswith("--") else f"-l {f[2:]}" for f in flags]
    if isinstance(value, tuple):
        parts.append(f"-x -a {fish_quote(' '.join(value))}")
    elif value == "dir":
        parts.append("-x -a '(__fish_complete_directories)'")
    elif value == "":
        parts.append("-x")
    return " ".join(parts + [f"-d {fish_quote(text)}"])


def first_index(argv):
    """The subcommand token's index, skipping global options (or None)."""
    i = 0
    while i < len(argv):
        if not argv[i].startswith("-"):
            return i
        i += 2 if argv[i] == "--cwd" else 1
    return None


def first_word(argv):
    """The subcommand token, skipping global options."""
    i = first_index(argv)
    return None if i is None else argv[i]


class SubFormatter(argparse.HelpFormatter):
    """A command's help: the description is wrapped, the examples epilog is
    printed as written."""

    def _fill_text(self, text, width, indent):
        if text.startswith("examples:"):
            return "".join(indent + line for line in text.splitlines(keepends=True))
        return super()._fill_text(text, width, indent)


def build_parser():
    p = Parser(prog="actas", description=__doc__,
               formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--cwd", help="resolve the profile as if from this directory")
    p.add_argument("--version", action=VersionAction,
                   help="show the version and the install (package, or a checkout's git commit)")
    p.add_argument("--no-color", action="store_true", help="no ANSI colours (also: NO_COLOR=1)")
    sub = p.add_subparsers(dest="cmd", required=True, metavar="<command>")

    # --cwd and --no-color are accepted after the command too (`actas run
    # --cwd DIR`). SUPPRESS keeps the subcommand default from clobbering a
    # value given before the command.
    cwd_opt = argparse.ArgumentParser(add_help=False)
    cwd_opt.add_argument("--cwd", default=argparse.SUPPRESS,
                         help="resolve the profile as if from this directory")
    cwd_opt.add_argument("--no-color", action="store_true", default=argparse.SUPPRESS, help=argparse.SUPPRESS)
    _add = sub.add_parser

    def add_parser(name, examples=(), **k):
        """A command: its help shows a description and a few examples."""
        sp = _add(name, parents=[cwd_opt], formatter_class=SubFormatter,
                  epilog=("examples:\n" + "\n".join(f"  {e}" for e in examples)) if examples else None, **k)
        sp.cmd = name
        return sp
    sub.add_parser = add_parser
    by_cwd = "profile name (default: the one matching the cwd)"
    by_session = "profile name (default: an agent's session profile, else the one matching the cwd)"

    i = sub.add_parser("init", help="create the config directory and a starter manifest",
                       description=f"Create the config directory ({tilde(ROOT)}) with a starter manifest. "
                                   "Never overwrites an existing manifest.",
                       examples=("actas init", "actas doctor                  check what init wrote"))
    i.set_defaults(fn=cmd_init)

    r = sub.add_parser("run", help="launch Claude Code (or the profile's tool) in a profile",
                       usage="actas run [profile] [-t TOOL] [--login] [--no-check] [-- tool args...]",
                       description="Launch Claude Code, or the profile's tool (codex, gemini), with the "
                                   "profile's identity and agent rules. Arguments after -- go to the tool.",
                       examples=("actas run                     the profile matching this directory",
                                 "actas run work -- --resume    pass --resume to claude",
                                 "actas run work -t codex       launch codex instead"))
    r.add_argument("env", nargs="?", metavar="profile", help=by_session)
    r.add_argument("-t", "--tool", choices=TOOL_NAMES, help="launch this tool instead of the profile's")
    r.add_argument("--login", action="store_true",
                   help="refresh this profile's AWS SSO first if expired (default: only warn)")
    r.add_argument("--no-check", "--no-login", dest="no_check", action="store_true",
                   help="skip the expired-credentials check")
    r.set_defaults(fn=cmd_run)

    ex = sub.add_parser("exec", help="run any command with a profile's identity: exec [profile] -- cmd",
                        usage="actas exec [profile] [--reason TEXT] [--json] -- command [args...]",
                        description="Run one command with a profile's identity and return its exit code. "
                                    "In your own terminal, `actas <profile> -- cmd` is short for "
                                    "`actas exec <profile> -- cmd`.",
                        examples=("actas exec work -- aws s3 ls",
                                  "actas work -- terraform plan  the same shorthand",
                                  'actas exec prod --reason "read the plan" -- terraform show'))
    ex.add_argument("env", nargs="?", metavar="profile", help=by_session)
    ex.add_argument("--reason", help="why the command needs this profile (shown on a refusal)")
    ex.add_argument("--json", action="store_true", help="machine-readable refusals")
    ex.set_defaults(fn=cmd_exec)

    st = sub.add_parser("status", aliases=["whoami"], help="which profile applies, and what it sets",
                        description="Show which profile applies here (the session's, else the one matching "
                                    "the directory) and what it sets. Never prints secret values.",
                        examples=("actas status", "actas status work --why       where each value comes from",
                                  "actas status --json           for scripts and agents"))
    st.add_argument("env", nargs="?", metavar="profile",
                    help="profile name (default: this session's, else the one matching the cwd)")
    st.add_argument("--why", action="store_true", help="show the use: chain and where each value comes from")
    st.add_argument("--probe", action="store_true", help="also check each login (aws, gcp, azure, github)")
    st.add_argument("--json", action="store_true", help="machine-readable output")
    st.set_defaults(fn=cmd_status)

    l = sub.add_parser("list", help="list profiles",  # noqa: E741
                       description="List the profiles, one line each, and the roles. A * after a name "
                                   "marks the profile matching this directory, a + this session's profile.",
                       examples=("actas list", "actas list --check            also probe AWS and secrets",
                                 "actas list --names            one name per line, for scripts"))
    l.add_argument("--check", action="store_true", help="also probe AWS logins and gateway tokens")
    l.add_argument("--json", action="store_true", help="machine-readable output")
    l.add_argument("--names", action="store_true", help="only the profile names, one per line")
    l.set_defaults(fn=cmd_list)

    s = sub.add_parser("shell", help="print the profile's environment (export lines for eval)",
                       description="Print a profile's environment for eval, fish, direnv, JSON or a GUI "
                                   "app's env setting. With secrets it is human-only.",
                       examples=('eval "$(actas shell)"', "actas shell work --format fish | source",
                                 "actas shell --format env --no-secrets"))
    s.add_argument("env", nargs="?", metavar="profile", help=by_cwd)
    s.add_argument("--format", choices=("sh", "fish", "direnv", "json", "env"), default="sh",
                   help="sh (default), fish, direnv, json, or env (KEY=value, no secrets)")
    s.add_argument("--no-secrets", action="store_true", help="leave secret values out (git helpers stay)")
    s.set_defaults(fn=cmd_shell)

    lo = sub.add_parser("login", help="log in to a profile's accounts (default: AWS SSO, Codex)",
                        description="Log in to a profile's accounts: AWS SSO by default, plus Codex for "
                                    "Codex profiles. Human-only.",
                        examples=("actas login work", "actas login work --module github",
                                  "actas login --all              one AWS login per SSO portal"))
    lo.add_argument("env", nargs="?", metavar="profile", help=by_cwd)
    lo.add_argument("--all", action="store_true",
                    help="one AWS login per SSO session or portal used by any profile; "
                         "exits 1 if any login fails")
    lo.add_argument("--module", action="append", choices=tuple(LOGIN_BINS),
                    help="log in to this module (repeatable)")
    lo.add_argument("--adc", action="store_true", help="gcp: also application-default login")
    lo.set_defaults(fn=cmd_login)

    se = sub.add_parser("secret", help="read or write a secret",
                        usage="actas secret set REF | actas secret --ref REF | actas secret ENV KEY [--set]",
                        description="Store a secret (prompted, or piped on stdin) or print one; the helpers "
                                    "in synced settings files use the printing form. Storing is human-only.",
                        examples=("actas secret set keychain:actas/client-a",
                                  "actas secret --ref sops:work/npm_token"))
    se.add_argument("env", nargs="?", metavar="ENV")
    se.add_argument("key", nargs="?", metavar="KEY")
    se.add_argument("value", nargs="?", help="with --set; omit to be prompted or pipe on stdin")
    se.add_argument("--set", action="store_true", help="store a value instead of printing it")
    se.add_argument("--ref", help="print the value of a ref such as sops:ENV/KEY or gh:LOGIN "
                                  "(store one with: secret set REF)")
    se.set_defaults(fn=cmd_secret)

    sy = sub.add_parser("sync", help="write .claude/settings.local.json into project repos",
                        description="Write each profile's non-secret settings into the "
                                    ".claude/settings.local.json of the repos it matches, for bare claude, "
                                    "IDEs and Desktop. Human-only.",
                        examples=("actas sync --dry-run          show what would change",
                                  "actas sync work", "actas sync --clean"))
    sy.add_argument("env", nargs="?", metavar="profile", help="only this profile (default: every profile)")
    sy.add_argument("--dry-run", action="store_true", help="show what would change; write nothing")
    sy.add_argument("--clean", action="store_true",
                    help="also remove what actas wrote in files no profile syncs any more")
    sy.add_argument("--force", action="store_true",
                    help="with --clean: also remove files that override ~/.claude/settings.json's "
                         "provider routing")
    sy.add_argument("--all", action="store_true",
                    help="with --clean: remove what actas wrote in every synced file and write nothing "
                         "(before uninstalling; works without a manifest)")
    sy.add_argument("--include-confirm", action="store_true", help="also sync confirm profiles")
    sy.add_argument("--shared", action="store_true", help=argparse.SUPPRESS)
    sy.set_defaults(fn=cmd_sync)

    dk = sub.add_parser("desktop", help="what reaches Claude Desktop, the IDE and other GUI apps",
                        description="Show what reaches Claude Desktop, IDE extensions and other GUI apps "
                                    "for a profile, with blocks to paste there. Never writes app settings.",
                        examples=("actas desktop", "actas desktop work --print-3p",
                                  "actas desktop work --vscode"))
    dk.add_argument("env", nargs="?", metavar="profile", help=by_cwd)
    dk.add_argument("--print-3p", action="store_true",
                    help="print the Desktop third-party inference block (gateway, api-key)")
    dk.add_argument("--vscode", action="store_true", help="print claudeCode.environmentVariables")
    dk.set_defaults(fn=cmd_desktop)

    ins = sub.add_parser("instructions", help="print the rules for agents (or the direnv function, or a skill)",
                         description="Print the credential rules for agents, to add to AGENTS.md or "
                                     "CLAUDE.md, the use_actas function for direnv, or a Claude Code skill's SKILL.md.",
                         examples=("actas instructions >> AGENTS.md",
                                   "actas instructions --direnv >> ~/.config/direnv/direnvrc"))
    ins.add_argument("--agent", choices=tuple(INSTRUCTION_HINTS), help="also say where to put them")
    ins.add_argument("--direnv", action="store_true", help="print a use_actas function for direnvrc")
    ins.add_argument("--skill", nargs="?", const="actas", choices=tuple(SKILLS),
                     help="print a Claude Code skill's SKILL.md (default: actas)")
    ins.set_defaults(fn=cmd_instructions)

    su = sub.add_parser("setup", help="install the Claude Code skill or the direnv function",
                        description="Install files a uv/pipx install does not put in place: the Claude "
                                    "Code skill, or the use_actas function for direnv. Human-only.",
                        examples=("actas setup skill", "actas setup skill aws-handoff --dir ./.claude/skills",
                                  "actas setup direnv --dry-run"),
                        usage="actas setup skill [NAME] [--dir DIR] | actas setup direnv [--file FILE]"
                              " [--dry-run] [--force]")
    su.add_argument("what", choices=("skill", "direnv"), help="what to install")
    su.add_argument("name", nargs="?", metavar="NAME", help=f"skill: {' or '.join(SKILLS)} (default actas)")
    su.add_argument("--dir", help="skill: the skills directory (default ~/.claude/skills; "
                                  "aws-handoff: ./.claude/skills)")
    su.add_argument("--file", help="direnv: the file to write (default ~/.config/direnv/lib/actas.sh)")
    su.add_argument("--dry-run", action="store_true", help="show what would change; write nothing")
    su.add_argument("--force", action="store_true", help="replace a file actas did not write")
    su.set_defaults(fn=cmd_setup)

    ah = sub.add_parser("aws-handoff", help="short-lived AWS creds for a cloud session",
                        description="Copy short-lived AWS credentials for a cloud session, which cannot "
                                    "reach your SSO cache. Human-only.",
                        examples=("actas aws-handoff work", "actas aws-handoff work --stdout --duration 900"))
    ah.add_argument("env", nargs="?", metavar="profile", help=by_cwd)
    ah.add_argument("--profile", help="override the profile's AWS profile")
    ah.add_argument("--stdout", action="store_true", help="print instead of copying")
    ah.add_argument("--duration", type=int, default=3600,
                    help="TTL in seconds when trading static keys for a session token")
    ah.add_argument("--login", action="store_true", help="log in first if the SSO session expired")
    ah.set_defaults(fn=cmd_aws_handoff)

    d = sub.add_parser("doctor", help="check the setup and the manifest",
                       description="Check the tools, the manifest, file modes, and the shell exports "
                                   "actas run would clear. Exits 1 on errors.",
                       examples=("actas doctor", "actas doctor --strict --json  for CI"))
    d.add_argument("--strict", action="store_true", help="treat warnings as errors")
    d.add_argument("--json", action="store_true", help="machine-readable output")
    d.add_argument("--fix", action="store_true", help="tighten actas's own directories to mode 0700")
    d.set_defaults(fn=cmd_doctor)

    m = sub.add_parser("migrate", help="print this v1 manifest as version 2",
                       description="Print a v1 manifest as version 2, with notes on what changes. "
                                   "--write replaces it and keeps the old file as environments.v1.yaml.",
                       examples=("actas migrate", "actas migrate --write"))
    m.add_argument("--write", action="store_true",
                   help="replace the manifest (the old one is kept as environments.v1.yaml)")
    m.set_defaults(fn=cmd_migrate)

    h = sub.add_parser("help", help="show help for actas, one command, or a topic (manifest, agents)",
                       description="Show the everyday commands, one command's help, or a short primer.",
                       examples=("actas help run", "actas help manifest", "actas help agents"))
    h.add_argument("topic", nargs="?", metavar="command|manifest|agents")

    def show_help(a):
        if not a.topic:
            print(short_help(sub))
        elif a.topic in HELP_TOPICS:
            print(HELP_TOPICS[a.topic].rstrip("\n"))
            if a.topic == "agents":
                print("\n" + AGENT_RULES.rstrip("\n"))
        elif a.topic in sub.choices and a.topic not in HIDDEN:
            sub.choices[a.topic].print_help()
        else:
            close = close_match(a.topic, [c for c in sub.choices if c not in HIDDEN] + list(HELP_TOPICS))
            die(f"no help for {a.topic!r}" + (f"; did you mean: {close}?" if close else "")
                + " (actas help lists the commands)", 2)
    h.set_defaults(fn=show_help)

    co = sub.add_parser("completion", help="print a shell completion script (bash, zsh, fish)",
                        description="Print a completion script for commands, options and profile names "
                                    "(read with `actas list --names`).",
                        examples=('eval "$(actas completion bash)"   in ~/.bashrc',
                                  'eval "$(actas completion zsh)"    in ~/.zshrc, after compinit',
                                  "actas completion fish > ~/.config/fish/completions/actas.fish"))
    co.add_argument("shell", choices=("bash", "zsh", "fish"))
    co.set_defaults(fn=lambda a: sys.stdout.write(completion_script(sub, a.shell)))

    gc = sub.add_parser("git-credential")
    gc.add_argument("op", nargs="?")
    gc.add_argument("--ref", required=True)
    gc.add_argument("--username")
    gc.set_defaults(fn=cmd_git_credential)

    hk = sub.add_parser("hook")
    hk.add_argument("event", choices=("session-start",))
    hk.add_argument("--profile", required=True)
    hk.add_argument("--source", choices=("run", "sync"), default="run")
    hk.set_defaults(fn=cmd_hook)

    p.epilog = command_reference(sub)
    return p, sub


def alias_note(word, argv0=None, tty=None):
    """Legacy: started as `ccenv` (the deprecated alias), a person at a
    terminal is told the new name once per command; helper strings that old
    synced files still call (`ccenv secret ...`) stay quiet."""
    argv0 = (sys.argv[0] if sys.argv else "") if argv0 is None else argv0
    tty = sys.stderr.isatty() if tty is None else tty
    if os.path.basename(argv0) != "ccenv" or not tty or word in HIDDEN or word == "secret":
        return None
    return "ccenv is now called actas; the ccenv command is a deprecated alias (run actas instead)"


def main(argv=None):
    """Entry point for the script and the package's console scripts (actas,
    and the deprecated ccenv alias)."""
    try:
        _main(argv)
    except KeyboardInterrupt:
        sys.exit(130)
    except BrokenPipeError:
        # The reader went away (`actas list | head`): nothing left to tell it.
        with suppress(OSError):
            os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        sys.exit(1)
    except OSError as e:
        # Last resort for a file actas cannot read or write (a read-only
        # repo, an unwritable cache): one `actas:` line, exit 1, no traceback.
        if env_get("ACTAS_DEBUG") == "1":
            raise
        where = f"{tilde(e.filename)}: " if e.filename else ""
        die(f"{where}{e.strerror or e} (ACTAS_DEBUG=1 shows the traceback)")


def reset_state():
    """Per-invocation state, cleared at the start of every _main() so an
    in-process caller (tests, the packaged entry point) never sees the last
    run's warnings, held lines, decrypted secrets or process table. _LOADED
    stays: it is keyed by the manifest's path, mtime and size."""
    _CACHE.clear()
    _SOPS.clear()
    del WARNINGS[:]
    del HELD[:]
    _MODE.update(json=False, no_color=False, hold=False, argv=[])


def _main(argv=None):
    reset_state()
    p, sub = build_parser()
    argv = sys.argv[1:] if argv is None else list(argv)
    _MODE["argv"] = list(argv)
    passthrough, dashdash = [], "--" in argv
    if dashdash:
        i = argv.index("--")
        argv, passthrough = argv[:i], argv[i + 1:]
    _MODE["no_color"] = "--no-color" in argv        # usage errors too, in any position
    if not argv:
        print(short_help(sub))
        sys.exit(0)
    word = first_word(argv)
    if word is not None and word not in sub.choices:
        names = manifest_names()
        if word in names:         # `actas <profile> -- cmd`: commands win over profile names
            argv, word = profile_word(p, argv, word, passthrough, dashdash), "exec"
        else:
            # D1: did-you-mean computed by actas itself, not parsed out of
            # argparse's message (whose format varies across Python releases).
            close = close_match(word, [c for c in sub.choices if c not in HIDDEN])
            near = None if close else close_match(word, names)
            p.error(f"unknown command {word!r}",
                    f"did you mean: {close}?" if close else
                    f"did you mean: actas exec {near} -- ...? ({near} is a profile)" if near else None)
    if dashdash and word in sub.choices and word not in ("run", "exec"):
        sub.choices[word].error("`--` passes arguments only to run and exec")      # D28
    a, extra = p.parse_known_args(argv)
    if extra:
        sp = sub.choices[a.cmd]
        sp.error(f"unrecognized arguments: {' '.join(extra)}", unknown_hint(sp, extra))
    a.args = passthrough
    _MODE["json"] = bool(getattr(a, "json", False))
    _MODE["no_color"] = bool(a.no_color)
    _MODE["hold"] = True          # released by the gate, a refusal, die() or the end
    if alias_note(word):
        info(alias_note(word))
    try:
        a.fn(a)
    finally:
        release()


if __name__ == "__main__":
    main()
