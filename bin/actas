#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""actas - act as the right identity, per project, for any CLI or agent.

One manifest maps directories to profiles: the model provider, cloud accounts
(AWS, GCP, Azure), GitHub account and git identity, and env vars. actas
applies the matching profile to one process (Claude Code, Codex, Gemini or
any command), so parallel sessions can be different people in different
accounts.

The manifest is plaintext. Secrets are references (sops, gh, ...) that are
resolved when needed and never written to disk in the clear.
"""

import argparse
import copy
import difflib
import fnmatch
import glob
import hashlib
import json
import os
import pwd
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
from contextlib import suppress
from pathlib import Path

__version__ = "2.0.0b1"
BUILD = "script"  # the package build rewrites this to "package" (SPEC 5.4)

HOME = Path.home()


# Legacy compatibility: actas was called ccenv before 2.0. An install that
# never moved anything keeps working: the old variables are read when the new
# ones are unset, and the old directories are used while the new ones do not
# exist. actas writes only the new names.
LEGACY_PREFIX = "CCENV"      # ACTAS_X -> CCENV_X, ACTAS -> CCENV


def legacy_name(name):
    """The pre-rename spelling of an ACTAS* variable (legacy, ccenv)."""
    return LEGACY_PREFIX + name[len("ACTAS"):] if name.startswith("ACTAS") else name


def env_get(name, env=None):
    """$ACTAS_X, else the pre-rename $CCENV_X when ACTAS_X is not set at all
    (old shells and synced settings files; legacy)."""
    env = os.environ if env is None else env
    return env[name] if name in env else env.get(legacy_name(name))


def env_any(name, env=None):
    """Whether either spelling of a marker is set non-empty (legacy-aware)."""
    env = os.environ if env is None else env
    return bool(env.get(name) or env.get(legacy_name(name)))


def legacy_dir(base, name="actas", old="ccenv"):
    """base/actas, or the pre-rename base/ccenv while only that one exists
    (legacy; `actas doctor` suggests the mv)."""
    new, prev = Path(base) / name, Path(base) / old
    return prev if not new.exists() and prev.is_dir() else new


XDG_STATE = Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local" / "state")
# The default locations, without ACTAS_ROOT / ACTAS_STATE (the gate compares, F27).
DEFAULT_ROOT = legacy_dir(HOME / ".config")
DEFAULT_STATE = legacy_dir(XDG_STATE)
ROOT = Path(env_get("ACTAS_ROOT") or DEFAULT_ROOT)
MANIFEST = ROOT / "environments.yaml"
SECRETS = ROOT / "secrets.enc.yaml"
CACHE = Path(os.environ.get("XDG_CACHE_HOME") or HOME / ".cache") / "actas"
STATE = Path(env_get("ACTAS_STATE") or DEFAULT_STATE)

# Backend binaries are looked up in PATH, then ACTAS_PATH_EXTRA, then these
# directories, so helpers still work under the empty PATH of a GUI app (D8).
# ACTAS_FALLBACK_PATH replaces the list ("" disables it; tests use that).
FALLBACK_PATH = ("/opt/homebrew/bin:/usr/local/bin:/home/linuxbrew/.linuxbrew/bin:"
                 "~/.local/bin:~/.nix-profile/bin:/run/current-system/sw/bin")

# =============================================================== data tables

# Profile, role and secret names reach sops path expressions and file names:
# keep them to a safe character set so a name can never alter either.
NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]*$")
ENV_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")

LEVEL_NAMES = ("readonly", "standard", "power")
LEVELS = {n: i + 1 for i, n in enumerate(LEVEL_NAMES)}
TOOL_NAMES = ("claude", "codex", "gemini")
PROVIDERS = ("subscription", "gateway", "api-key", "bedrock", "vertex")

# Secret references (SPEC 9.1): scheme -> grammar. Readers live in read_ref();
# writers in secret_set_ref().
_PART = r"[A-Za-z0-9 ._@+][A-Za-z0-9 ._@+-]{0,127}"
_HOST = r"[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?(?:\.[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?)*"
REF_RES = {
    "sops": re.compile(r"^sops:([A-Za-z0-9][A-Za-z0-9_.-]*)/([A-Za-z0-9][A-Za-z0-9_.-]*)$"),
    "keychain": re.compile(r"^keychain:(%s)/(%s)$" % (_PART, _PART)),
    "op": re.compile(r"^op://[A-Za-z0-9 _./?=-]+$"),
    "gh": re.compile(r"^gh:([A-Za-z0-9][A-Za-z0-9_-]{0,38})(?:@(%s))?$" % _HOST),
    "cmd": re.compile(r"^cmd:\[.*\]$", re.S),
}

# Manifest schema (SPEC 2.3, 4, 6). Type codes: "str", "bool", "list" (list of
# strings, never a bare string), "strlist" (string or list), "names", "vars"
# (env var names), "env" (VAR -> literal), "refs" (VAR -> ref), "ref",
# "strmap", "map" (free-form); ("enum", values); ("module", keys) = a map,
# "inherit" or null; ("mapof", keys); a dict is a nested map.
STR, BOOL, REF, HOME_T = "str", "bool", "ref", "home"
MODULE_KEYS = {
    "aws": {"profile": STR, "region": STR, "config_file": STR, "sso_session": STR},
    "gcp": {"configuration": STR, "project": STR, "region": STR, "impersonate": STR,
            "home": HOME_T, "adc_file": STR},
    "azure": {"home": HOME_T, "subscription": STR, "tenant": STR, "location": STR},
    "github": {"auth": REF, "home": HOME_T, "host": STR},
    "git": {"name": STR, "email": STR, "ssh_key": STR,
            "signing": {"format": STR, "key": STR, "program": STR}, "sign": BOOL,
            "credentials": ("mapof", {"username": STR, "token": REF}), "config": "strmap"},
}
TOOL_KEYS = {
    "claude": {"provider": ("enum", PROVIDERS), "home": HOME_T, "base_url": STR, "token": REF,
               "export_token": BOOL, "auth_header": ("enum", ("bearer", "x-api-key")),
               "models": {"opus": STR, "sonnet": STR, "haiku": STR, "default": STR,
                          "subagent": STR},
               "oauth_token": REF, "project": STR, "region": STR, "bearer_token": REF,
               "args": "list", "settings": "map"},
    "codex": {"home": HOME_T, "login": ("enum", ("chatgpt", "api")), "api_key": REF,
              "args": "list"},
    "gemini": {"home": HOME_T, "auth": ("enum", ("api-key", "vertex")), "api_key": REF,
               "project": STR, "location": STR, "args": "list"},
}
BODY_KEYS = {
    "description": STR, "match": "strlist", "use": "strlist", "agents_may_use": "names",
    "level": ("enum", LEVEL_NAMES), "confirm": BOOL, "tool": ("enum", TOOL_NAMES),
    "permissions": {"deny": "list", "ask": "list", "builtin": BOOL},
    "inherit": "vars", "unset": "vars", "env": "env", "secret_env": "refs",
}
BODY_KEYS.update({k: ("module", v) for k, v in MODULE_KEYS.items()})
BODY_KEYS.update(TOOL_KEYS)
TOP_KEYS = ("version", "defaults", "profiles", "roles", "fallback")

# Composition (SPEC 3.1)
LOCAL_ONLY = {"match", "use", "description", "agents_may_use"}
# agents_may_use is local to a profile, but `defaults:` may give the list every
# profile without its own (a profile's own list, even [], replaces it).
DEFAULTS_FORBIDDEN = (LOCAL_ONLY - {"agents_may_use"}) | {"level", "confirm"}
ANY = "*"          # agents_may_use: every profile (still same level or lower, no confirm)
# claude.settings.permissions.deny/ask are rules like permissions.deny/ask, so
# they combine the same way; claude.settings.permissions.allow is a plain list
# (a later layer replaces it), so composing never grants more than a layer says.
CS_PERMS = ("claude", "settings", "permissions")
STICKY = {("permissions", "ask"), ("permissions", "deny"), ("unset",),
          CS_PERMS + ("ask",), CS_PERMS + ("deny",)}
UNION = STICKY | {("inherit",)}
MAX_DEPTH = 8

