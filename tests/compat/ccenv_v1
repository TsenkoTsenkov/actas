def cmd_init(a):
    """Create the config directory with a starter manifest and, when an age
    key exists, a .sops.yaml that encrypts secrets to it. Never overwrites."""
    ROOT.mkdir(parents=True, exist_ok=True, mode=0o700)
    if MANIFEST.exists():
        info(f"exists, left alone: {MANIFEST}")
    else:
        MANIFEST.write_text(INIT_MANIFEST)
        print(f"{GRN}wrote{RST} {MANIFEST}")
    sops_cfg = ROOT / ".sops.yaml"
    key = age_key_file()
    pub = None
    if key and Path(key).exists():
        for line in Path(key).read_text().splitlines():
            if line.startswith("# public key:"):
                pub = line.split(":", 1)[1].strip()
                break
    if sops_cfg.exists():
        info(f"exists, left alone: {sops_cfg}")
    elif pub:
        sops_cfg.write_text(
            "# Who can decrypt secrets.enc.yaml. Add a key, then run:\n"
            "#   sops updatekeys secrets.enc.yaml\n"
            "creation_rules:\n"
            "  - path_regex: secrets\\.enc\\.yaml$\n"
            f"    age: {pub}   # comma-separate to add more\n")
        print(f"{GRN}wrote{RST} {sops_cfg}  (age key {pub[:16]}...)")
    else:
        warn("no age key found - secrets are disabled until you create one:\n"
             "       age-keygen -o ~/.config/sops/age/keys.txt && ccenv init")
    print(f"next: edit {MANIFEST}, then run `ccenv doctor` and `ccenv list`")


def cmd_doctor(a):
    print(f"{BOLD}manifest{RST}  {MANIFEST}  {'ok' if MANIFEST.exists() else RED + 'missing' + RST}")
    print(f"{BOLD}secrets{RST}   {SECRETS}  {'ok' if SECRETS.exists() else RED + 'missing' + RST}")
    for tool in ("claude", "aws", "gh", "sops", "age"):
        p = shutil.which(tool)
        print(f"{BOLD}{tool:<9}{RST} {p or RED + 'MISSING' + RST}")
    key = age_key_file()
    print(f"{BOLD}age key{RST}   {key or RED + 'missing' + RST}")
    accts = gh_accounts()
    print(f"{BOLD}gh accts{RST}  {', '.join(accts) if accts else RED + 'none' + RST}")
    portals = aws_portals()
    print(f"{BOLD}aws{RST}       {len(portals)} SSO portals, "
          f"{sum(len(v) for v in portals.values())} profiles")
    leaked = [v for v in ("ANTHROPIC_BASE_URL", "ANTHROPIC_AUTH_TOKEN", "ANTHROPIC_API_KEY", "AWS_PROFILE")
              if os.environ.get(v)]
    if leaked:
        print(f"{YEL}shell exports that ccenv will override:{RST} {', '.join(leaked)}")
    try:
        g = json.loads((Path.home() / ".claude" / "settings.json").read_text())
        gl = [k for k in ("apiKeyHelper",) if g.get(k)]
        if (g.get("env") or {}).get("ANTHROPIC_BASE_URL"):
            gl.append("env.ANTHROPIC_BASE_URL")
        if gl:
            print(f"{YEL}~/.claude/settings.json sets {', '.join(gl)}:{RST} applies to every project "
                  f"not covered by `ccenv sync`; subscription envs override it when synced")
    except (OSError, ValueError):
        pass


class Parser(argparse.ArgumentParser):
    """On any usage error, show the full help menu instead of a one-line
    usage string, plus a hint for the most common mistakes."""

    def error(self, message):
        self.print_help(sys.stderr)
        hint = ""
        if "unrecognized arguments" in message:
            hint = "\n       to pass arguments to claude, put them after --  (ccenv run <env> -- --resume)"
        elif "invalid choice" in message:
            import difflib, re
            m = re.search(r"invalid choice: '([^']*)'", message)
            choices = re.findall(r"'([^']*)'", message.split("choose from", 1)[-1])
            close = difflib.get_close_matches(m.group(1), choices, n=1) if m else []
            if close:
                hint = f"\n       did you mean: {close[0]}?"
        print(f"\n{RED}ccenv: error:{RST} {message}{hint}", file=sys.stderr)
        sys.exit(2)


def command_reference(sub):
    lines = ["commands:"]
    for name, sp in sub.choices.items():
        usage = " ".join(sp.format_usage().split()[1:])  # drop "usage:"
        usage = usage.replace(" [--cwd CWD]", "")
        lines.append(f"  {usage}")
        for act in sp._actions:
            if act.option_strings and act.dest not in ("help", "cwd"):
                lines.append(f"      {', '.join(act.option_strings):<16} {act.help or ''}")
    lines += [
        "",
        "examples:",
        "  ccenv run                     launch claude in the env matching the cwd",
        "  ccenv run work -- --resume    pass arguments to claude after --",
        "  ccenv run --login             also refresh AWS SSO before starting",
        "  ccenv login work              refresh AWS SSO for one environment",
        "  ccenv --cwd ~/code/x shell    print the env vars for another directory",
        "  ccenv list --check            show environments and auth status",
        "  ccenv help <command>          detailed help for one command",
    ]
    return "\n".join(lines)


def main():
    p = Parser(prog="ccenv", description=__doc__,
               formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--cwd", help="resolve the environment as if from this directory")
    p.add_argument("--version", action="version", version=f"ccenv {__version__}")
    sub = p.add_subparsers(dest="cmd", required=True, metavar="<command>")

    # --cwd is accepted after the command too (`ccenv run --cwd DIR`).
    # SUPPRESS keeps the subcommand default from clobbering a value given
    # before the command.
    cwd_opt = argparse.ArgumentParser(add_help=False)
    cwd_opt.add_argument("--cwd", default=argparse.SUPPRESS,
                         help="resolve the environment as if from this directory")
    _add = sub.add_parser
    sub.add_parser = lambda *x, **k: _add(*x, parents=[cwd_opt], **k)

    i = sub.add_parser("init", help="create the config directory and a starter manifest")
    i.set_defaults(fn=cmd_init)

    r = sub.add_parser("run", help="launch Claude Code in an environment")
    r.add_argument("env", nargs="?", help="environment name (default: match cwd)")
    r.add_argument("--login", action="store_true",
                   help="refresh this environment's AWS SSO first if expired (default: only warn)")
    r.add_argument("--no-check", "--no-login", dest="no_check", action="store_true",
                   help="skip the expired-credentials check")
    r.set_defaults(fn=cmd_run)

    s = sub.add_parser("shell", help="print export lines for eval")
    s.add_argument("env", nargs="?")
    s.set_defaults(fn=cmd_shell)

    l = sub.add_parser("list", help="list environments")
    l.add_argument("--check", action="store_true", help="also probe AWS and secret availability")
    l.set_defaults(fn=cmd_list)

    lo = sub.add_parser("login", help="refresh AWS SSO")
    lo.add_argument("env", nargs="?")
    lo.add_argument("--all", action="store_true",
                    help="one login per SSO portal used by any environment")
    lo.set_defaults(fn=cmd_login)

    se = sub.add_parser("secret", help="read or write a secret")
    se.add_argument("env")
    se.add_argument("key")
    se.add_argument("value", nargs="?", help="with --set; omit to be prompted or pipe on stdin")
    se.add_argument("--set", action="store_true",
                    help="store a value instead of printing it")
    se.set_defaults(fn=cmd_secret)

    sy = sub.add_parser("sync", help="write .claude settings into project directories")
    sy.add_argument("env", nargs="?")
    sy.add_argument("--shared", action="store_true",
                    help="write settings.json (committed) instead of settings.local.json")
    sy.set_defaults(fn=cmd_sync)

    ah = sub.add_parser("aws-handoff", help="short-lived AWS creds for a cloud session")
    ah.add_argument("env", nargs="?")
    ah.add_argument("--profile", help="override the environment's profile")
    ah.add_argument("--stdout", action="store_true", help="print instead of copying")
    ah.add_argument("--duration", type=int, default=3600,
                    help="TTL in seconds when trading static keys for a session token")
    ah.set_defaults(fn=cmd_aws_handoff)

    d = sub.add_parser("doctor", help="check the setup")
    d.set_defaults(fn=cmd_doctor)

    h = sub.add_parser("help", help="show help for ccenv or one command")
    h.add_argument("topic", nargs="?", metavar="command")
    h.set_defaults(fn=lambda a: (sub.choices[a.topic] if a.topic in sub.choices else p).print_help()
                   if not a.topic or a.topic in sub.choices
                   else p.error(f"unknown command {a.topic!r}"))

    p.epilog = command_reference(sub)

    argv = sys.argv[1:]
    passthrough = []
    if "--" in argv:
        i = argv.index("--")
        argv, passthrough = argv[:i], argv[i + 1:]

    if not argv:
        p.print_help()
        sys.exit(0)
    a = p.parse_args(argv)
    a.args = passthrough
    a.fn(a)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
